Private Sub UpdateChamferCheckboxState()
    Dim currentShape As String
    currentShape = GetShapeFromOptionButtons()
    
    If TypeName(Me.Controls("CheckBoxChamferなし")) = "CheckBox" Then
        ' イベントの再帰呼び出しを防ぐためにフラグを立てる
        m_bIsProgrammaticChange = True
        
        If currentShape = "ブロック" Then
            ' 形状が「ブロック」の場合
            Me.CheckBoxChamferなし.Enabled = False ' チェックボックスを無効化
            Me.CheckBoxChamferなし.Value = False   ' チェックも外す
        Else
            ' 形状が「ブロック」以外の場合
            Me.CheckBoxChamferなし.Enabled = True  ' チェックボックスを有効化
        End If
        
        ' フラグを元に戻す
        m_bIsProgrammaticChange = False
    End If
End Sub

