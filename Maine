Option Explicit

Private Const strBUHStrGRange As String = "B2:K61" 'BUHの入力用シートのデータ参照範囲を指定する

'MST_str(ix)のixは、
' 1 サイズ
' 2 品番
' 3 品名
' 4 材質
' 5 部品寸法・部品コード・片図
' 6 所要数
' 7 基
' 8 購入先/処理先
' 9 焼
' 10 備考

Sub test()

    Dim MST_str As Variant      'BUHファイルの入力用シート内容を一時保存する二次元配列
    Dim LST_str() As Variant    'MST_strの内容を整形し、一次保存する二次元配列
    Dim WS_str As String, FILE_N As String, ZMN_Ob As Object
    Dim i As Long, j As Long, l As Long
    Dim tDest As Range

    'BUHファイル指定ダイアログを表示
    FILE_N = Application.GetOpenFilename("図面,*")

    'ファイル指定されなかった場合は終了する
    If FILE_N = "False" Then End

    'BUHファイルを開く
    Set ZMN_Ob = Workbooks.Open(FILE_N)

    j = -1

    For i = 1 To 3
        WS_str = "入力用(" & i & ")"

        'BUHファイルの入力用シートに入力されたデータを配列にコピーする
        MST_str = ZMN_Ob.Sheets(WS_str).Range(strBUHStrGRange)

        For l = 1 To UBound(MST_str, 1)

            If Not MST_str(l, 3) = "" Then  '品番未入力なら空行とみなして飛ばす
                j = j + 1
                ReDim Preserve LST_str(10, j)

                ' ▼▼▼ここから修正▼▼▼
                Dim valB As String
                Dim valC As String
                valB = Trim(CStr(MST_str(l, 1))) 'B列の値
                valC = Trim(CStr(MST_str(l, 2))) 'C列の値

                ' B列の値が「A」で始まり、2文字目以降が数値かチェック
                If UCase(Left(valB, 1)) = "A" And Len(valB) > 1 And IsNumeric(Mid(valB, 2)) Then
                    ' 条件が真の場合(A○形式)は、C列の値を転記
                    LST_str(0, j) = StrConv(valC, vbNarrow)
                Else
                    ' 条件が偽の場合は、従来通りB列の値を転記
                    LST_str(0, j) = StrConv(valB, vbNarrow)
                End If
                ' ▲▲▲ここまで修正▲▲▲
                
                LST_str(1, j) = StrConv(Trim(MST_str(l, 10)), vbNarrow)
                LST_str(2, j) = StrConv(Trim(MST_str(l, 8)), vbNarrow)
                LST_str(3, j) = StrConv(Trim(MST_str(l, 7)), vbNarrow)
                LST_str(4, j) = weight(CStr(MST_str(l, 4)), CStr(MST_str(l, 5)))
                LST_str(5, j) = StrConv(Trim(MST_str(l, 4)), vbNarrow)
                LST_str(6, j) = SortDimensions(MST_str(l, 5))
                LST_str(7, j) = StrConv(Trim(MST_str(l, 9)), vbNarrow)
                LST_str(8, j) = StrConv(Trim(MST_str(l, 6)), vbNarrow)
                LST_str(9, j) = StrConv(Trim(MST_str(l, 2)), vbNarrow)
                LST_str(10, j) = StrConv(Trim(MST_str(l, 3)), vbNarrow)
            End If
        Next l
    Next i

    With Workbooks(ThisWorkbook.name).Sheets("工程表")
        .Activate
        .Range(.Cells(3, 24), .Cells(500, 34)).Clear
        
        '配列移植
        If j > -1 Then
            '出力先セル範囲を設定
            Set tDest = .Range(.Cells(3, 24), .Cells(UBound(LST_str, 2) + 3, 34))
            'データを入力する
            tDest.Value = WorksheetFunction.Transpose(LST_str)
            '罫線をつける
            tDest.Borders(xlEdgeTop).Color = -16776961
            tDest.Borders(xlInsideHorizontal).Color = -16776961
        End If
        
        .Cells(3, 1).Value = ZMN_Ob.Sheets("オーダー確認").Cells(6, 3).Value 'オーダ番号移植
        .Cells(3, 2).Value = StrConv(ZMN_Ob.Sheets("表題欄").Cells(1, 2), vbNarrow) '機種
        .Cells(3, 3).Value = StrConv(ZMN_Ob.Sheets("表題欄").Cells(2, 4), vbNarrow) '品名

    End With

    MsgBox "オワタ", vbInformation

End Sub

Private Function SortDimensions(dimensions As Variant) As String
    Dim DimArray As Variant
    SortDimensions = dimensions '初期値を設定

    DimArray = Split(dimensions, "*")
    If UBound(DimArray) <> 2 Then Exit Function
    If Not IsNumeric(DimArray(0)) Then Exit Function

    '3つの値をソートする
    SortSubFunc DimArray(0), DimArray(1)
    SortSubFunc DimArray(0), DimArray(2)
    SortSubFunc DimArray(1), DimArray(2)

    SortDimensions = DimArray(0) & "*" & DimArray(1) & "*" & DimArray(2)
End Function

Private Sub SortSubFunc(ByRef num1 As Variant, ByRef num2 As Variant)
    Dim temp As Variant
    If CDbl(num1) > CDbl(num2) Then
        temp = num1
        num1 = num2
        num2 = temp
    End If
End Sub

'****************************************************************
' 重量表示関数
' 材質と外形寸法を元に、重量を計算する
' 【引数】material   材質 文字列形式
'         dimensions 外形寸法(mm)「○*○*○」の文字列形式
' 【戻り値】重量(文字列形式,kg単位,小数点以下第1位を切り上げる)
'****************************************************************
Function weight(material As String, dimensions As String) As String
    Dim SpecificGravity As Double
    Dim Formula As String
    Dim Volume As Double
    Dim DimArray As Variant
    
    Formula = dimensions
    
    '材料寸法の先頭に"t"(板厚を示す記号)がある場合は削除し、計算を継続する
    If Formula Like "t*" Or Formula Like "T*" Then
        Formula = Mid(Formula, 2)
    End If
    
    '体積の計算を行う
    Select Case True
        Case Formula Like "*#*#*" ' 角材や板の場合 (例: 10*20*30)
            DimArray = Split(Formula, "*")
            If UBound(DimArray) = 2 Then
                Volume = CDbl(DimArray(0)) * CDbl(DimArray(1)) * CDbl(DimArray(2))
            Else
                weight = "" '形式が不正
                Exit Function
            End If
            
        Case Formula Like "φ*#*#*" ' 丸棒の場合 (例: φ10*100)
            Formula = Mid(Formula, 2)
            DimArray = Split(Formula, "*")
            If UBound(DimArray) = 1 Then
                '体積 = π * (直径/2)^2 * 長さ
                Volume = 3.14159 * (CDbl(DimArray(0)) / 2) ^ 2 * CDbl(DimArray(1))
            Else
                weight = "" '形式が不正
                Exit Function
            End If
            
        '体積計算式として解釈できない場合は終了
        Case Else
            weight = ""
            Exit Function
    End Select
    
    '材質に合わせて比重を設定する
    Select Case True
        Case material Like "A*" 'アルミ
            SpecificGravity = 2.81
        Case material Like "C*" '銅
            SpecificGravity = 8.81
        Case material Like "超硬*" '超硬
            SpecificGravity = 14.5
        Case material Like "" '材質が設定されていない場合は警告表示
            weight = "【●●材質未指定●●】"
            Exit Function
        Case Else '上記以外は全て鉄とみなす
            SpecificGravity = 7.85
    End Select

    '重量をkg単位で得る (体積:mm3 * 比重:g/cm3 -> 体積/1000 * 比重 / 1000 = kg)
    Dim calculatedWeight As Double
    calculatedWeight = (Volume / 1000) * SpecificGravity / 1000
    
    '小数点以下を切り上げ
    calculatedWeight = Application.WorksheetFunction.RoundUp(calculatedWeight, 1)
    
    weight = "【 " & calculatedWeight & " 】"
    
End Function
