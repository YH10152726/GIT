 Sub SearchAndOutput()
    Dim ws As Worksheet
    Dim searchFile As Workbook
    Dim searchSheet As Worksheet
    Dim searchNumber As String
    Dim foundCell As Range
    Dim outputRow As Long
    Dim searchPath As String
    Dim lastRow As Long
    Dim machineFound As Boolean
    
    ' 依頼番号を入力
    searchNumber = InputBox("依頼番号を入力してください", "依頼番号入力")
    
    ' 入力がキャンセルされた場合は終了
    If searchNumber = "" Then
        Exit Sub
    End If
    
    ' 検索するファイルのパス
    searchPath = "\\yamasrv100\seisui\kagi\kakougijutsu\【社外】\型企2\部品見積フォルダー\統合_部品製作見積リスト.xlsm"
    
    ' 検索ファイルを開く
    On Error Resume Next
    Set searchFile = Workbooks.Open(searchPath)
    On Error GoTo 0
    
    ' ファイルが開けなかった場合はメッセージを表示
    If searchFile Is Nothing Then
        MsgBox "指定されたファイルを開けませんでした。", vbExclamation
        Exit Sub
    End If
    
    ' 検索シートを設定（最初のページ）
    Set searchSheet = searchFile.Sheets(1)
    
    ' ★★★ 追加部分 ここから ★★★
    ' シートにフィルターがかかっている場合、すべて表示する
    If searchSheet.AutoFilterMode Then
        searchSheet.AutoFilter.ShowAllData
    End If
    ' ★★★ 追加部分 ここまで ★★★
    
    ' 出力先のシートを設定（アクティブシートを使用）
    Set ws = ThisWorkbook.ActiveSheet
    
    ' 出力行を3行目に設定
    outputRow = 3
    
    ' J列の最終行を取得
    lastRow = searchSheet.Cells(searchSheet.Rows.Count, "J").End(xlUp).Row
    
    ' 機種と品名が見つかったかどうかのフラグ
    machineFound = False
    
    ' J列で依頼番号を検索
    For Each foundCell In searchSheet.Range("J1:J" & lastRow)
        If foundCell.Value = searchNumber Then
            ' ヒットした場合、指定された列に出力
            ws.Cells(outputRow, "X").Value = foundCell.Offset(0, 1).Value ' K列の葉番
            ws.Cells(outputRow, "AG").Value = foundCell.Offset(0, 2).Value ' L列の品番
            ws.Cells(outputRow, "AC").Value = foundCell.Offset(0, 4).Value ' N列の材質
            ws.Cells(outputRow, "AE").Value = foundCell.Offset(0, 5).Value ' O列の硬度
            ws.Cells(outputRow, "AZ").Value = foundCell.Offset(0, 6).Value ' P列の処理
            ws.Cells(outputRow, "Z").Value = foundCell.Offset(0, 7).Value ' Q列のコーティング
            ws.Cells(outputRow, "AF").Value = foundCell.Offset(0, 8).Value ' R列の個数
            
            ' 機種と品名をB3とC3に出力（最初のヒットのみ）
            If Not machineFound Then
                ws.Cells(3, "B").Value = foundCell.Offset(0, -4).Value ' F列の値
                ws.Cells(3, "C").Value = foundCell.Offset(0, -3).Value ' G列の値
                machineFound = True
            End If
            
            ' 出力行を次に進める
            outputRow = outputRow + 1
        End If
    Next foundCell
    
    ' 検索ファイルを閉じる
    searchFile.Close SaveChanges:=False
    
    ' 結果が見つからなかった場合のメッセージ
    If outputRow = 3 Then
        MsgBox "依頼番号 " & searchNumber & " は見つかりませんでした。", vbInformation
    Else
        MsgBox "依頼番号 " & searchNumber & " のデータを出力しました。", vbInformation
    End If
 End Sub
