Private Sub AutoCalibrate_Criteria()
    Dim wsCtrl As Worksheet: Set wsCtrl = ThisWorkbook.Worksheets("Control")
    Dim useAC As Boolean: useAC = (UCase$(CStr(wsCtrl.Range("B4").value)) Like "*YES*" Or UCase$(CStr(wsCtrl.Range("B4").value)) Like "*はい*")
    Dim useBL As Boolean: useBL = (UCase$(CStr(wsCtrl.Range("B5").value)) Like "*YES*" Or UCase$(CStr(wsCtrl.Range("B5").value)) Like "*はい*")
    If Not useAC And Not useBL Then Exit Sub

    Dim fam As String, runner As String, qclass As String, mach As String
    Dim cycle As Double, hold As Double
    fam = CStr(wsCtrl.Range("B9").value)
    runner = CStr(wsCtrl.Range("B10").value)
    qclass = CStr(wsCtrl.Range("B11").value)
    mach = CStr(wsCtrl.Range("B7").value)
    hold = NzD(wsCtrl.Range("B2").value, 0#)
    cycle = NzD(wsCtrl.Range("B3").value, 0#)

    Dim wsCrit As Worksheet: Set wsCrit = ThisWorkbook.Worksheets("Criteria")
    Clear_Criteria wsCrit

    If useBL Then Apply_Baseline_To_Criteria fam, runner, qclass, wsCrit
    If useAC Then Apply_Machine_Material_Rules mach, fam, hold, cycle, wsCrit
End Sub


