'【学習】良品データから評価基準のベースラインを学習
Public Sub Learn_Baseline_FromFolder()
    Dim wsCtrl As Worksheet: Set wsCtrl = ThisWorkbook.Worksheets("Control")
    Dim fam As String, runner As String, qclass As String
    fam = CStr(wsCtrl.Range("B9").value)
    runner = CStr(wsCtrl.Range("B10").value)
    qclass = CStr(wsCtrl.Range("B11").value)

    Dim folder As String: folder = PickFolder("承認済み（良品）スタディのXML親フォルダを選択")
    If folder = "" Then Exit Sub

    Dim wsMap As Worksheet: Set wsMap = ThisWorkbook.Worksheets("Result_Map")
    Dim wsBase As Worksheet: Set wsBase = ThisWorkbook.Worksheets("Baseline")
    Dim files As Collection: Set files = ListAllXML(folder)
    If files Is Nothing Or files.Count = 0 Then MsgBox "XMLなし": Exit Sub

    Dim key As String: key = fam & "|" & runner & "|" & qclass

    Dim pools As Object: Set pools = CreateObject("Scripting.Dictionary")
    Dim dirs As Object: Set dirs = CreateObject("Scripting.Dictionary")

    Dim lastMap As Long: lastMap = wsMap.Cells(wsMap.rows.Count, 1).End(xlUp).Row
    Dim r As Long
    For r = 2 To lastMap
        If ToBool(wsMap.Cells(r, 1).value) Then
            Dim kpi As String, patt As String, sig As String, dir As String
            kpi = CStr(wsMap.Cells(r, 2).value)
            patt = CStr(wsMap.Cells(r, 5).value)
            sig = CStr(wsMap.Cells(r, 8).value)
            dir = CStr(wsMap.Cells(r, 9).value)
            dirs(kpi) = IIf(InStr(dir, "big") > 0, "big_better", "small_better")

            Dim vals As Object: Set vals = CreateObject("System.Collections.ArrayList")
            Dim i As Long
            For i = 1 To files.Count
                Dim f As String: f = files(i)
                If InStr(LCase$(f), Replace(LCase$(Replace(patt, "*", "")), ";", "")) > 0 Then
                    Dim v As Variant: v = ExtractNumericFromXML(f)
                    If Not IsError(v) Then vals.Add v
                End If
            Next i
            pools(kpi) = vals
        End If
    Next r

    Dim rowOut As Long: rowOut = wsBase.Cells(wsBase.rows.Count, 1).End(xlUp).Row + 1
    Dim k As Variant
    For Each k In pools.Keys
        Dim arr As Object: Set arr = pools(k)
        If arr.Count >= 5 Then
            arr.Sort
            Dim p50 As Double, p80 As Double, p90 As Double
            p50 = Percentile(arr, 0.5)
            p80 = Percentile(arr, 0.8)
            p90 = Percentile(arr, 0.9)
            wsBase.Cells(rowOut, 1).value = key
            wsBase.Cells(rowOut, 2).value = CStr(k)
            wsBase.Cells(rowOut, 3).value = p50
            wsBase.Cells(rowOut, 4).value = p80
            wsBase.Cells(rowOut, 5).value = p90
            wsBase.Cells(rowOut, 6).value = CStr(dirs(k))
            wsBase.Cells(rowOut, 7).value = arr.Count
            rowOut = rowOut + 1
        End If
    Next k

    MsgBox "Baselineを学習しました。", vbInformation
End Sub


'====================================================================================
' ■■■ コア機能 STEP 1：XML一括取り込み ■■■
'====================================================================================
Private Sub ImportMoldflowXMLs_FromFolder_v3()
    Dim folder As String
    folder = PickFolder("XMLの親フォルダを選択してください（studyrlt -xml の出力先）")
    If folder = "" Then Exit Sub

    Dim wsMap As Worksheet: Set wsMap = ThisWorkbook.Worksheets("Result_Map")
    Dim wsLog As Worksheet: Set wsLog = ThisWorkbook.Worksheets("Import_Log")
    Dim logRow As Long: logRow = wsLog.Cells(wsLog.rows.Count, 1).End(xlUp).Row + 1

    Dim files As Collection: Set files = ListAllXML(folder)
    If files Is Nothing Or files.Count = 0 Then
        MsgBox "XMLが見つかりません。", vbExclamation: Exit Sub
    End If

    Dim idx As Object: Set idx = CreateObject("Scripting.Dictionary")
    BuildContentIndex files, idx

    Dim lastRow As Long: lastRow = wsMap.Cells(wsMap.rows.Count, 1).End(xlUp).Row
    Dim r As Long
    For r = 2 To lastRow
        If ToBool(wsMap.Cells(r, 1).value) And UCase$(Trim$(CStr(wsMap.Cells(r, 4).value))) = "XML" Then
            Dim kpi As String, tgt As String, patt As String, agg As String, sig As String
            kpi = CStr(wsMap.Cells(r, 2).value)
            tgt = CStr(wsMap.Cells(r, 3).value)
            patt = CStr(wsMap.Cells(r, 5).value)
            agg = UCase$(Trim$(CStr(wsMap.Cells(r, 6).value)))
            sig = CStr(wsMap.Cells(r, 8).value)

            Dim best As String, score As Double
            best = "": score = -1
            Dim i As Long
            For i = 1 To files.Count
                Dim f As String: f = files(i)
                Dim s As Double: s = ScoreFile(f, patt, sig, idx(f))
                If s > score Then score = s: best = f
            Next i

            If score > 0 And best <> "" Then
                Dim val As Variant: val = AggregateXml(best, agg)
                If Not IsError(val) Then
                    WriteValueByLabel tgt, kpi, val
                    wsLog.Cells(logRow, 1).value = Now
                    wsLog.Cells(logRow, 2).value = kpi
                    wsLog.Cells(logRow, 3).value = best
                    wsLog.Cells(logRow, 4).value = score
                    wsLog.Cells(logRow, 5).value = agg
                    wsLog.Cells(logRow, 6).value = val
                    wsLog.Cells(logRow, 7).value = "OK"
                    logRow = logRow + 1
                Else
                    wsLog.Cells(logRow, 1).value = Now
                    wsLog.Cells(logRow, 2).value = kpi
                    wsLog.Cells(logRow, 3).value = best
                    wsLog.Cells(logRow, 4).value = score
                    wsLog.Cells(logRow, 5).value = agg
                    wsLog.Cells(logRow, 6).value = ""
                    wsLog.Cells(logRow, 7).value = "集計不可"
                    logRow = logRow + 1
                End If
            Else
                wsLog.Cells(logRow, 1).value = Now
                wsLog.Cells(logRow, 2).value = kpi
                wsLog.Cells(logRow, 3).value = ""
                wsLog.Cells(logRow, 4).value = 0
                wsLog.Cells(logRow, 5).value = ""
                wsLog.Cells(logRow, 6).value = ""
                wsLog.Cells(logRow, 7).value = "該当XMLなし"
                logRow = logRow + 1
            End If
        End If
    Next r
End Sub


