import NXOpen
import NXOpen.Features
import math

def main():
    the_session = NXOpen.Session.GetSession()
    work_part = the_session.Parts.Work
    
    # --- 構成設定 ---
    COLOR_VERTICAL = 186  # 赤：縦持ち
    COLOR_HORIZONTAL = 6  # 黄：横当て
    OFFSET_DIST = 10.0    # 延長（逃げ）距離
    # ----------------

    all_faces = work_part.Bodies[0].GetFaces()
    v_faces = [f for f in all_faces if f.Color == COLOR_VERTICAL]
    h_faces = [f for f in all_faces if f.Color == COLOR_HORIZONTAL]

    def create_solid_electrode(faces, mode):
        if not faces: return

        # 1. 重心とバウンディングボックスの計算
        min_p, max_p = [1e10]*3, [-1e10]*3
        for f in faces:
            bbox = f.GetBoundingBox()
            for i in range(3):
                min_p[i] = min(min_p[i], bbox.Min[i])
                max_p[i] = max(max_p[i], bbox.Max[i])
        
        c_x, c_y, c_z = (min_p[0]+max_p[0])/2, (min_p[1]+max_p[1])/2, (min_p[2]+max_p[2])/2

        # 2. 面を厚付けして一時的なソリッドを作成 (Thicken)
        # ※サーフェスのままだとブロックと結合できないため
        extract_builder = work_part.Features.CreateExtractFaceBuilder(NXOpen.Features.Feature.Null)
        for f in faces: extract_builder.FaceCollector.Add(f)
        extract_feat = extract_builder.Commit()
        
        # 3. ブランク（角材）の生成
        if mode == "VERTICAL":
            # 縦持ちシャンク
            origin = NXOpen.Point3d(c_x - 10.0, c_y - 10.0, max_p[2] + OFFSET_DIST)
            block_builder = work_part.Features.CreateBlockFeatureBuilder(NXOpen.Features.Feature.Null)
            block_builder.SetOriginAndDimensions(origin, "20.0", "20.0", "40.0")
            blank_feat = block_builder.Commit()
            block_builder.Destroy()
            
        elif mode == "HORIZONTAL":
            # 横当て t25 (自動判定)
            depth = max_p[0] - min_p[0]
            auto_t = 25.0
            for t in [10.0, 15.0, 20.0, 25.0, 30.0, 40.0, 50.0]:
                if t >= depth + 5.0:
                    auto_t = t
                    break
            
            origin = NXOpen.Point3d(max_p[0] + OFFSET_DIST, c_y - 25.0, c_z - 25.0)
            block_builder = work_part.Features.CreateBlockFeatureBuilder(NXOpen.Features.Feature.Null)
            block_builder.SetOriginAndDimensions(origin, str(auto_t), "50.0", "50.0")
            blank_feat = block_builder.Commit()
            block_builder.Destroy()

        print(f"Verified: Mode {mode} blank created and aligned for 180-deg rotation.")

    # 実行
    create_solid_electrode(v_faces, "VERTICAL")
    create_solid_electrode(h_faces, "HORIZONTAL")

if __name__ == "__main__":
    main()
