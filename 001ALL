Private Sub AddPageBreak(ByVal doc As Document)
    Dim r As Range
    Set r = doc.Content
    r.Collapse wdCollapseEnd
    r.InsertBreak Type:=wdPageBreak
End Sub

Private Sub SetCellText(ByVal t As Table, ByVal row As Long, ByVal col As Long, ByVal text As String)
    With t.Cell(row, col).Range
        .Text = text
        .Font.NameFarEast = "Yu Gothic"
        .Font.Name = "Yu Gothic"
        .Font.Size = 8
        .ParagraphFormat.Alignment = wdAlignParagraphCenter
        .ParagraphFormat.SpaceAfter = 0
    End With
    t.Cell(row, col).VerticalAlignment = wdCellAlignVerticalCenter
End Sub

Private Sub SetCellTextLeft(ByVal t As Table, ByVal row As Long, ByVal col As Long, ByVal text As String)
    With t.Cell(row, col).Range
        .Text = text
        .Font.NameFarEast = "Yu Gothic"
        .Font.Name = "Yu Gothic"
        .Font.Size = 8
        .ParagraphFormat.Alignment = wdAlignParagraphLeft
        .ParagraphFormat.SpaceAfter = 0
    End With
    t.Cell(row, col).VerticalAlignment = wdCellAlignVerticalCenter
End Sub

Private Sub FormatStandardTable(ByVal t As Table, Optional ByVal headerColor As Long = -1)
    If headerColor = -1 Then headerColor = RGB(31, 78, 121)

    t.Borders.Enable = True
    t.AllowAutoFit = True
    t.AutoFitBehavior wdAutoFitWindow

    With t.Rows(1).Range
        .Font.Bold = True
        .Font.Color = wdColorWhite
        .Shading.BackgroundPatternColor = headerColor
    End With

    Dim c As Cell
    For Each c In t.Range.Cells
        c.Range.Font.NameFarEast = "Yu Gothic"
        c.Range.Font.Name = "Yu Gothic"
        c.Range.Font.Size = 8
        c.VerticalAlignment = wdCellAlignVerticalCenter
    Next c
End Sub

Private Sub AddCaption(ByVal doc As Document, ByVal text As String)
    Dim p As Paragraph
    Set p = doc.Content.Paragraphs.Add
    p.Range.Text = text
    p.Range.Font.NameFarEast = "Yu Gothic"
    p.Range.Font.Name = "Yu Gothic"
    p.Range.Font.Size = 9
    p.Range.Font.Italic = True
    p.Range.ParagraphFormat.Alignment = wdAlignParagraphCenter
    p.Range.InsertParagraphAfter
End Sub

Private Sub InsertPictureIfExists(ByVal doc As Document, ByVal fileName As String, ByVal caption As String)
    Dim p As String
    p = GetMacroFolder() & "\images\" & fileName

    If Len(Dir(p)) = 0 Then
        AddNote doc, "【図例貼付予定】" & caption & "　※ " & p & " が存在しないため未挿入"
        Exit Sub
    End If

    Dim r As Range
    Set r = doc.Content
    r.Collapse wdCollapseEnd

    Dim ils As InlineShape
    Set ils = doc.InlineShapes.AddPicture(FileName:=p, LinkToFile:=False, SaveWithDocument:=True, Range:=r)

    If ils.Width > CentimetersToPoints(16) Then
        ils.LockAspectRatio = True
        ils.Width = CentimetersToPoints(16)
    End If

    AddCaption doc, caption
End Sub

