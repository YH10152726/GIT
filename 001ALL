Option Explicit

'============================================================
' 面色定義標準書 自動生成マクロ
' 目的:
'   Word VBAだけで、面色定義標準書のたたき台DOCXを自動生成する。
'
' 使い方:
'   1) Wordを開く
'   2) Alt + F11
'   3) 挿入 > 標準モジュール
'   4) このコードを貼り付け
'   5) Generate_Menshoku_Standard を実行
'
' 注意:
'   - 出力先は基本的にデスクトップ。
'   - 画像は任意。マクロ保存先と同じ場所に images フォルダを作り、
'     fig_5_1.png などを置くと自動挿入する。
'   - .docx はマクロを保持できないため、このコードを保存する元ファイルは .docm 推奨。
'============================================================

Private Const DOC_TITLE As String = "面色定義標準書（成形機能部品用）"
Private Const DOC_REV As String = "Rev.0.8（自動生成たたき台）"
Private Const DOC_NO As String = "YMDN-3D-MC-001"
Private Const DEPT As String = "工作部　工機技術課　工設係"

Public Sub Generate_Menshoku_Standard()
    On Error GoTo EH

    Dim doc As Document
    Set doc = Documents.Add

    Application.ScreenUpdating = False

    SetupPage doc
    SetupStyles doc

    AddCover doc
    AddTocPage doc

    AddRevisionHistory doc
    AddPrecheckItems doc

    AddChapterPurpose doc
    AddChapterScope doc
    AddChapterTerms doc
    AddChapterBasicPolicy doc
    AddColorDefinitionTable doc
    AddFaceColorPrinciples doc
    AddHoleThreadRules doc
    AddUsageRules doc
    AddProcessChecks doc
    AddIssueJudgement doc
    AddChecklist doc
    AddWorkflow doc
    AddRaci doc
    AddTrialEvaluation doc
    AddFeedbackSheets doc
    AddAppendix doc

    UpdateAllFields doc

    Dim outPath As String
    outPath = GetDefaultOutputPath("面色定義標準書（成形機能部品用）_Auto.docx")

    doc.SaveAs2 FileName:=outPath, FileFormat:=wdFormatXMLDocument

    Application.ScreenUpdating = True
    MsgBox "生成完了:" & vbCrLf & outPath, vbInformation

    Exit Sub

EH:
    Application.ScreenUpdating = True
    MsgBox "生成中にエラーが発生しました。" & vbCrLf & _
           "No: " & Err.Number & vbCrLf & _
           "内容: " & Err.Description, vbCritical
End Sub

'============================================================
' 基本設定
'============================================================

Private Sub SetupPage(ByVal doc As Document)
    With doc.PageSetup
        .PaperSize = wdPaperA4
        .Orientation = wdOrientPortrait
        .TopMargin = MillimetersToPoints(18)
        .BottomMargin = MillimetersToPoints(16)
        .LeftMargin = MillimetersToPoints(16)
        .RightMargin = MillimetersToPoints(16)
        .HeaderDistance = MillimetersToPoints(8)
        .FooterDistance = MillimetersToPoints(8)
    End With

    With doc.Sections(1).Headers(wdHeaderFooterPrimary).Range
        .Text = DOC_TITLE & "　" & DOC_REV & "　" & DEPT & "　【試行版】"
        .Font.Name = "Yu Gothic"
        .Font.Size = 8
        .ParagraphFormat.Alignment = wdAlignParagraphLeft
    End With

    With doc.Sections(1).Footers(wdHeaderFooterPrimary).Range
        .Text = ""
        .ParagraphFormat.Alignment = wdAlignParagraphCenter
        .Fields.Add Range:=doc.Sections(1).Footers(wdHeaderFooterPrimary).Range, Type:=wdFieldPage
    End With
End Sub

Private Sub SetupStyles(ByVal doc As Document)
    With doc.Styles(wdStyleNormal).Font
        .NameFarEast = "Yu Gothic"
        .Name = "Yu Gothic"
        .Size = 10
    End With
    With doc.Styles(wdStyleNormal).ParagraphFormat
        .LineSpacingRule = wdLineSpaceSingle
        .SpaceAfter = 4
    End With

    With doc.Styles(wdStyleHeading1).Font
        .NameFarEast = "Yu Gothic"
        .Name = "Yu Gothic"
        .Size = 16
        .Bold = True
        .Color = RGB(31, 78, 121)
    End With
    With doc.Styles(wdStyleHeading1).ParagraphFormat
        .SpaceBefore = 14
        .SpaceAfter = 8
        .KeepWithNext = True
    End With

    With doc.Styles(wdStyleHeading2).Font
        .NameFarEast = "Yu Gothic"
        .Name = "Yu Gothic"
        .Size = 12
        .Bold = True
        .Color = RGB(31, 78, 121)
    End With
    With doc.Styles(wdStyleHeading2).ParagraphFormat
        .SpaceBefore = 10
        .SpaceAfter = 6
        .KeepWithNext = True
    End With
End Sub

Private Function GetDefaultOutputPath(ByVal fileName As String) As String
    Dim basePath As String
    basePath = Environ$("USERPROFILE") & "\Desktop"
    If Len(Dir(basePath, vbDirectory)) = 0 Then
        basePath = Options.DefaultFilePath(wdDocumentsPath)
    End If
    GetDefaultOutputPath = basePath & "\" & fileName
End Function

Private Function GetMacroFolder() As String
    If Len(ThisDocument.Path) > 0 Then
        GetMacroFolder = ThisDocument.Path
    Else
        GetMacroFolder = Environ$("USERPROFILE") & "\Desktop"
    End If
End Function

Private Sub UpdateAllFields(ByVal doc As Document)
    Dim s As Section
    Dim hdr As HeaderFooter
    Dim ftr As HeaderFooter

    doc.Fields.Update

    For Each s In doc.Sections
        For Each hdr In s.Headers
            hdr.Range.Fields.Update
        Next hdr
        For Each ftr In s.Footers
            ftr.Range.Fields.Update
        Next ftr
    Next s
End Sub

