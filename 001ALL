' --- AutoCalibrate関連 ---
Private Sub Clear_Criteria(wsCrit As Worksheet)
    Dim last As Long: last = wsCrit.Cells(wsCrit.rows.Count, 1).End(xlUp).Row
    If last >= 2 Then wsCrit.rows("2:" & last).Delete
End Sub

Private Sub Apply_Baseline_To_Criteria(fam As String, runner As String, qclass As String, wsCrit As Worksheet)
    Dim wsBase As Worksheet: Set wsBase = ThisWorkbook.Worksheets("Baseline")
    Dim key As String: key = fam & "|" & runner & "|" & qclass
    Dim last As Long: last = wsBase.Cells(wsBase.rows.Count, 1).End(xlUp).Row
    Dim r As Long
    For r = 2 To last
        If CStr(wsBase.Cells(r, 1).value) = key Then
            Dim kpi As String, dir As String
            Dim p80 As Variant, p90 As Variant
            kpi = CStr(wsBase.Cells(r, 2).value)
            p80 = NzD(wsBase.Cells(r, 4).value, Empty)
            p90 = NzD(wsBase.Cells(r, 5).value, Empty)
            dir = CStr(wsBase.Cells(r, 6).value)

            Dim rowOut As Long: rowOut = wsCrit.Cells(wsCrit.rows.Count, 1).End(xlUp).Row + 1
            Dim mode As String: mode = IIf(dir = "big_better", ">=OK", "<=OK")
            Dim loOk As Variant, hiOk As Variant, loAttn As Variant, hiAttn As Variant
            If dir = "big_better" Then
                loOk = p80: loAttn = p90: hiOk = Empty: hiAttn = Empty
            Else
                hiOk = p80: hiAttn = p90: loOk = Empty: loAttn = Empty
            End If
            wsCrit.Cells(rowOut, 1).value = kpi
            wsCrit.Cells(rowOut, 2).value = mode
            wsCrit.Cells(rowOut, 3).value = loOk
            wsCrit.Cells(rowOut, 4).value = hiOk
            wsCrit.Cells(rowOut, 5).value = loAttn
            wsCrit.Cells(rowOut, 6).value = hiAttn
        End If
    Next r
End Sub

Private Sub Apply_Machine_Material_Rules(mach As String, fam As String, hold As Double, cycle As Double, wsCrit As Worksheet)
    Dim wsMach As Worksheet: Set wsMach = ThisWorkbook.Worksheets("Machine_Library")
    Dim maxClamp As Double, maxP As Double
    Dim r As Long, last As Long: last = wsMach.Cells(wsMach.rows.Count, 1).End(xlUp).Row
    For r = 2 To last
        If CStr(wsMach.Cells(r, 1).value) = mach Then
            maxClamp = NzD(wsMach.Cells(r, 2).value, 0#)
            maxP = NzD(wsMach.Cells(r, 3).value, 0#)
            Exit For
        End If
    Next r

    Add_Crit wsCrit, "Injection pressure 最大[MPa]", "<=OK", Empty, maxP * 0.8, Empty, maxP * 0.9, "MPa", "AutoCal-機械上限の80/90%"
    Add_Crit wsCrit, "Pressure drop 最大[MPa]", "<=OK", Empty, maxP * 0.6, Empty, maxP * 0.75, "MPa", "AutoCal-圧損の目安"
    Add_Crit wsCrit, "Clamp force 最大[kN]", "<=OK", Empty, maxClamp * 0.8, Empty, maxClamp * 0.9, "kN", "AutoCal-型締80/90%"
    If hold > 0 Then Add_Crit wsCrit, "Gate seal time [s]", "<=OK", Empty, hold - 0.5, Empty, hold, "s", "AutoCal-Control基準"
    If cycle > 0 Then Add_Crit wsCrit, "Time to freeze 最小/平均[s]", "<=OK", Empty, cycle - 1, Empty, cycle, "s", "AutoCal-Control基準"
End Sub

Private Sub Add_Crit(ws As Worksheet, kpi As String, mode As String, loOk As Variant, hiOk As Variant, loAttn As Variant, hiAttn As Variant, unit As String, note As String)
    Dim rowOut As Long: rowOut = ws.Cells(ws.rows.Count, 1).End(xlUp).Row + 1
    ws.Cells(rowOut, 1).value = kpi
    ws.Cells(rowOut, 2).value = mode
    ws.Cells(rowOut, 3).value = loOk
    ws.Cells(rowOut, 4).value = hiOk
    ws.Cells(rowOut, 5).value = loAttn
    ws.Cells(rowOut, 6).value = hiAttn
    ws.Cells(rowOut, 7).value = unit
    ws.Cells(rowOut, 8).value = note
End Sub

' --- Evaluate関連 ---
Private Sub Evaluate_Sheet(sheetName As String, wsCrit As Worksheet, wsPB As Worksheet, holdTime As Double, cycleTime As Double)
    Dim ws As Worksheet: Set ws = ThisWorkbook.Worksheets(sheetName)
    Dim last As Long: last = ws.Cells(ws.rows.Count, 1).End(xlUp).Row
    Dim r As Long, c As Long

    For r = 2 To last
        Dim kpi As String: kpi = CStr(ws.Cells(r, 1).value)
        If Len(kpi) = 0 Then GoTo NextR

        For c = 0 To 3
            Dim colVal As Long, colJudge As Long, colAct As Long
            colVal = 2 + c * 3: colJudge = colVal + 1: colAct = colVal + 2
            If Len(Trim$(CStr(ws.Cells(r, colVal).value))) = 0 Then GoTo NextC

            Dim v As Double: v = NzD(ws.Cells(r, colVal).value, 0#)
            Dim verdict As String, severity As String
            verdict = Judge_Value(kpi, v, wsCrit, holdTime, cycleTime, severity)

            ws.Cells(r, colJudge).value = verdict
            ws.Cells(r, colAct).value = Suggest_Action(kpi, severity, wsPB)
NextC:
        Next c
NextR:
    Next r
End Sub

Private Function Judge_Value(kpi As String, v As Double, wsCrit As Worksheet, holdTime As Double, cycleTime As Double, ByRef severity As String) As String
    Dim r As Long, last As Long: last = wsCrit.Cells(wsCrit.rows.Count, 1).End(xlUp).Row
    For r = 2 To last
        If CStr(wsCrit.Cells(r, 1).value) = kpi Then
            Dim mode As String: mode = CStr(wsCrit.Cells(r, 2).value)
            Dim loOk As Variant, hiOk As Variant, loAttn As Variant, hiAttn As Variant
            loOk = NzD(wsCrit.Cells(r, 3).value, Empty)
            hiOk = NzD(wsCrit.Cells(r, 4).value, Empty)
            loAttn = NzD(wsCrit.Cells(r, 5).value, Empty)
            hiAttn = NzD(wsCrit.Cells(r, 6).value, Empty)

            ' 特例1：Gate seal
            If kpi = "Gate seal time [s]" And holdTime > 0 Then
                If v <= holdTime - 0.5 Then severity = "OK": Judge_Value = "OK": Exit Function
                If v <= holdTime Then severity = "ATTN": Judge_Value = "要注意": Exit Function
                severity = "NG": Judge_Value = "NG": Exit Function
            End If
            ' 特例2：Freeze vs Cycle
            If kpi = "Time to freeze 最小/平均[s]" And cycleTime > 0 Then
                If v <= cycleTime - 1# Then severity = "OK": Judge_Value = "OK": Exit Function
                If v <= cycleTime Then severity = "ATTN": Judge_Value = "要注意": Exit Function
                severity = "NG": Judge_Value = "NG": Exit Function
            End If

            Select Case mode
                Case ">=OK"
                    If Not IsEmpty(loOk) And v >= loOk Then severity = "OK": Judge_Value = "OK": Exit Function
                    If Not IsEmpty(loAttn) And v >= loAttn Then severity = "ATTN": Judge_Value = "要注意": Exit Function
                    severity = "NG": Judge_Value = "NG": Exit Function
                Case "<=OK"
                    If Not IsEmpty(hiOk) And v <= hiOk Then severity = "OK": Judge_Value = "OK": Exit Function
                    If Not IsEmpty(hiAttn) And v <= hiAttn Then severity = "ATTN": Judge_Value = "要注意": Exit Function
                    severity = "NG": Judge_Value = "NG": Exit Function
                Case "範囲"
                    If Not IsEmpty(loOk) And Not IsEmpty(hiOk) And v >= loOk And v <= hiOk Then severity = "OK": Judge_Value = "OK": Exit Function
                    If Not IsEmpty(loAttn) And Not IsEmpty(hiAttn) And v >= loAttn And v <= hiAttn Then severity = "ATTN": Judge_Value = "要注意": Exit Function
                    severity = "NG": Judge_Value = "NG": Exit Function
                Case Else
                    severity = "ATTN": Judge_Value = "要注意": Exit Function
            End Select
        End If
    Next r
    severity = "ATTN": Judge_Value = "要注意"
End Function

Private Function Suggest_Action(kpi As String, severity As String, wsPB As Worksheet) As String
    Dim last As Long: last = wsPB.Cells(wsPB.rows.Count, 1).End(xlUp).Row
    Dim r As Long
    For r = 2 To last
        If CStr(wsPB.Cells(r, 1).value) = kpi And CStr(wsPB.Cells(r, 2).value) = severity Then
            Suggest_Action = CStr(wsPB.Cells(r, 3).value)
            Exit Function
        End If
    Next r
    Suggest_Action = ""
End Function


