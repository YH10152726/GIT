' --- ファイル/フォルダ操作 ---
Public Function PickFolder(prompt As String) As String
    With Application.FileDialog(msoFileDialogFolderPicker)
        .title = prompt
        If .Show = -1 Then PickFolder = .SelectedItems(1)
    End With
End Function

Public Function ListAllXML(root As String) As Collection
    Dim col As New Collection
    Dim stack As New Collection: stack.Add root
    Do While stack.Count > 0
        Dim path As String: path = stack(1): stack.Remove 1
        Dim f As String: f = dir(path & "\*.xml")
        Do While f <> ""
            col.Add path & "\" & f
            f = dir()
        Loop
        Dim subF As String: subF = dir(path & "\*", vbDirectory)
        Do While subF <> ""
            If subF <> "." And subF <> ".." Then
                If (GetAttr(path & "\" & subF) And vbDirectory) = vbDirectory Then stack.Add path & "\" & subF
            End If
            subF = dir()
        Loop
    Loop
    Set ListAllXML = col
End Function


' --- XML処理/解析 ---
Private Sub BuildContentIndex(files As Collection, ByRef dict As Object)
    Dim xm As Object: Set xm = CreateObject("MSXML2.DOMDocument.6.0")
    xm.async = False: xm.validateOnParse = False
    Dim i As Long
    For i = 1 To files.Count
        Dim p As String: p = files(i)
        On Error Resume Next
        If xm.Load(p) Then
            dict.Add p, LCase$(Left$(xm.Text, 4000))
        Else
            dict.Add p, ""
        End If
        On Error GoTo 0
    Next i
End Sub

Private Function ScoreFile(path As String, pattern As String, sig As String, cachedText As String) As Double
    Dim score As Double: score = 0
    Dim p As String: p = LCase$(path)
    Dim pat As String: pat = LCase$(pattern)
    If pat <> "" Then
        Dim pcs() As String: pcs = Split(Replace(pat, "*", ""), ";")
        Dim i As Long
        For i = LBound(pcs) To UBound(pcs)
            If Len(pcs(i)) > 0 And InStr(p, LCase$(pcs(i))) > 0 Then score = score + 1
        Next i
    End If
    If Len(sig) > 0 And InStr(cachedText, LCase$(Trim$(sig))) > 0 Then score = score + 2
    ScoreFile = score
End Function

Private Function AggregateXml(xmlPath As String, agg As String) As Variant
    Dim xm As Object: Set xm = CreateObject("MSXML2.DOMDocument.6.0")
    xm.async = False: xm.validateOnParse = False
    If Not xm.Load(xmlPath) Then AggregateXml = CVErr(xlErrNA): Exit Function

    Select Case agg
        Case "MIN", "MAX", "AVG", "DELTA"
            AggregateXml = AggregateXmlNumbers(xm, agg)
        Case "PLATEAU_TIME"
            AggregateXml = PlateauTimeFromXml(xm)
        Case Else
            AggregateXml = CVErr(xlErrNA)
    End Select
End Function

Private Function AggregateXmlNumbers(xm As Object, agg As String) As Variant
    Dim re As Object: Set re = CreateObject("VBScript.RegExp")
    re.pattern = "[-+]?\d+(\.\d+)?([eE][-+]?\d+)?"
    re.Global = True

    Dim txt As String: txt = xm.Text
    Dim m As Object: Set m = re.Execute(txt)
    If m.Count = 0 Then AggregateXmlNumbers = CVErr(xlErrNA): Exit Function

    Dim i As Long, v As Double, vmin As Double, vmax As Double, s As Double
    vmin = CDbl(m(0).value): vmax = vmin: s = 0#
    For i = 0 To m.Count - 1
        v = CDbl(m(i).value)
        If v < vmin Then vmin = v
        If v > vmax Then vmax = v
        s = s + v
    Next i
    Select Case agg
        Case "MIN":   AggregateXmlNumbers = vmin
        Case "MAX":   AggregateXmlNumbers = vmax
        Case "AVG":   AggregateXmlNumbers = s / m.Count
        Case "DELTA": AggregateXmlNumbers = vmax - vmin
    End Select
End Function

Private Function PlateauTimeFromXml(xm As Object) As Variant
    Dim slopeLim As Double: slopeLim = 0.005 ' 変化率しきい
    Dim needN As Long: needN = 5             ' 連続点数

    Dim t() As Double, y() As Double, n As Long
    ExtractTimeSeries xm, t, y, n
    If n < 2 Then PlateauTimeFromXml = CVErr(xlErrNA): Exit Function

    Dim i As Long, ok As Long: ok = 0
    For i = 1 To n - 1
        Dim dt As Double, dy As Double
        dt = t(i + 1) - t(i)
        If dt <= 0 Then GoTo cont
        dy = y(i + 1) - y(i)
        If Abs(dy / dt) <= slopeLim Then
            ok = ok + 1
        Else
            ok = 0
        End If
        If ok >= needN Then PlateauTimeFromXml = t(i + 1): Exit Function
cont:
    Next i
    PlateauTimeFromXml = CVErr(xlErrNA)
End Function

Private Sub ExtractTimeSeries(xm As Object, ByRef times() As Double, ByRef vals() As Double, ByRef n As Long)
    Dim re As Object: Set re = CreateObject("VBScript.RegExp")
    re.pattern = "[-+]?\d+(\.\d+)?([eE][-+]?\d+)?"
    re.Global = True
    Dim txt As String: txt = xm.Text
    Dim lines() As String: lines = Split(txt, vbLf)

    Dim t() As Double, v() As Double, cap As Long, i As Long
    cap = 0: n = 0
    For i = 0 To UBound(lines)
        Dim line As String: line = Trim$(lines(i))
        If Len(line) = 0 Then GoTo nexti
        Dim ms As Object: Set ms = re.Execute(line)
        If ms.Count >= 2 Then
            If n = cap Then
                cap = IIf(cap = 0, 256, cap * 2)
                ReDim Preserve t(1 To cap)
                ReDim Preserve v(1 To cap)
            End If
            n = n + 1
            t(n) = CDbl(ms(0).value)
            v(n) = CDbl(ms(1).value)
        End If
nexti:
    Next i
    If n > 0 Then
        ReDim Preserve t(1 To n)
        ReDim Preserve v(1 To n)
        times = t: vals = v
    End If
End Sub

Private Function ExtractNumericFromXML(path As String) As Variant
    Dim xm As Object: Set xm = CreateObject("MSXML2.DOMDocument.6.0")
    xm.async = False: xm.validateOnParse = False
    If Not xm.Load(path) Then ExtractNumericFromXML = CVErr(xlErrNA): Exit Function
    Dim re As Object: Set re = CreateObject("VBScript.RegExp")
    re.pattern = "[-+]?\d+(\.\d+)?([eE][-+]?\d+)?"
    re.Global = True
    Dim ms As Object: Set ms = re.Execute(xm.Text)
    If ms.Count = 0 Then ExtractNumericFromXML = CVErr(xlErrNA) Else ExtractNumericFromXML = CDbl(ms(0).value)
End Function


' --- データ書き込み/統計 ---
Private Sub WriteValueByLabel(sheetName As String, labelText As String, value As Variant)
    Dim ws As Worksheet: Set ws = ThisWorkbook.Worksheets(sheetName)
    Dim last As Long: last = ws.Cells(ws.rows.Count, 1).End(xlUp).Row
    Dim r As Long
    For r = 1 To last
        If CStr(ws.Cells(r, 1).value) = labelText Then
            Dim gi As Long
            For gi = 0 To 3
                Dim colVal As Long: colVal = 2 + gi * 3
                If Trim$(CStr(ws.Cells(r, colVal).value)) = "" Then
                    ws.Cells(r, colVal).value = value
                    Exit Sub
                End If
            Next gi
            Exit Sub
        End If
    Next r
End Sub

Private Function Percentile(arr As Object, p As Double) As Double
    ' ArrayListを引数にとり、線形補間法でパーセンタイルを計算
    Dim n As Long, idx As Double
    n = arr.Count
    If n = 0 Then Percentile = 0: Exit Function
    If n = 1 Then Percentile = arr(0): Exit Function
    
    idx = (n - 1) * p
    Dim lo As Long: lo = Int(idx)
    Dim hi As Long: hi = lo + 1
    Dim frac As Double: frac = idx - lo
    
    Percentile = arr(lo) * (1 - frac) + arr(hi) * frac
End Function


' --- その他 汎用ヘルパー ---
Public Function SheetExists(name As String) As Boolean
    On Error Resume Next
    SheetExists = Not ThisWorkbook.Worksheets(name) Is Nothing
    On Error GoTo 0
End Function

Public Function ToBool(v As Variant) As Boolean
    If IsEmpty(v) Or IsNull(v) Then ToBool = False: Exit Function
    If VarType(v) = vbBoolean Then ToBool = v: Exit Function
    Select Case UCase$(Trim$(CStr(v)))
        Case "TRUE", "はい", "-1", "1"
            ToBool = True
        Case Else
            ToBool = False
    End Select
End Function

Public Function NzD(v As Variant, d As Variant) As Variant
    If IsError(v) Or IsNull(v) Or v = "" Then NzD = d Else NzD = v
End Function
