Option Explicit

Sub ImportDataFromExternalBook()
    Dim wbSource As Workbook
    Dim wsSource As Worksheet
    Dim wsDest As Worksheet
    Dim FilePath As Variant
    Dim sheetNames As Variant
    Dim sName As Variant
    Dim i As Long
    
    ' --- 読み込むシート名の定義 ---
    sheetNames = Array("入力用 (1)", "入力用 (2)", "入力用 (3)")
    
    ' 1. ファイル選択ダイアログ
    FilePath = Application.GetOpenFilename("Excelファイル (*.xls; *.xlsx; *.xlsm),*.xls;*.xlsx;*.xlsm", , "品目票ファイルを選択してください")
    If FilePath = False Then Exit Sub
    
    Application.ScreenUpdating = False
    
    ' 2. 外部ブックを開く（読み取り専用）
    Set wbSource = Workbooks.Open(Filename:=FilePath, ReadOnly:=True)
    
    ' 3. シートごとにデータを転記
    For i = LBound(sheetNames) To UBound(sheetNames)
        sName = sheetNames(i)
        
        ' 転記先シートの設定
        On Error Resume Next
        Set wsDest = ThisWorkbook.Worksheets(sName)
        On Error GoTo 0
        
        If wsDest Is Nothing Then
            MsgBox "自ブックにシート '" & sName & "' が見つかりません。", vbExclamation
        Else
            ' 転記元シートの特定（外部ブックに同名シートがある前提）
            On Error Resume Next
            Set wsSource = wbSource.Worksheets(sName)
            On Error GoTo 0
            
            If Not wsSource Is Nothing Then
                ' --- 転記処理 ---
                ' 転記先を一度クリア
                wsDest.Cells.ClearContents
                
                ' データがある範囲を丸ごと値貼り付け（A1から使用範囲まで）
                ' ※これなら品番(B列)、品名、数量すべてコピーされます
                wsDest.Range("A1").Resize(wsSource.UsedRange.Rows.Count, wsSource.UsedRange.Columns.Count).Value = _
                    wsSource.UsedRange.Value
            Else
                ' 外部ブックにシートがない場合はスキップ（何もしない）
            End If
        End If
        
        Set wsDest = Nothing
        Set wsSource = Nothing
    Next i
    
    ' 4. 外部ブックを閉じる
    wbSource.Close SaveChanges:=False
    
    Application.ScreenUpdating = True
    
    ' 5. 続けて集計処理を実行するか確認
    If MsgBox("読み込みが完了しました。" & vbCrLf & "続けて数値を集計し、見積り表へ入力しますか？", vbYesNo + vbQuestion) = vbYes Then
        Call CountAndFillParameters ' さきほど渡した集計マクロを呼び出す
    End If

End Sub
