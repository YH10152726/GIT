Attribute VB_Name = "modBuild"
Option Explicit

'------------------------------------------------------------
' ■ メインプロシージャ：操作説明付きのExcelブックを生成します
'------------------------------------------------------------
Public Sub A00_BuildFriendlyWorkbook(Optional ByVal SaveAsPath As String = "")
    ' 既存シートを一旦リセット
    Dim ws As Worksheet
    Application.DisplayAlerts = False
    For Each ws In ThisWorkbook.Worksheets
        If ws.Name <> "Sheet1" Then ws.Delete ' 例外シート名があれば調整
    Next
    Application.DisplayAlerts = True
    
    ' --- 各シートの生成 ---
    Build_Sheet_HowToUse          ' ★最重要：「使い方」シート
    Build_Sheet_Target            ' 検索条件
    Build_Sheet_Weights           ' 重み付け
    Build_Sheet_Results           ' 類似度ランキング
    Build_Sheet_DB                ' 材料DB
    Build_Sheet_Config            ' 解析設定
    Build_Sheet_ImportLog         ' インポート履歴
    
    ' 最初に「使い方」シートを表示
    ThisWorkbook.Worksheets("使い方").Activate
    
    If Len(SaveAsPath) > 0 Then
        Application.DisplayAlerts = False
        ThisWorkbook.Worksheets("使い方").Select
        ThisWorkbook.SaveAs Filename:=SaveAsPath, FileFormat:=xlOpenXMLWorkbookMacroEnabled
        Application.DisplayAlerts = True
    End If
    
    MsgBox "操作説明付きのブック構造を生成しました。" & vbCrLf & _
           "最初に「使い方」シートの案内に沿って操作を開始してください。", vbInformation, "代替材料検索ツール"
End Sub


