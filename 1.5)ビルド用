    Dim w As Variant
    w = Array( _
        Array("PolymerMismatch", 100, "樹脂ファミリーが違う場合の基本ペナルティ"), _
        Array("FillerTypeMismatch", 40, "フィラー種類が違う場合の基本ペナルティ"), _
        Array("FillerWtPct_per_%", 1#, "フィラー含有率が1%違うごとのペナルティ"), _
        Array("SolidDensity_per_gcc", 20#, "固体密度が 0.01 g/cm3 違うごとのペナルティ"), _
        Array("Flow_VI_or_MFR", 3#, "Moldflow粘度指数(VI)の差に対するペナルティ"), _
        Array("pvT_coeff_vector_norm", 0#, "（上級者向け）pvT係数ベクトルの差（デフォルトOFF）"), _
        Array("Anisotropy_E1E2_ratio", 20#, "弾性率の異方性（E1/E2比）の差に対するペナルティ"), _
        Array("Anisotropy_Alpha_ratio", 25#, "線膨張係数の異方性（α2/α1比）の差に対するペナルティ"), _
        Array("Cp_avg", 2#, "（開発中）比熱の平均値の差"), _
        Array("k_avg", 2#, "（開発中）熱伝導率の平均値の差"), _
        Array("Rec_Melt_mid", 0.5, "推奨樹脂温度の中心値が1℃違うごとのペナルティ"), _
        Array("Rec_Mold_mid", 0.5, "推奨金型温度の中心値が1℃違うごとのペナルティ") _
