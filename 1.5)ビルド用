' 【新規】★★★★★ 「使い方」シート ★★★★★
Private Sub Build_Sheet_HowToUse()
    Dim ws As Worksheet: Set ws = EnsureSheet("使い方", True) ' 先頭に追加
    
    ' --- デザインと説明文 ---
    ws.Cells.Clear
    With ws.Cells
        .Interior.Color = RGB(242, 242, 242)
        .Font.Name = "Meiryo UI"
    End With
    
    ws.Range("B2:K2").Merge
    ws.Range("B2").Value = "Moldflow 代替材料 検索ツール"
    With ws.Range("B2").Font
        .Size = 20
        .Bold = True
    End With
    
    ws.Range("B4:K5").Merge
    ws.Range("B4").Value = "このツールは、Moldflowからエクスポートした材料データを元に、指定した条件に最も近い代替材料を自動で検索・ランク付けします。"
    ws.Range("B4").WrapText = True
    
    ' --- 操作手順 ---
    Dim i As Long
    For i = 1 To 3: ws.Columns(i * 3).ColumnWidth = 2: Next
    ws.Columns("B:B").ColumnWidth = 30
    ws.Columns("E:E").ColumnWidth = 30
    ws.Columns("H:H").ColumnWidth = 30

    ' Step 1
    ws.Range("B7:D12").Interior.Color = vbWhite
    ws.Range("B7").Value = "STEP 1：材料データの取込み"
    ws.Range("B8:D10").Merge
    ws.Range("B8").Value = "Moldflowの[Compare/Report]機能で保存した材料レポート(.txt)をデータベースに取り込みます。" & vbCrLf & "（複数ファイル選択可）"
    CreateButton ws, ws.Range("B11"), "データをDBに取り込む", "modImport.ImportReports"

    ' Step 2
    ws.Range("E7:G12").Interior.Color = vbWhite
    ws.Range("E7").Value = "STEP 2：検索条件の入力"
    ws.Range("E8:G10").Merge
    ws.Range("E8").Value = "隣の「検索条件」シートを開き、探したい材料の特性（樹脂、フィラー、物性値など）を入力してください。"
    CreateButton ws, ws.Range("E11"), "「検索条件」シートへ移動", "GoToTargetSheet"

    ' Step 3
    ws.Range("H7:J12").Interior.Color = vbWhite
    ws.Range("H7").Value = "STEP 3：類似品ランキング実行"
    ws.Range("H8:J10").Merge
    ws.Range("H8").Value = "入力した条件に基づき、データベース内の全材料を評価し、類似度が高い順に「類似度ランキング」シートへ出力します。"
    CreateButton ws, ws.Range("H11"), "類似品を検索・ランク付け", "modScore.RankSimilar"
    
    For i = 7 To 7
        With ws.Rows(i).Font
            .Bold = True
            .Size = 12
        End With
    Next
End Sub

' --- 「検索条件」シート ---
Private Sub Build_Sheet_Target()
    Dim wsT As Worksheet: Set wsT = EnsureSheet("検索条件")
    wsT.Cells.Clear
    wsT.Range("A1:D1").Value = Array("項目", "目標値", "単位", "説明")
    wsT.Range("A1:D1").Interior.ColorIndex = 15
    wsT.Range("A1:D1").Font.Bold = True
    
    Dim t As Variant
    t = Array( _
        Array("① 樹脂ファミリー", "PA66", "", "例: PA66, PC, ABS など。'Any'で指定なし"), _
        Array("② フィラー種類", "GF", "", "例: GF, CF, Mineral など。'Any'で指定なし"), _
        Array("③ フィラー含有率", 30, "%", "目標とする重量パーセント"), _
        Array("④ 固体密度", 1.35, "g/cm3", "（任意）"), _
        Array("⑤ Moldflow粘度指数(VI)", "", "", "（任意）特定の流動性を狙う場合"), _
        Array("⑥ 平均線膨張係数", "", "μm/mK", "（任意）そりへの影響が大きい。異方性比率も考慮可"), _
        Array("⑦ 弾性率（乾燥時）", "", "GPa", "（任意）そりへの影響が大きい。異方性比率も考慮可"), _
        Array("⑧ 推奨樹脂温度（中心値）", "", "℃", "（任意）"), _
        Array("⑨ 推奨金型温度（中心値）", "", "℃", "（任意）"), _
        Array("⑩ その他メモ", "", "", "検索条件に関するメモ") _
    )
    
    Dim i As Long
    For i = 0 To UBound(t)
        wsT.Cells(i + 2, 1).Resize(1, 4).Value = t(i)
        wsT.Cells(i + 2, 1).Font.Bold = True
        wsT.Range("A" & i + 2 & ":D" & i + 2).Borders(xlEdgeBottom).LineStyle = xlDot
    Next
    wsT.Columns("A").ColumnWidth = 25
    wsT.Columns("B").ColumnWidth = 15
    wsT.Columns("C").ColumnWidth = 10
    wsT.Columns("D").ColumnWidth = 50
    wsT.Range("D2:D" & UBound(t) + 2).Font.Color = RGB(128, 128, 128)
End Sub

