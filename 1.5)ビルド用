'------------------------------------------------------------
' ■ 補助ユーティリティ
'------------------------------------------------------------

' --- 安全にシートを確保する関数 ---
Private Function EnsureSheet(ByVal nm As String, Optional isFirst As Boolean = False) As Worksheet
    On Error Resume Next
    Set EnsureSheet = ThisWorkbook.Worksheets(nm)
    On Error GoTo 0
    If EnsureSheet Is Nothing Then
        If isFirst Then
            Set EnsureSheet = ThisWorkbook.Worksheets.Add(Before:=ThisWorkbook.Worksheets(1))
        Else
            Set EnsureSheet = ThisWorkbook.Worksheets.Add(After:=ThisWorkbook.Worksheets(ThisWorkbook.Worksheets.Count))
        End If
        EnsureSheet.Name = nm
    End If
End Function

' --- ボタンを生成するサブルーチン ---
Private Sub CreateButton(ws As Worksheet, pos As Range, txt As String, macroName As String)
    Dim btn As Button
    Set btn = ws.Buttons.Add(pos.Left, pos.Top, pos.Width, pos.Height)
    With btn
        .OnAction = macroName
        .Caption = txt
        .Font.Name = "Meiryo UI"
    End With
End Sub

' --- 「検索条件」シートにジャンプするマクロ ---
Public Sub GoToTargetSheet()
    On Error Resume Next
    ThisWorkbook.Worksheets("検索条件").Activate
    If Err.Number <> 0 Then
        MsgBox "「検索条件」シートが見つかりません。", vbExclamation
        Err.Clear
    End If
End Sub

