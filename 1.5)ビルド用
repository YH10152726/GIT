' --- 「解析設定」シート ---
Private Sub Build_Sheet_Config()
    Dim wsC As Worksheet: Set wsC = EnsureSheet("解析設定")
    wsC.Cells.Clear
    wsC.Range("A1:C1").Value = Array("設定項目", "設定値", "説明")
    
    Dim c As Variant
    c = Array( _
        Array("評価プリセット", "バランス", "ランキング実行時の重み付けを自動調整します"), _
        Array("FlowGrid_Temps_C", "260,280,300,320", "（開発用）粘度評価グリッド（温度）"), _
        Array("FlowGrid_Shear_1persec", "100,1000,10000,50000", "（開発用）粘度評価グリッド（せん断速度）"), _
        Array("pvT_Temps_C", "40,80,120,200", "（開発用）pvT評価グリッド（温度）"), _
        Array("pvT_Pressures_MPa", "0,50,100", "（開発用）pvT評価グリッド（圧力）"), _
        Array("Eval_Cp_Temps_C", "80,140,200", "（開発用）比熱の代表評価温度"), _
        Array("Eval_k_Temps_C", "100,150,200", "（開発用）熱伝導率の代表評価温度") _
    )
    Dim i As Long
    For i = 0 To UBound(c)
        wsC.Cells(i + 2, 1).Resize(1, 3).Value = c(i)
    Next
    
    ' プリセット選択をドロップダウンリストに
    With wsC.Range("B2").Validation
        .Delete
        .Add Type:=xlValidateList, AlertStyle:=xlValidAlertStop, Operator:= _
        xlBetween, Formula1:="バランス,流動性重視,そり重視"
        .IgnoreBlank = True
        .InCellDropdown = True
    End With
    
    With wsC.Range("A1:C1")
        .Interior.ColorIndex = 15
        .Font.Bold = True
    End With
    wsC.Columns("A:C").AutoFit
End Sub

