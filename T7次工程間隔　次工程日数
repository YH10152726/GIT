' --- メイン処理 ---
' このサブルーチンをボタンに登録します
Public Sub AddNextProcessInterval()
    ' --- 定数定義 ---
    Const SHEET_NAME As String = "工程表" ' 対象シート名
    Const SETTINGS_SHEET_NAME As String = "シート2" ' 設定用シート名
    Const INTERVAL_CELL As String = "Z2" ' 次工程間隔を入力するセル
    Const START_ROW As Long = 2 ' データ開始行
    Const COL_ITEM_NAME As String = "AH" ' 品名（ブロック定義用）
    Const COL_PROCESS_NAME As String = "AJ" ' 工程名
    Const COL_INTERVAL_OUTPUT As String = "BK" ' 次工程間隔（出力先）
    Const END_MARKER As String = "END" ' データ終了マーカー

    ' --- 光陽産業向け処理の定数 ---
    Const COL_HEAT_SUPPLIER As String = "AL"      ' 熱処理先が入力されている列
    Const COL_TAP_OUTPUT As String = "BF"         ' 「2」を出力する列
    Const VAL_KOUYOU As String = "光陽産業"      ' 条件となる業者名
    Const PROC_TAP As String = "穴あけﾀｯﾌﾟ"     ' 条件となる工程名
    Const VAL_TAP_OUTPUT As Long = 2              ' 出力する値

    ' --- 変数定義 ---
    Dim ws As Worksheet
    Dim wsSettings As Worksheet
    Dim lastRow As Long
    Dim blockStartRow As Long
    Dim blockEndRow As Long
    Dim i As Long
    Dim intervalValue As Long
    Dim valFromCell As Variant

    ' --- 初期設定 ---
    On Error Resume Next
    Set ws = ThisWorkbook.Sheets(SHEET_NAME)
    Set wsSettings = ThisWorkbook.Sheets(SETTINGS_SHEET_NAME)
    On Error GoTo 0
    
    If ws Is Nothing Then
        MsgBox "シート「" & SHEET_NAME & "」が見つかりません。", vbCritical
        Exit Sub
    End If
    If wsSettings Is Nothing Then
        MsgBox "設定用シート「" & SETTINGS_SHEET_NAME & "」が見つかりません。", vbCritical
        Exit Sub
    End If

    ' シート2のZ2セルから値を取得
    valFromCell = wsSettings.Range(INTERVAL_CELL).Value

    ' 値が有効か（正の数値か）をチェック
    If Not IsNumeric(valFromCell) Or valFromCell <= 0 Then
        MsgBox "「" & SETTINGS_SHEET_NAME & "」の " & INTERVAL_CELL & " セルに、" & vbCrLf & _
               "次工程間隔として有効な正の数値を入力してください。", vbCritical, "設定エラー"
        Exit Sub
    End If
    
    ' Long型に変換して変数に格納
    intervalValue = CLng(valFromCell)

    ' --- 処理 ---
    Application.ScreenUpdating = False

    ' 最終行を取得 (ENDマーカー基準)
    On Error GoTo FindErrorHandler
    lastRow = ws.Columns(COL_ITEM_NAME).Find(What:=END_MARKER, LookIn:=xlValues, LookAt:=xlWhole).Row
    On Error GoTo 0

    ' BK列とBF列をクリア
    ws.Range(ws.Cells(START_ROW, COL_INTERVAL_OUTPUT), ws.Cells(lastRow, COL_INTERVAL_OUTPUT)).ClearContents
    ws.Range(ws.Cells(START_ROW, COL_TAP_OUTPUT), ws.Cells(lastRow, COL_TAP_OUTPUT)).ClearContents

    ' ブロックの開始行をセット
    blockStartRow = START_ROW

    ' 2行目から最終行までループ
    For i = START_ROW To lastRow
        ' AH列に「品名」または「END」があるかチェック
        If ws.Cells(i, COL_ITEM_NAME).Value <> "" Or i = lastRow Then
            
            ' 現在のブロックの終了行を設定 (品名/ENDの手前の行)
            blockEndRow = i - 1
            
            ' 前のブロックが存在すれば処理を実行
            If blockEndRow >= blockStartRow Then
                Call ProcessSingleBlock(ws, blockStartRow, blockEndRow, _
                                        COL_PROCESS_NAME, COL_INTERVAL_OUTPUT, intervalValue, _
                                        COL_HEAT_SUPPLIER, COL_TAP_OUTPUT, VAL_KOUYOU, PROC_TAP, VAL_TAP_OUTPUT)
            End If
            
            ' 次のブロックの開始行を更新
            blockStartRow = i
        End If
    Next i
    
    Application.ScreenUpdating = True
    MsgBox "次工程間隔および特別処理の入力を完了しました。", vbInformation
    Exit Sub

FindErrorHandler:
    MsgBox "最終行マーカー「" & END_MARKER & "」が " & COL_ITEM_NAME & "列に見つかりませんでした。", vbCritical
    Application.ScreenUpdating = True
End Sub


' --- 1つのブロックを処理するサブルーチン ---
Private Sub ProcessSingleBlock(ByVal ws As Worksheet, ByVal startRow As Long, ByVal endRow As Long, _
                                ByVal processCol As String, ByVal intervalOutputCol As String, ByVal valueToSet As Long, _
                                ByVal heatSupplierCol As String, ByVal tapOutputCol As String, ByVal kouyouName As String, ByVal tapProcessName As String, ByVal tapOutputValue As Long)
    
    Dim i As Long
    Dim currentProcess As String
    Dim nextProcess As String
    Dim nextHeatSupplier As String
    
    For i = startRow To endRow - 1
        currentProcess = Trim(CStr(ws.Cells(i, processCol).Value))
        nextProcess = Trim(CStr(ws.Cells(i + 1, processCol).Value))
        
        ' --- 元の次工程間隔の処理 ---
        If currentProcess <> nextProcess Then
            If Not IsExcludedProcess(currentProcess) Then
                ws.Cells(i, intervalOutputCol).Value = valueToSet
            End If
        End If
        
        ' --- 追加した処理 ---
        ' 次の行の熱処理先を取得
        nextHeatSupplier = Trim(CStr(ws.Cells(i + 1, heatSupplierCol).Value))
        
        ' 【修正】現在の行が「穴あけﾀｯﾌﾟ」で、かつ次の行の熱処理先に「光陽産業」が "含まれる" 場合
        If currentProcess = tapProcessName And InStr(nextHeatSupplier, kouyouName) > 0 Then
            ws.Cells(i, tapOutputCol).Value = tapOutputValue
        End If
    Next i
    
    ' --- ブロック最終行の次工程間隔処理 ---
    currentProcess = Trim(CStr(ws.Cells(endRow, processCol).Value))
    nextProcess = Trim(CStr(ws.Cells(endRow + 1, processCol).Value))

    If currentProcess <> nextProcess Then
        If Not IsExcludedProcess(currentProcess) Then
            ws.Cells(endRow, intervalOutputCol).Value = valueToSet
        End If
    End If
End Sub


' --- 例外工程かどうかを判定する関数 ---
Private Function IsExcludedProcess(ByVal processName As String) As Boolean
    IsExcludedProcess = False
    
    Select Case Trim(processName)
        Case "主材購入", "穴あけﾀｯﾌﾟ", "熱処理"
            IsExcludedProcess = True
    End Select
End Function

