Attribute VB_Name = "modImport"
Option Explicit

' DB header sheet
Private Const DB_SHEET As String = "DB"
Private Const LOG_SHEET As String = "ImportLog"

Public Sub ClearDB()
    Dim ws As Worksheet: Set ws = ThisWorkbook.Worksheets(DB_SHEET)
    ws.Rows("2:" & ws.Rows.Count).ClearContents
End Sub

' Moldflowの Compare / Report から保存した txt を複数読み込む
Public Sub ImportReports()
    Dim files As Variant
    files = Application.GetOpenFilename( _
        FileFilter:="Text Files (*.txt),*.txt,All Files (*.*),*.*", _
        Title:="Moldflowレポートtxtを選択（複数可）", _
        MultiSelect:=True)
    If VarType(files) = vbBoolean Then Exit Sub
    
    Dim ws As Worksheet: Set ws = ThisWorkbook.Worksheets(DB_SHEET)
    Dim logWs As Worksheet: Set logWs = ThisWorkbook.Worksheets(LOG_SHEET)
    Dim last As Long: last = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
    If last < 2 Then last = 1
    
    Dim f As Variant, txt As String, lines As Variant
    Dim totalParsed As Long, warnings As String, added As Long
    
    For Each f In files
        warnings = ""
        txt = ReadAllText(CStr(f))
        If Len(txt) = 0 Then
            warnings = "読み込み失敗"
            added = 0
        Else
            lines = SplitLines(txt)
            added = ParseOneFile(lines, CStr(f), ws, last, warnings)
        End If
        totalParsed = totalParsed + added
        Dim lr As Long: lr = logWs.Cells(logWs.Rows.Count, 1).End(xlUp).Row
        If lr < 2 Then lr = 1
        logWs.Cells(lr + 1, 1).Resize(1, 4).Value = Array(NowStr, CStr(f), added, warnings)
    Next f
    
    MsgBox "取込み完了。追加 " & totalParsed & " 行", vbInformation
End Sub

' 1つのtxtから1材料分を抽出（Compareの書式でも1材料ずつ保存しておく運用を想定）
Private Function ParseOneFile(ByVal lines As Variant, ByVal src As String, ByRef ws As Worksheet, ByRef last As Long, ByRef warnings As String) As Long
    Dim sup$, grade$, base$, ds$
    Dim fillerType$, fillerPct As Double, fillerRho As Double
    Dim meltRho As Double, solidRho As Double
    Dim b5 As Double, b6 As Double, b1m As Double, b2m As Double, b3m As Double, b4m As Double
    Dim b1s As Double, b2s As Double, b3s As Double, b4s As Double
    Dim e1 As Double, e2 As Double, nu12 As Double, nu23 As Double, g12 As Double
    Dim a1 As Double, a2 As Double
    Dim meltMin As Double, meltMax As Double, moldMin As Double, moldMax As Double
    Dim maxMelt As Double, maxShearS As Double, maxShearR As Double
    Dim viText$, mfr As Double, mfrT As Double, mfrLoad As Double, ttrans As Double
    Dim cp80 As Double, cp140 As Double, cp200 As Double
    Dim k100 As Double, k150 As Double, k200 As Double
    Dim cpline As Long, kline As Long, i As Long
    
    ' Supplier / Grade
    sup = FindTextNearKey(lines, "Supplier")
    If sup = "" Then sup = FindTextNearKey(lines, "メーカー")
    grade = FindTextNearKey(lines, "Grade")
    If grade = "" Then grade = FindTextNearKey(lines, "商品名")
    
    ' Base polymer
    base = FindTextNearKey(lines, "Resin abbreviation")
    If base = "" Then base = FindTextNearKey(lines, "樹脂略号")
    If base = "" Then base = FindTextNearKey(lines, "樹脂名")
    base = NormalizeBasePolymer(base)
    
    ' Data source
    ds = FindTextNearKey(lines, "Data Source")
    If ds = "" Then ds = FindTextNearKey(lines, "データ情報源")
    
    ' Filler block（タイプ/含有率/フィラー密度）
    Dim fillLine As String
    fillLine = FindTextNearKey(lines, "Fiber / Filler")
    If fillLine = "" Then fillLine = FindTextNearKey(lines, "フィラー データ")
    fillerType = NormalizeFillerType(fillLine)
    For i = LBound(lines) To UBound(lines)
        If InStr(1, lines(i), "重量%", vbTextCompare) > 0 Or InStr(1, lines(i), "wt%", vbTextCompare) > 0 Then
            fillerPct = FirstNumberIn(lines(i)): Exit For
        End If
    Next i
    For i = LBound(lines) To UBound(lines)
        If InStr(1, lines(i), "密度 (rho)", vbTextCompare) > 0 Or InStr(1, lines(i), "Density (rho)", vbTextCompare) > 0 Then
            fillerRho = FirstNumberIn(lines(i)): Exit For
        End If
    Next i
    
    ' pvT coefficients
    meltRho = FindValueNearKey(lines, "溶融密度"): If meltRho = 0 Then meltRho = FindValueNearKey(lines, "Melt Density")
    solidRho = FindValueNearKey(lines, "固体密度"): If solidRho = 0 Then solidRho = FindValueNearKey(lines, "Solid Density")
    b5 = FindValueNearKey(lines, "b5"): b6 = FindValueNearKey(lines, "b6")
    b1m = FindValueNearKey(lines, "b1m"): b2m = FindValueNearKey(lines, "b2m"): b3m = FindValueNearKey(lines, "b3m"): b4m = FindValueNearKey(lines, "b4m")
    b1s = FindValueNearKey(lines, "b1s"): b2s = FindValueNearKey(lines, "b2s"): b3s = FindValueNearKey(lines, "b3s"): b4s = FindValueNearKey(lines, "b4s")
    
    ' Mechanical & CTE
    e1 = FindValueNearKey(lines, "弾性率、第 1 主要方向 (E1)"): If e1 = 0 Then e1 = FindValueNearKey(lines, "Elastic modulus, major direction 1 (E1)")
    e2 = FindValueNearKey(lines, "弾性率、第 2 主要方向 (E2)"): If e2 = 0 Then e2 = FindValueNearKey(lines, "Elastic modulus, major direction 2 (E2)")
    nu12 = FindValueNearKey(lines, "ポアソン比 (v12)"): If nu12 = 0 Then nu12 = FindValueNearKey(lines, "Poisson's ratio (v12)")
    nu23 = FindValueNearKey(lines, "ポアソン比 (v23)"): If nu23 = 0 Then nu23 = FindValueNearKey(lines, "Poisson's ratio (v23)")
    g12 = FindValueNearKey(lines, "せん断弾性率 (G12)"): If g12 = 0 Then g12 = FindValueNearKey(lines, "Shear modulus (G12)")
    a1 = FindValueNearKey(lines, "Alpha1")
    a2 = FindValueNearKey(lines, "Alpha2")
    
    ' Recommended conditions
    meltMin = FindValueNearKey(lines, "樹脂温度範囲 (設定推奨値)" & vbCrLf & "最小"): If meltMin = 0 Then meltMin = FindValueNearKey(lines, "Recommended melt temperature range" & vbCrLf & "Min")
    meltMax = FindValueNearKey(lines, "樹脂温度範囲 (設定推奨値)" & vbCrLf & "最大"): If meltMax = 0 Then meltMax = FindValueNearKey(lines, "Recommended melt temperature range" & vbCrLf & "Max")
    moldMin = FindValueNearKey(lines, "金型温度範囲 (設定推奨値)" & vbCrLf & "最小"): If moldMin = 0 Then moldMin = FindValueNearKey(lines, "Recommended mold temperature range" & vbCrLf & "Min")
    moldMax = FindValueNearKey(lines, "金型温度範囲 (設定推奨値)" & vbCrLf & "最大"): If moldMax = 0 Then moldMax = FindValueNearKey(lines, "Recommended mold temperature range" & vbCrLf & "Max")
    maxMelt = FindValueNearKey(lines, "最大溶融温度"): If maxMelt = 0 Then maxMelt = FindValueNearKey(lines, "Maximum melt temperature")
    maxShearS = FindValueNearKey(lines, "最大せん断応力"): If maxShearS = 0 Then maxShearS = FindValueNearKey(lines, "Maximum shear stress")
    maxShearR = FindValueNearKey(lines, "最大せん断速度"): If maxShearR = 0 Then maxShearR = FindValueNearKey(lines, "Maximum shear rate")
    
    ' Rheology
    ttrans = FindValueNearKey(lines, "Ttrans")
    viText = FindTextNearKey(lines, "VI(")
    If viText = "" Then viText = FindTextNearKey(lines, "Moldflow 粘度指数")
    
    ' Cp & k（代表点だけ抽出：比熱=80/140/200℃、熱伝導=100/150/200℃相当）
    cpline = -1: kline = -1
    For i = LBound(lines) To UBound(lines)
        If cpline = -1 Then
            If InStr(1, lines(i), "比熱データ", vbTextCompare) > 0 Or InStr(1, lines(i), "Specific heat", vbTextCompare) > 0 Then cpline = i
        End If
        If kline = -1 Then
            If InStr(1, lines(i), "熱伝導率データ", vbTextCompare) > 0 Or InStr(1, lines(i), "Thermal conductivity", vbTextCompare) > 0 Then kline = i
        End If
    Next i
    If cpline > -1 Then
        Dim t As Double, v As Double
        For i = cpline + 1 To Application.Min(cpline + 40, UBound(lines))
            If Len(Trim$(lines(i))) = 0 Then Exit For
            t = FirstNumberIn(lines(i))
            If t <> 0# Then
                v = FirstNumberIn(lines(i))
                If t <= 85 And cp80 = 0 Then cp80 = v
                If t <= 150 And cp140 = 0 Then cp140 = v
                If t <= 205 And cp200 = 0 Then cp200 = v
            End If
        Next i
    End If
    If kline > -1 Then
        Dim tk As Double, kv As Double
        For i = kline + 1 To Application.Min(kline + 40, UBound(lines))
            If Len(Trim$(lines(i))) = 0 Then Exit For
            tk = FirstNumberIn(lines(i))
            If tk <> 0# Then
                kv = FirstNumberIn(lines(i))
                If tk <= 105 And k100 = 0 Then k100 = kv
                If tk <= 155 And k150 = 0 Then k150 = kv
                If tk <= 205 And k200 = 0 Then k200 = kv
            End If
        Next i
    End If
    
    ' Append row to DB
    last = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
    If last < 2 Then last = 1
    ws.Cells(last + 1, 1).Resize(1, 52).Value = Array( _
        sup, grade, base, fillerType, fillerPct, ds, _
        meltRho, solidRho, _
        b5, b6, b1m, b2m, b3m, b4m, b1s, b2s, b3s, b4s, _
        "", "", _
        cp80, cp140, cp200, _
        k100, k150, k200, _
        e1, e2, nu12, nu23, g12, _
        a1, a2, _
        meltMin, meltMax, _
        moldMin, moldMax, _
        maxMelt, maxShearS, maxShearR, _
        fillerRho, _
        viText, mfr, mfrT, mfrLoad, _
        ttrans, _
        "", src)
        
    ParseOneFile = 1
End Function