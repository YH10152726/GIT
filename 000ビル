' 指定した名前のシートを安全に作成する（既存の場合は削除してから作成）
Private Function SheetCreate(name As String) As Worksheet
    On Error Resume Next
    Application.DisplayAlerts = False
    ThisWorkbook.Worksheets(name).Delete
    Application.DisplayAlerts = True
    On Error GoTo 0
    
    Set SheetCreate = ThisWorkbook.Worksheets.Add
    SheetCreate.name = name
End Function

' 結果シートの雛形を作成する
Private Sub BuildTarget(title As String, labels As Variant)
    Dim ws As Worksheet
    Set ws = SheetCreate(title)
    
    ws.Range("A1:M1").value = Array("項目（A列一致）", _
        "Gate1 値", "Gate1 合否", "Gate1 対策", _
        "Gate2 値", "Gate2 合否", "Gate2 対策", _
        "Gate3 値", "Gate3 合否", "Gate3 対策", _
        "Gate4 値", "Gate4 合否", "Gate4 対策")
    
    Dim i As Long
    For i = LBound(labels) To UBound(labels)
        ws.Cells(i + 2, 1).value = labels(i)
    Next i
    
