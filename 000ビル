    Call AddT(sld, 0.5, 0.83, 9.2, 0.3, _
              "— 面色・PMI活用による設計プロセスと体制の構築 —", 13, False, RGB(75, 85, 99))

    ' 決め台詞バー（ネイビー + ゴールドアクセント）
