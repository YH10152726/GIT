Attribute VB_Name = "SlideBuilder"
Option Explicit

' ================================================================
'  設計プロセス改革スライド生成 VBA（4枚・9方針整合版）
'  使用方法:
'    1. PowerPoint を開く
'    2. Alt+F11 → VBAエディタ
'    3. 挿入 → 標準モジュール → 本コードを全貼り付け
'    4. Alt+F8 → BuildPresentation を実行
'    5. 名前を付けて保存（.pptx）
'  ※フォントが "Yu Gothic" にない場合は FN を "Meiryo" に変更
' ================================================================

Private Const FN As String = "Yu Gothic"

' ── 単位変換 ────────────────────────────────────────────────
Private Function P(x As Double) As Single
    P = CSng(x * 72)   ' インチ → ポイント
End Function

' ── タイプバッジ色 ──────────────────────────────────────────
Private Function BadgeRGB(t As String) As Long
    Select Case t
        Case "直接": BadgeRGB = RGB(211, 47, 47)
        Case "波及": BadgeRGB = RGB(2, 119, 189)
        Case Else:   BadgeRGB = RGB(184, 134, 11)   ' 典型
    End Select
End Function

' ── 白背景設定 ──────────────────────────────────────────────
Private Sub BgWhite(sld As Slide)
    sld.FollowMasterBackground = msoFalse
    With sld.Background.Fill
        .Solid
        .ForeColor.RGB = RGB(255, 255, 255)
    End With
End Sub

' ── 既存シェイプ全削除 ──────────────────────────────────────
Private Sub ClearSlide(sld As Slide)
    Dim i As Integer
    For i = sld.Shapes.Count To 1 Step -1
        sld.Shapes(i).Delete
    Next i
End Sub

' ── ノート設定 ──────────────────────────────────────────────
Private Sub SetNotes(sld As Slide, txt As String)
    sld.NotesPage.Shapes(2).TextFrame.TextRange.Text = txt
End Sub

' ── フッター ────────────────────────────────────────────────
Private Sub AddFooter(sld As Slide, n As Integer)
    Call AddT(sld, 0.4, 5.32, 5#, 0.22, "山電 工作部 工機技術課 工設係", 9, False, RGB(100, 116, 139), 1, 1)
    Call AddT(sld, 9.2, 5.32, 0.4, 0.22, n & " / 4", 9, False, RGB(100, 116, 139), 3, 1)
End Sub

' ── スライド2〜4共通タイトルバー ─────────────────────────────
Private Sub TitleBar(sld As Slide, title As String, subtitle As String)
    Call AddR(sld, 0.4, 0.35, 0.08, 0.7, RGB(30, 58, 95))
    Call AddT(sld, 0.6, 0.3, 9#, 0.5, title, 24, True, RGB(30, 58, 95), 1, 2)
    If Len(subtitle) > 0 Then
        Call AddT(sld, 0.6, 0.78, 9#, 0.3, subtitle, 12, False, RGB(75, 85, 99))
    End If
End Sub

' ── 塗りつぶし四角形 ────────────────────────────────────────
'   lineRGB = -1 のとき枠線なし
Private Sub AddR(sld As Slide, x As Double, y As Double, w As Double, h As Double, _
                 fillRGB As Long, Optional lineRGB As Long = -1, Optional lw As Single = 0.5)
    Dim sh As Shape
    Set sh = sld.Shapes.AddShape(msoShapeRectangle, P(x), P(y), P(w), P(h))
    sh.Fill.ForeColor.RGB = fillRGB
    sh.Fill.Visible = msoTrue
    If lineRGB = -1 Then
        sh.Line.Visible = msoFalse
    Else
        sh.Line.Visible = msoTrue
        sh.Line.ForeColor.RGB = lineRGB
        sh.Line.Weight = lw
    End If
End Sub

' ── テキストボックス ─────────────────────────────────────────
'   al: 1=左(既定) 2=中央 3=右
'   va: 1=上(既定) 2=中央 3=下
Private Sub AddT(sld As Slide, x As Double, y As Double, w As Double, h As Double, _
                  txt As String, fs As Single, bld As Boolean, rgb As Long, _
                  Optional al As Integer = 1, Optional va As Integer = 1, _
                  Optional itl As Boolean = False)
    Dim tb As Shape
    Set tb = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, P(x), P(y), P(w), P(h))
    With tb.TextFrame
        .AutoSize = ppAutoSizeNone
        .WordWrap = msoTrue
        .MarginLeft = 0: .MarginRight = 0: .MarginTop = 0: .MarginBottom = 0
        Select Case va
            Case 1: .VerticalAnchor = msoAnchorTop
            Case 2: .VerticalAnchor = msoAnchorMiddle
            Case 3: .VerticalAnchor = msoAnchorBottom
        End Select
    End With
    With tb.TextFrame.TextRange
        .Text = txt
        Select Case al
            Case 1: .ParagraphFormat.Alignment = ppAlignLeft
            Case 2: .ParagraphFormat.Alignment = ppAlignCenter
            Case 3: .ParagraphFormat.Alignment = ppAlignRight
        End Select
        With .Font
            .Name = FN: .Size = fs: .Bold = bld: .Italic = itl: .Color.RGB = rgb
        End With
    End With
End Sub

' ── 2行ラベルボックス（スライド2の第N層ラベル用） ───────────────
Private Sub AddLabelBox(sld As Slide, x As Double, y As Double, w As Double, h As Double, _
                         tagTxt As String, titleTxt As String, fillColor As Long)
    Dim sh As Shape
    Set sh = sld.Shapes.AddShape(msoShapeRectangle, P(x), P(y), P(w), P(h))
    sh.Fill.ForeColor.RGB = fillColor
    sh.Line.ForeColor.RGB = fillColor
    With sh.TextFrame
        .AutoSize = ppAutoSizeNone
        .WordWrap = msoTrue
        .VerticalAnchor = msoAnchorMiddle
        .MarginLeft = 0: .MarginRight = 0: .MarginTop = 0: .MarginBottom = 0
    End With
    With sh.TextFrame.TextRange
        .Text = tagTxt & Chr(13) & titleTxt
        .ParagraphFormat.Alignment = ppAlignCenter
        .Font.Name = FN
        .Font.Color.RGB = RGB(255, 255, 255)
        .Paragraphs(1).Font.Size = 11
        .Paragraphs(2).Font.Size = 17
        .Paragraphs(2).Font.Bold = True
    End With
End Sub

' ================================================================
'  AddBand: スライド1の方針整合バンドを追加
'  items: "タイプ","方針名","貢献内容" の3つ1組を繰り返す (2〜3組)
' ================================================================
Private Sub AddBand(sld As Slide, bandY As Double, levelName As String, _
                    levelColor As Long, ParamArray items() As Variant)
    Const BH As Double = 0.72    ' バンド高さ(インチ)
    Const LW As Double = 1.75    ' ラベル幅
    Const SX As Double = 0.4     ' 開始X
    Const IAX As Double = 2.2    ' アイテムエリア開始X
    Const IAW As Double = 7.4    ' アイテムエリア幅

    ' ─ 左ラベル ─
    Dim lb As Shape
    Set lb = sld.Shapes.AddShape(msoShapeRectangle, P(SX), P(bandY), P(LW), P(BH))
    lb.Fill.ForeColor.RGB = levelColor
    lb.Line.ForeColor.RGB = levelColor
    With lb.TextFrame
        .AutoSize = ppAutoSizeNone
        .WordWrap = msoTrue
        .VerticalAnchor = msoAnchorMiddle
        .MarginLeft = 0: .MarginRight = 0: .MarginTop = 0: .MarginBottom = 0
    End With
    With lb.TextFrame.TextRange
        .Text = levelName
        .ParagraphFormat.Alignment = ppAlignCenter
        With .Font
            .Name = FN: .Size = 11.5: .Bold = True: .Color.RGB = RGB(255, 255, 255)
        End With
    End With

    ' ─ アイテムカード群 ─
    Dim itemCount As Integer: itemCount = (UBound(items) + 1) \ 3
    Dim itemGap As Double:    itemGap = 0.1
    Dim itemW As Double:      itemW = (IAW - itemGap * (itemCount - 1)) / itemCount

    Dim j As Integer
    For j = 0 To itemCount - 1
        Dim ix As Double:   ix = IAX + j * (itemW + itemGap)
        Dim typStr As String: typStr = items(j * 3)
        Dim namStr As String: namStr = items(j * 3 + 1)
        Dim conStr As String: conStr = items(j * 3 + 2)

        ' カード背景
        Dim cd As Shape
        Set cd = sld.Shapes.AddShape(msoShapeRectangle, P(ix), P(bandY), P(itemW), P(BH))
        cd.Fill.ForeColor.RGB = RGB(248, 250, 252)
        cd.Line.Visible = msoTrue
        cd.Line.ForeColor.RGB = levelColor
        cd.Line.Weight = 0.5

        ' タイプバッジ
        Dim bg As Shape
        Set bg = sld.Shapes.AddShape(msoShapeRectangle, P(ix + 0.08), P(bandY + 0.08), P(0.42), P(0.22))
        bg.Fill.ForeColor.RGB = BadgeRGB(typStr)
        bg.Line.ForeColor.RGB = BadgeRGB(typStr)
        With bg.TextFrame
            .AutoSize = ppAutoSizeNone
            .WordWrap = msoFalse
            .VerticalAnchor = msoAnchorMiddle
            .MarginLeft = 0: .MarginRight = 0: .MarginTop = 0: .MarginBottom = 0
        End With
        With bg.TextFrame.TextRange
            .Text = typStr
            .ParagraphFormat.Alignment = ppAlignCenter
            .Font.Name = FN: .Font.Size = 9: .Font.Bold = True
            .Font.Color.RGB = RGB(255, 255, 255)
        End With

        ' 方針名
        Call AddT(sld, ix + 0.54, bandY + 0.06, itemW - 0.6, 0.27, _
                  namStr, 10.5, True, RGB(31, 41, 55), 1, 2)

        ' 貢献内容
        Call AddT(sld, ix + 0.1, bandY + 0.36, itemW - 0.2, BH - 0.4, _
                  conStr, 9.5, False, RGB(75, 85, 99), 1, 1)
    Next j
End Sub

' ================================================================
'  BuildPresentation: メイン実行 (Alt+F8 で呼び出す)
' ================================================================
Public Sub BuildPresentation()
    Dim prs As Presentation
    Set prs = Presentations.Add

    prs.PageSetup.SlideWidth  = P(10)
    prs.PageSetup.SlideHeight = P(5.625)

    ' 4枚のブランクスライドを追加
    Dim i As Integer
    For i = 1 To 4
        prs.Slides.Add i, ppLayoutBlank
    Next i

    Call BuildSlide1(prs.Slides(1))
    Call BuildSlide2(prs.Slides(2))
    Call BuildSlide3(prs.Slides(3))
    Call BuildSlide4(prs.Slides(4))

    MsgBox "4枚のスライドが完成しました。" & Chr(10) & _
           "「名前を付けて保存」→ .pptx で保存してください。", _
           vbInformation, "完了"
End Sub

