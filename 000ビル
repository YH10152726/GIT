  On Error GoTo 0
End Sub

Private Sub Finalize(ws As Worksheet, freezeCell As String)
  ws.Activate: ActiveWindow.DisplayGridlines = False
  ws.Range(freezeCell).Select: ActiveWindow.FreezePanes = True
End Sub

Public Sub CreateSkillMap()
  Dim wb As Workbook, ws1 As Worksheet, ws2 As Worksheet
  Application.ScreenUpdating = False
  InitColors
  BuildData
  Set wb = Workbooks.Add
  Application.DisplayAlerts = False
  Do While wb.Worksheets.Count > 1: wb.Worksheets(wb.Worksheets.Count).Delete: Loop
  Application.DisplayAlerts = True
  Set ws1 = wb.Worksheets(1): ws1.Name = "要求スキル"
  Set ws2 = wb.Worksheets.Add(After:=ws1): ws2.Name = "スキル詳細"
  ws1.Cells.Font.Name = "Meiryo": ws2.Cells.Font.Name = "Meiryo"
  BuildSheet1 ws1
  BuildSheet2 ws2
  Finalize ws1, "C7"
  Finalize ws2, "E8"
  ws1.Activate: ws1.Range("A1").Select
  Application.ScreenUpdating = True
  MsgBox "金型設計者スキルマップ（2シート）を作成しました。", vbInformation
End Sub
