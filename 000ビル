  if(S.modal==='saveCfm')h+='<div class="modal-bg'+bgAnim+'"><div class="cfm-modal modal'+boxAnim+'"><div class="icon">✅</div><h3>集計を確定して保存しますか？</h3><p>現在の集計内容をその日の最終データとして確定保存し、不要な同日の履歴を整理（削除）します。<br>※タイマーも同時に終了します。</p><div class="cfm-btns"><button class="btn btn-cancel" onclick="S.modal=null;S.needFullRender=true;render()">キャンセル</button><button class="btn btn-primary" onclick="doSaveConfirm()">確定保存</button></div></div></div>';
  if(S.modal==='editFav'){h+='<div class="modal-bg'+bgAnim+'" style="z-index:110"><div class="modal'+boxAnim+'"><div class="modal-head"><h2>⭐ お気に入り編集</h2><button class="close-btn" onclick="S.modal=null;S.needFullRender=true;render()">✕</button></div><div class="modal-body"><div class="check-list">';TASKS.forEach(function(t){h+='<label class="check-item"><input type="checkbox" '+(S.favs.indexOf(t.id)!==-1?'checked':'')+' onchange="if(this.checked){S.favs.push(\''+t.id+'\')}else{S.favs=S.favs.filter(function(x){return x!==\''+t.id+'\'})};save();S.needFullRender=true;render()"><div><div class="ci-id">'+esc(t.id)+'</div><div class="ci-nm">'+esc(t.name)+'</div></div></label>'});h+='</div></div><div class="modal-foot"><button class="btn btn-dark" onclick="S.modal=null;S.needFullRender=true;render()">完了</button></div></div></div>'}

  if(S.modal==='settings'){
    h+='<div class="modal-bg'+bgAnim+'"><div class="modal'+boxAnim+'"><div class="modal-head"><h2>⚙️ 設定・データ管理</h2><button class="close-btn" onclick="S.modal=null;S.needFullRender=true;render()">✕</button></div>';
    h+='<div class="modal-body">';
    h+='<h3 style="font-size:13px; color:#64748b; margin-bottom:8px">💾 履歴のバックアップと復元</h3>';
    h+='<div class="backup-row"><button class="btn btn-green" onclick="downloadBackup()">💾 バックアップを保存</button><button class="btn btn-outline" onclick="triggerRestore()">📂 復元ファイルを開く</button></div>';
    h+='<p style="font-size:11px;color:#94a3b8;margin-top:6px;margin-bottom:20px">定期的にバックアップを保存しておくと、ブラウザのデータが消えた場合でも復元できます。</p>';
    h+='</div></div></div>';
  }

  if(S.modal==='preview'){
    var grid = getMonthlyGridData();
    var periodDates = getPeriod().dates;
    
    function getDayCls(idx) {
        if(idx < 4) return '';
        var ds = periodDates[idx - 4];
        if(!ds) return '';
        var d = new Date(ds);
        if(d.getDay() === 0) return ' bg-sun';
        if(d.getDay() === 6) return ' bg-sat';
        return '';
    }

    h+='<div class="modal-bg'+bgAnim+'"><div class="modal wide'+boxAnim+'"><div class="modal-head"><h2>👀 出力プレビュー</h2><button class="close-btn" onclick="S.modal=\'history\';S.needFullRender=true;render()">✕</button></div>';
    h+='<div class="modal-body" style="padding:0; overflow:auto;">';
    h+='<table class="prev-table">';
    h+='<thead><tr>';
    grid.header.forEach(function(th, cIdx){
      var cls = '';
      if(cIdx===0) cls = 'col-h';
      else if(cIdx===1) cls = 'col-o';
      else if(cIdx===2) cls = 'col-w';
      else if(cIdx===3) cls = 'col-sum';
      h+='<th class="'+cls + getDayCls(cIdx)+'">'+esc(th).replace(/\n/g, '<br>')+'</th>';
    });
    h+='</tr></thead><tbody>';
    grid.rows.forEach(function(row){
      h+='<tr>';
      if(row.length===0){
        grid.header.forEach(function(_, cIdx){
          var cls = 'sep-blank';
          if(cIdx===0) cls += ' col-h';
          else if(cIdx===1) cls += ' col-o';
          else if(cIdx===2) cls += ' col-w';
          else if(cIdx===3) cls += ' col-sum';
          h+='<td class="'+cls+'"></td>';
        });
        h+='</tr>';
        return;
      }
      row.forEach(function(tdObj, cIdx){
        var cls = '';
        if(cIdx===0) cls = 'col-h';
        else if(cIdx===1) cls = 'col-o';
        else if(cIdx===2) cls = 'col-w';
        else if(cIdx===3) cls = 'col-sum';
        else if(tdObj.val==='') cls = 'val-empty';
        else cls = 'val-num';
        h+='<td class="'+cls + getDayCls(cIdx)+'" title="コピー時: '+esc(tdObj.copy)+'">'+esc(tdObj.val)+'</td>';
      });
      h+='</tr>';
    });
    h+='</tbody></table></div>';
    h+='<div class="modal-foot"><button class="btn btn-copy" onclick="copyMonthlyGrid();S.modal=\'history\';S.needFullRender=true;render()">📋 この内容でコピーする</button></div>';
    h+='</div></div>';
  }

  if(S.modal==='history'){
    var manualH=S.history.filter(isManual);
    var autoH=S.history.filter(function(x){return!isManual(x)});
    h+='<div class="modal-bg'+bgAnim+'"><div class="modal'+boxAnim+'"><div class="modal-head"><h2>📋 過去の履歴</h2><button class="close-btn" onclick="S.modal=null;S.needFullRender=true;render()">✕</button></div>';
    h+='<div class="tabs"><button class="tab '+(S.histTab==='manual'?'on':'')+'" onclick="S.histTab=\'manual\';S.expHist=null;S.needFullRender=true;render()">手動保存</button><button class="tab '+(S.histTab==='auto'?'on':'')+'" onclick="S.histTab=\'auto\';S.expHist=null;S.needFullRender=true;render()">自動保存</button><button class="tab '+(S.histTab==='monthly'?'on':'')+'" onclick="S.histTab=\'monthly\';S.needFullRender=true;render()">月次出力</button></div>';
    h+='<div class="modal-body">';

    if(S.histTab==='manual'){
      h+='<p class="hist-desc">「確定保存」したデータです。</p>';
      h=renderHistList(manualH,h);
    }
    if(S.histTab==='auto'){
      h+='<p class="hist-desc">22時自動保存・日付変更時のデータです。</p>';
      h=renderHistList(autoH,h);
    }
    if(S.histTab==='monthly'){
      var period=getPeriod();
      h+='<div class="period-info">📅 対象期間: <strong>'+esc(period.label)+'</strong></div>';
      h+='<p class="hist-desc">出力する日にチェックを入れてください。<br>※目安として、各履歴の合計時間を右側に表示しています。</p>';
      var count=0;
      if(!S.history.length)h+='<div class="empty-box">履歴がありません</div>';
      else{h+='<div class="check-list">';
        S.history.forEach(function(hi,i){var d=hDate(hi);if(period.dates.indexOf(d)===-1)return;count++;
          var hs=getSorted(hi.records),all=hs.fx.concat(hs.cx),total=all.reduce(function(s,r){return s+r.secs},0),th=hrs(total);
          var confMark = hi.isConfirmed ? '<span style="color:#059669;margin-left:4px">✅</span>' : '';
          h+='<label class="mc-item"><input type="checkbox" '+(S.mcChecked[i]?'checked':'')+' onchange="handleMonthlyCheck(this, '+i+')"><span class="mc-date">'+esc(d)+confMark+'</span><span class="mc-label">'+esc(hi.date.substring(11))+'</span><span style="margin-left:auto;font-weight:700;color:#2563eb;font-family:monospace;font-size:14px;">'+th+'h</span></label>'});
        h+='</div>';if(!count)h+='<div class="empty-box" style="margin-top:8px">この期間の履歴はありません</div>'}
      
      var hasConfirmed = S.history.some(function(h){ return period.dates.indexOf(hDate(h))!==-1 && h.isConfirmed; });
      if(hasConfirmed){
        h+='<button class="btn btn-outline" title="月次出力のために、確定マークがついている日を全てチェックします" style="width:100%;margin-top:12px;color:#059669;border-color:#10b981;font-weight:bold" onclick="selectAllConfirmed()">✅ 確定済みの履歴を一括選択</button>';
      }
      
      var cc=Object.keys(S.mcChecked).filter(function(k){return S.mcChecked[k]}).length;
      h+='<div style="display:flex;gap:8px;margin-top:8px"><button class="btn btn-outline" style="flex:1" '+(cc===0?'disabled':'')+' onclick="S.modal=\'preview\';S.needFullRender=true;render()">👀 プレビュー</button><button class="btn btn-copy" style="flex:2" '+(cc===0?'disabled':'')+' onclick="copyMonthlyGrid()">📋 '+cc+'件をコピー</button></div>';
    }
    h+='</div></div></div>'
  }

  if(S.modal==='help'){
    h+='<div class="modal-bg'+bgAnim+'" style="z-index:110"><div class="modal'+boxAnim+'"><div class="modal-head"><h2>ⓘ アプリの使用方法</h2><button class="close-btn" onclick="S.modal=null;S.needFullRender=true;render()">✕</button></div>';
    h+='<div class="modal-body help-modal">';
    
    h+='<h3>1. 基本的な使い方（毎日の流れ）</h3><ul>';
    h+='<li><b>業務開始:</b> 画面中央の「お気に入りボタン」または「プルダウン」から行う業務を<b>押すだけで計測が始まります。</b><br><span class="help-sub">※リストにない業務を行う場合は、テキストボックス（オーダー・製品図番）に入力して「▶ 開始」を押してください。</span></li>';
    h+='<li><b>業務の切り替え:</b> 終了ボタンを押す必要はありません。新しい業務のボタンを押すだけで、前の業務が自動記録され、新しい計測が始まります。</li>';
    h+='<li><b>休憩時間の自動処理:</b> 指定の時間（12:00〜12:45 / 17:15〜17:30）になると自動的に計測が一時停止し、終わると自動で再開されます。</li>';
    h+='<li><b>一時停止と再開:</b> タイマー横のボタンで、手動での一時停止（⏸）と再開（▶）ができます。</li>';
    h+='<li><b>退社時:</b> 「📊 集計確認」から<b>「✅ 現在の集計を確定させて保存」</b>を押し、「📋 本日の記録をExcel用にコピー」して日報に貼り付けます。（確定保存するとタイマーは自動終了します）</li>';
    h+='<li class="help-highlight">💡 アプリを閉じても作動し続けます！<br><span class="help-sub">計測中にPCを閉じても裏側で時間は進みますので、常に開きっぱなしにする必要はありません。</span></li></ul>';
    
    h+='<h3>2. 記録の修正・項目の追加・確定について</h3><ul>';
    h+='<li><b>時間の修正:</b> 押し忘れ等で時間がずれた場合は、「📊 集計確認」や「📋 履歴」画面で入力値（h）の数字を直接クリックして修正できます。（タイマーが動いたままでも修正可能です）</li>';
    h+='<li><b>項目の追加:</b> 「📋 履歴」画面で詳細を開き、下部の追加欄から「基本項目」や「オーダー・製品図番」を追加できます。</li>';
    h+='<li><b>1日の記録の確定:</b> 履歴画面で「✅ この内容で1日の記録を確定する」を押すと、その日の最終データとして確定され、不要な重複データが整理されます。確定後も修正や追加は可能です。</li></ul>';
    
    h+='<h3>3. 月次出力とバックアップについて</h3><ul>';
    h+='<li><b>月次出力:</b> 履歴の「月次出力」タブから指定期間（前月26日〜当月25日）をまとめてコピーできます。<br><b>「✅ 確定済みの履歴を一括選択」</b>ボタンを使うと、日々の確定データだけを自動選択できて提出時に便利です。</li>';
    h+='<li><b>プレビュー機能:</b> 出力前に「👀 プレビュー」ボタンで、Excel貼り付け時のイメージや合計時間を確認できます。</li>';
    h+='<li><b>データのバックアップ:</b> PC変更時などに備え、「⚙️ 設定」から定期的にバックアップファイルを保存してください。</li></ul>';
    
    h+='<h3>4. その他の仕様・注意点</h3><ul>';
    h+='<li>「朝礼・昼礼・夕礼・用足し（H001）」には、集計時に自動的に15分（0.25h）が加算されます。</li>';
    h+='<li><b>🕒 自動保存機能:</b> 毎日22:00の時点（または翌日開いた時）で未確定のデータは自動保存されます。<br><span style="color:#e11d48;font-size:12px;font-weight:bold;">※今日すでに「確定保存」を行っている場合は、自動保存はスキップされます。</span></li>';
    h+='<li style="color:#4f46e5;font-weight:bold;">🔒 完全ローカルで作動します<br><span class="help-sub">データはご使用のブラウザ内（ローカル環境）にのみ保存され、外部サーバーとは一切通信しません。</span></li></ul>';
    
    h+='</div></div></div>';
  }

  a.innerHTML=h;
  
  if(!isNewModal && !isNewTab && !isNewPage) {
    var newMBody = document.querySelector('.modal-body');
    if(newMBody && mScrollTop > 0) newMBody.scrollTop = mScrollTop;
    if(currentScrollY > 0) window.scrollTo(0, currentScrollY);
  }
  
  lastModal = S.modal;
  lastHistTab = S.histTab;
  lastPage = S.page;
}

init();S.needFullRender=true;render();setInterval(tick,1000);
</script>
</body>
