import NXOpen
import NXOpen.Features
import NXOpen.VectorDiff

def main():
    the_session = NXOpen.Session.GetSession()
    work_part = the_session.Parts.Work
    display_part = the_session.Parts.Display

    # --- ユーザー設定パネル (明日会社で確認した番号に書き換えてください) ---
    CAVITY_COLOR = 108  # 例: キャビ面の色番号 (緑など)
    CORE_COLOR = 211    # 例: コア面の色番号 (青など)
    
    CAVITY_DRAFT_ANGLE = "1.0"
    CORE_DRAFT_ANGLE = "0.5"
    # ------------------------------------------------------------------

    all_faces = work_part.Bodies[0].GetFaces()
    
    # 面の分類
    cavity_faces = [f for f in all_faces if f.Color == CAVITY_COLOR]
    core_faces = [f for f in all_faces if f.Color == CORE_COLOR]

    def apply_draft(faces, angle_str, draw_direction_vec, is_cavity):
        if not faces:
            return

        for face in faces:
            try:
                # 1. DraftBuilderの作成
                draft_builder = work_part.Features.CreateDraftBuilder(NXOpen.Features.Feature.Null)
                draft_builder.DraftType = NXOpen.Features.DraftBuilder.DraftTypeOptions.FromEdge
                
                # 2. 抜き方向（Vector）の設定
                direction = work_part.Directions.CreateDirection(
                    face.Body, 
                    NXOpen.Vector3d(draw_direction_vec[0], draw_direction_vec[1], draw_direction_vec[2]), 
                    NXOpen.SmartSelectionManager.EntityMode.Layer
                )
                draft_builder.Direction = direction
                
                # 3. 勾配角度の設定
                draft_builder.DraftAngle.RightHandSide = angle_str
                
                # 4. 「最高地点（起点）」となるエッジの特定
                edges = face.GetEdges()
                top_edge = None
                max_z = -1e10
                
                for edge in edges:
                    bbox = edge.GetBoundingBox()
                    # bbox[1] は Max Z 座標 
                    if bbox.Max[2] > max_z:
                        max_z = bbox.Max[2]
                        top_edge = edge
                
                if top_edge:
                    # 起点エッジをコレクターに追加
                    draft_builder.ReferenceEdges.Add(top_edge)
                
                # 5. 勾配をつける対象面の追加
                draft_builder.FacesToDraft.Add(face)
                
                # 6. フィーチャの確定
                draft_builder.Commit()
                draft_builder.Destroy()
                
            except Exception as e:
                print(f"Error applying draft to face {face.Handle}: {str(e)}")

    # 実行：キャビ側 (+Z 抜き)
    apply_draft(cavity_faces, CAVITY_DRAFT_ANGLE, (0, 0, 1), True)
    
    # 実行：コア側 (-Z 抜き)
    apply_draft(core_faces, CORE_DRAFT_ANGLE, (0, 0, -1), False)

    print("Automation completed.")

if __name__ == "__main__":
    main()
