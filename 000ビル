Private Const C_AMBER As Long = 1800653       ' RGB(217, 119, 6)
Private Const C_AMBER_LT As Long = 13233407   ' RGB(254, 243, 199)
Private Const C_GREEN As Long = 4620845       ' RGB(45, 125, 70)
