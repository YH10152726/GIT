End Sub

' Arrayの入れ子（ジャグ配列）を、Rangeに書き込める2次元配列に変換する
Private Function ConvertTo2DArray(jaggedArray As Variant) As Variant
    Dim i As Long, j As Long
    Dim rows As Long, cols As Long
    Dim twoDArray() As Variant

    rows = UBound(jaggedArray) - LBound(jaggedArray) + 1
    If rows = 0 Then Exit Function ' 配列が空の場合は終了
    
    cols = UBound(jaggedArray(LBound(jaggedArray))) - LBound(jaggedArray(LBound(jaggedArray))) + 1
    
    ReDim twoDArray(1 To rows, 1 To cols)

    For i = LBound(jaggedArray) To UBound(jaggedArray)
        For j = LBound(jaggedArray(i)) To UBound(jaggedArray(i))
            twoDArray(i - LBound(jaggedArray) + 1, j - LBound(jaggedArray) + 1) = jaggedArray(i)(j)
        Next j
    Next i
    
    ConvertTo2DArray = twoDArray
End Function



