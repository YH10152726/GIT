'=====================================================================================
' 面色定義標準書（成形機能部品用）Rev.0.7  自動生成マクロ
'   工作部 工機技術課 工設係  【試行版】
'-------------------------------------------------------------------------------------
' ■ 使い方（会社PC）
'   1) Excel（またはWord）を開き、Alt+F11 でVBEを起動
'   2) 挿入 → 標準モジュール に本ファイルの内容を貼り付け
'   3) マクロ一覧から  BuildMenshokuStandard  を実行
'   → Wordが起動し、本標準書を新規文書として生成します（参照設定の変更不要）
'
' ■ 特徴
'   ・Word遅延バインディング（CreateObject）なのでExcel/Wordどちらからでも実行可
'   ・第5章 面色定義表は現行カラーパレットのRGB値でセルを実着色
'   ・図例（スクリーンショット）はVBAで再現不可のためプレースホルダ枠を挿入
'
' ■ メンテ方針
'   ・各章は Ch01_〜 のSubに分離（VBAの「プロシージャが大きすぎます」回避）
'   ・表は Tbl(Array(Array(...),...)) で記述。改訂時はこの配列を編集するだけ
'   ・xxx は運用開始前に確定する項目（巻頭の確認項目一覧を参照）
'=====================================================================================
Option Explicit

'--- Word列挙定数（遅延バインディング用に自前定義：参照設定不要） -------------------
Private Const wdStyleNormal As Long = -1
Private Const wdStyleHeading1 As Long = -2
Private Const wdStyleHeading2 As Long = -3
Private Const wdStyleHeading3 As Long = -4
Private Const wdAlignParagraphLeft As Long = 0
Private Const wdAlignParagraphCenter As Long = 1
Private Const wdAlignParagraphRight As Long = 2
Private Const wdStory As Long = 6
Private Const wdPaperA4 As Long = 7
Private Const wdHeaderFooterPrimary As Long = 1
Private Const wdFieldPage As Long = 33
Private Const wdFieldNumPages As Long = 26
Private Const wdAutoFitWindow As Long = 1
Private Const wdAutoFitContent As Long = 2
Private Const wdListBullet As Long = -3   ' ApplyBulletDefault相当は別処理
Private Const wdLineStyleSingle As Long = 1
Private Const wdColorAutomatic As Long = -16777216

'--- モジュール内共有オブジェクト ----------------------------------------------------
Private wdApp As Object
Private doc As Object
Private sel As Object

Private Const BODY_FONT As String = "ＭＳ Ｐ明朝"
Private Const HEAD_FONT As String = "ＭＳ Ｐゴシック"
Private Const BODY_SIZE As Single = 10.5


'=====================================================================================
' メインエントリ
'=====================================================================================
Public Sub BuildMenshokuStandard()
    On Error GoTo ErrH

    Set wdApp = CreateObject("Word.Application")
    wdApp.Visible = True
    Set doc = wdApp.Documents.Add
    Set sel = wdApp.Selection

    SetupDocument

    Ch00_TitleAndHistory
    Ch00_PreCheck
    Ch01_Purpose
    Ch02_Scope
    Ch03_Terms
    Ch04_Policy
    Ch05_ColorTable
    Ch06_ColorVsPMI
    Ch07_ProcessChecks
    Ch08_PMIRules
    Ch08b_NXJT
    Ch09_AuxConditions
    Ch09b_FlowChart
    Ch10_DesignerChecklist
    Ch10b_IssueJudge
    Ch11_ToolmakerChecklist
    Ch11b_Reject
    Ch12_OperationFlow
    Ch13_RACI_DataSet
    Ch14_Evaluation
    Ch15_Feedback
    Ch16_Materials
    Ch17_Examples
    AppendixFigures

    GoTo Done

ErrH:
    MsgBox "生成中にエラーが発生しました。" & vbCrLf & _
           "Err " & Err.Number & " : " & Err.Description, vbCritical
    On Error Resume Next
    If Not wdApp Is Nothing Then wdApp.Visible = True
    Exit Sub

Done:
    ' 先頭へカーソルを戻す
    sel.HomeKey Unit:=wdStory
    MsgBox "面色定義標準書（Rev.0.7）の生成が完了しました。" & vbCrLf & _
           "Wordで内容を確認し、図例の差し込み・xxx項目の確定を行ってください。", vbInformation
    Set sel = Nothing
    Set doc = Nothing
    Set wdApp = Nothing
End Sub


'=====================================================================================
' 文書セットアップ（用紙・余白・既定フォント・ヘッダ／フッタ）
'=====================================================================================
Private Sub SetupDocument()
    With doc.PageSetup
        .PaperSize = wdPaperA4
        .Orientation = 0                       ' 縦
        .TopMargin = wdApp.CentimetersToPoints(2#)
        .BottomMargin = wdApp.CentimetersToPoints(2#)
        .LeftMargin = wdApp.CentimetersToPoints(2#)
        .RightMargin = wdApp.CentimetersToPoints(2#)
        .HeaderDistance = wdApp.CentimetersToPoints(1.2)
        .FooterDistance = wdApp.CentimetersToPoints(1.2)
    End With

    ' 既定（標準）スタイルのフォント
    With doc.Styles(wdStyleNormal).Font
        .Name = BODY_FONT
        .NameAscii = "Century"
        .NameFarEast = BODY_FONT
        .Size = BODY_SIZE
    End With

    ' 見出しを和文ゴシックに
    Dim hs As Variant, k As Long
    For Each hs In Array(wdStyleHeading1, wdStyleHeading2, wdStyleHeading3)
        With doc.Styles(hs).Font
            .Name = HEAD_FONT
            .NameFarEast = HEAD_FONT
            .Bold = True
            .Color = RGB(31, 56, 100)
        End With
    Next hs

    ' ヘッダ
    Dim hdr As Object
    Set hdr = doc.Sections(1).Headers(wdHeaderFooterPrimary).Range
    hdr.Text = "面色定義標準書（成形機能部品用）Rev.0.7　工機技術課 工設係　【試行版】"
    hdr.Font.Size = 8
    hdr.Font.NameFarEast = HEAD_FONT
    hdr.ParagraphFormat.Alignment = wdAlignParagraphLeft
    hdr.Borders(3).LineStyle = wdLineStyleSingle    ' 下罫線

    ' フッタ（ページ番号 - n -）
    Dim ftr As Object
    Set ftr = doc.Sections(1).Footers(wdHeaderFooterPrimary).Range
    ftr.Text = "- "
    ftr.Collapse 0                                  ' wdCollapseEnd
    ftr.Fields.Add ftr, wdFieldPage
    Set ftr = doc.Sections(1).Footers(wdHeaderFooterPrimary).Range
    ftr.InsertAfter " -"
    ftr.ParagraphFormat.Alignment = wdAlignParagraphCenter
    ftr.Font.Size = 9
End Sub


'=====================================================================================
' 共通ヘルパー
'=====================================================================================
Private Sub GoEnd()
    sel.EndKey Unit:=wdStory
End Sub

' 見出し（lvl=1/2/3）
Private Sub Hdg(ByVal txt As String, Optional ByVal lvl As Long = 1)
    GoEnd
    Select Case lvl
        Case 1: sel.Style = doc.Styles(wdStyleHeading1)
        Case 2: sel.Style = doc.Styles(wdStyleHeading2)
        Case Else: sel.Style = doc.Styles(wdStyleHeading3)
    End Select
    sel.TypeText txt
    sel.TypeParagraph
    sel.Style = doc.Styles(wdStyleNormal)
End Sub

' 本文段落
Private Sub Para(ByVal txt As String, Optional ByVal sz As Single = 0)
    GoEnd
    sel.Style = doc.Styles(wdStyleNormal)
    If sz > 0 Then sel.Font.Size = sz
    sel.TypeText txt
    sel.TypeParagraph
    If sz > 0 Then sel.Font.Size = BODY_SIZE
End Sub

' 箇条書き（・始まりの簡易リスト）
Private Sub Bullet(ByVal txt As String)
    GoEnd
    sel.Style = doc.Styles(wdStyleNormal)
    sel.ParagraphFormat.LeftIndent = wdApp.CentimetersToPoints(0.6)
    sel.TypeText "・" & txt
    sel.TypeParagraph
    sel.ParagraphFormat.LeftIndent = 0
End Sub

' 注意・補足（網掛けなしの目立つ行）
Private Sub Note(ByVal txt As String)
    GoEnd
    sel.Style = doc.Styles(wdStyleNormal)
    sel.Font.Bold = True
    sel.Font.Color = RGB(192, 0, 0)
    sel.TypeText txt
    sel.Font.Bold = False
    sel.Font.Color = wdColorAutomatic
    sel.TypeParagraph
End Sub

' 空行
Private Sub Blank()
    GoEnd
    sel.TypeParagraph
End Sub

' 改ページ
Private Sub PageBreak()
    GoEnd
    sel.InsertBreak Type:=7                      ' wdPageBreak
End Sub

'--- 表生成：rows はジャグ配列 Array(Array(...row1...), Array(...row2...), ...)
'    1行目はヘッダ行として網掛け＋太字。fit:0=内容,1=ウィンドウ
Private Function Tbl(ByVal rows As Variant, _
                     Optional ByVal fit As Long = 0, _
                     Optional ByVal sz As Single = 9) As Object
    Dim nR As Long, nC As Long, i As Long, j As Long
    Dim t As Object, r As Variant
    nR = UBound(rows) + 1
    nC = UBound(rows(0)) + 1

    GoEnd
    Set t = doc.Tables.Add(sel.Range, nR, nC)
    t.Borders.InsideLineStyle = wdLineStyleSingle
    t.Borders.OutsideLineStyle = wdLineStyleSingle
    t.Range.Font.Size = sz
    t.Range.Font.NameFarEast = BODY_FONT
    t.Range.ParagraphFormat.SpaceAfter = 0
    t.Range.ParagraphFormat.SpaceBefore = 0

    For i = 0 To nR - 1
        r = rows(i)
        For j = 0 To nC - 1
            If j <= UBound(r) Then t.Cell(i + 1, j + 1).Range.Text = CStr(r(j))
        Next j
    Next i

    With t.Rows(1)
        .Range.Font.Bold = True
        .Shading.BackgroundPatternColor = RGB(217, 226, 243)
        .HeadingFormat = True
    End With

    If fit = wdAutoFitWindow Then
        t.AutoFitBehavior wdAutoFitWindow
    Else
        t.AutoFitBehavior wdAutoFitContent
        t.AutoFitBehavior wdAutoFitWindow
    End If

    Set Tbl = t
    GoEnd
    sel.TypeParagraph
End Function

'--- 図例プレースホルダ（外枠付き、グレー背景） ------------------------------------
Private Sub Fig(ByVal figNo As String, ByVal caption As String, _
                Optional ByVal note As String = "")
    Dim t As Object
    GoEnd
    Set t = doc.Tables.Add(sel.Range, 1, 1)
    t.Borders.InsideLineStyle = wdLineStyleSingle
    t.Borders.OutsideLineStyle = wdLineStyleSingle
    t.Rows(1).Height = wdApp.CentimetersToPoints(3.2)
    t.Cell(1, 1).Shading.BackgroundPatternColor = RGB(242, 242, 242)
    With t.Cell(1, 1).Range
        .ParagraphFormat.Alignment = wdAlignParagraphCenter
        .Font.Size = 9
        .Font.Color = RGB(110, 110, 110)
        .Text = "【図例貼付欄】 " & figNo & vbCrLf & caption & _
                IIf(note = "", "", vbCrLf & note)
    End With
    GoEnd
    sel.TypeParagraph
End Sub


