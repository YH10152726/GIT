    Call AddR(sld, 0.4, 1.2, 0.07, 0.55, RGB(184, 134, 11))

    ' 決め台詞テキスト
    Dim ph As Shape
    Set ph = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, P(0.55), P(1.2), P(8.9), P(0.55))
    With ph.TextFrame
        .AutoSize = ppAutoSizeNone
        .WordWrap = msoTrue
