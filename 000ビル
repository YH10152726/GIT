' ================================================================
'  Slide 2 : 現状の課題 — 3層構造
' ================================================================
Private Sub BuildSlide2(sld As Slide)
    Call ClearSlide(sld)
    Call BgWhite(sld)
    Call TitleBar(sld, "現状の課題 — 3層構造で見る本質", _
                  "表面はコスト問題、実態は事業継続と技術継承のリスク")

    Const CT As Double = 1.3    ' カード開始Y
    Const CH As Double = 1.13   ' カード高さ
    Const CG As Double = 0.07   ' カード間隔

    Dim i As Integer
    For i = 0 To 2
        Dim ly As Double: ly = CT + i * (CH + CG)
        Dim lTag As String, lTitle As String
        Dim lProblem As String, lDetail As String, lHidden As String
        Dim lFill As Long, lBg As Long

        Select Case i
            Case 0
                lTag = "第1層": lTitle = "経済損失層"
                lFill = RGB(200, 16, 46): lBg = RGB(248, 225, 230)
                lProblem = "問題① 設計費の4割が「図面作成」 (36.5万円/件)"
                lDetail  = "投影図・寸法転記・注記など、設計者の判断を要さない機械的作業"
                lHidden  = "隠れコスト：3D/2D二重管理による不整合手戻り(現状未可視化)"
            Case 1
