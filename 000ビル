Private Const FONT_NAME As String = "Yu Gothic"

' ポイント変換（1インチ = 72ポイント）
Private Function P(ByVal inches As Double) As Single
    P = inches * 72
End Function

' ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
'  メイン処理
' ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Sub Generate_ElectrodeProcess_Slides()
    Dim pres As Presentation
    Set pres = Presentations.Add(msoTrue)
    
    ' スライドサイズを16:9に設定
    With pres.PageSetup
        .SlideWidth = P(10)
        .SlideHeight = P(5.625)
    End With
    
    ' 3枚のスライドを生成
    Call BuildSlide1(pres)
    Call BuildSlide2(pres)
    Call BuildSlide3(pres)
    
    MsgBox "スライド生成完了！3枚のスライドを作成しました。", vbInformation
End Sub

' ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
'  ヘルパー関数
' ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Private Function AddRect(sld As Slide, x As Double, y As Double, w As Double, h As Double, _
                          fillColor As Long, Optional lineColor As Long = -1, Optional lineWidth As Single = 0.5) As Shape
    Dim shp As Shape
    Set shp = sld.Shapes.AddShape(msoShapeRectangle, P(x), P(y), P(w), P(h))
    With shp
        .Fill.ForeColor.RGB = fillColor
        .Fill.Solid
        If lineColor = -1 Then
            .Line.Visible = msoFalse
        Else
            .Line.ForeColor.RGB = lineColor
            .Line.Weight = lineWidth
        End If
    End With
    Set AddRect = shp
End Function

Private Function AddText(sld As Slide, txt As String, x As Double, y As Double, w As Double, h As Double, _
                         Optional fontSize As Single = 10.5, Optional fontColor As Long = -1, _
                         Optional bold As Boolean = False, Optional italic As Boolean = False, _
                         Optional hAlign As Long = 1, Optional vAlign As Long = 5) As Shape
    Dim shp As Shape
    Set shp = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, P(x), P(y), P(w), P(h))
    With shp.TextFrame
        .TextRange.Text = txt
        .TextRange.Font.Name = FONT_NAME
        .TextRange.Font.Size = fontSize
        If fontColor <> -1 Then .TextRange.Font.Color.RGB = fontColor
        .TextRange.Font.Bold = bold
        .TextRange.Font.Italic = italic
        .TextRange.ParagraphFormat.Alignment = hAlign  ' 1=左, 2=中央, 3=右
        .VerticalAnchor = vAlign  ' 1=上, 3=中央, 5=下
        .MarginLeft = 0
        .MarginRight = 0
        .MarginTop = 0
        .MarginBottom = 0
        .WordWrap = msoTrue
    End With
    Set AddText = shp
End Function

Private Sub AddFooter(sld As Slide, pageNum As Integer)
    Call AddText(sld, "山電 工作部 工機技術課 工設係", 0.4, 5.32, 5, 0.22, 9, C_MUTED)
    Call AddText(sld, pageNum & " / 3", 9.2, 5.32, 0.4, 0.22, 9, C_MUTED, , , 3)
End Sub

Private Sub AddTitleBar(sld As Slide, title As String, Optional subtitle As String = "")
    Call AddRect(sld, 0, 0, 0.18, 5.625, C_NAVY)
    Call AddText(sld, title, 0.48, 0.22, 9.2, 0.56, 24, C_NAVY, True)
    If subtitle <> "" Then
        Call AddText(sld, subtitle, 0.48, 0.76, 9.2, 0.27, 11, C_TEXT_LT)
    End If
End Sub

Private Sub AddSectionLabel(sld As Slide, x As Double, y As Double, w As Double, h As Double, txt As String, bgColor As Long)
    Call AddRect(sld, x, y, w, h, bgColor)
    Call AddText(sld, txt, x, y, w, h, 10, C_WHITE, True, , 2, 3)
End Sub

Private Sub AddKPICard(sld As Slide, x As Double, y As Double, w As Double, h As Double, _
                       val As String, lbl As String, subTxt As String, cardColor As Long, _
                       Optional isBig As Boolean = False)
    Call AddRect(sld, x, y, w, h, C_CARD_BG, cardColor, 1.2)
    Call AddRect(sld, x, y, w, 0.1, cardColor)
    
    If isBig Then
        Call AddRect(sld, x, y, w, 0.14, cardColor)
        Call AddText(sld, val, x, y + 0.14, w, 0.5, 30, cardColor, True, , 2, 3)
        Call AddText(sld, lbl, x + 0.07, y + 0.66, w - 0.14, 0.25, 11, C_TEXT, True, , 2)
        Call AddText(sld, subTxt, x + 0.07, y + 0.9, w - 0.14, 0.22, 9, C_MUTED, , , 2)
    Else
        Call AddText(sld, val, x, y + 0.14, w, 0.5, 26, cardColor, True, , 2, 3)
        Call AddText(sld, lbl, x + 0.07, y + 0.66, w - 0.14, 0.25, 10.5, C_TEXT, True, , 2)
        Call AddText(sld, subTxt, x + 0.07, y + 0.9, w - 0.14, 0.22, 9, C_MUTED, , , 2)
    End If
End Sub

Private Sub AddTypeBadge(sld As Slide, x As Double, y As Double, badgeType As String)
    Dim badgeColor As Long
    Select Case badgeType
        Case "直接": badgeColor = C_RED_BADGE
        Case "波及": badgeColor = C_BLUE_BADGE
        Case "典型": badgeColor = C_GOLD_BADGE
    End Select
    Call AddRect(sld, x, y, 0.42, 0.2, badgeColor)
    Call AddText(sld, badgeType, x, y, 0.42, 0.2, 8.5, C_WHITE, True, , 2, 3)
End Sub

