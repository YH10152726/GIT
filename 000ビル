'  Slide 2: 解決策
' ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Private Sub BuildSlide2(pres As Presentation)
    Dim sld As Slide
    Set sld = pres.Slides.Add(2, ppLayoutBlank)
    sld.FollowMasterBackground = msoFalse
    sld.Background.Fill.ForeColor.RGB = C_WHITE
    
    Call AddTitleBar(sld, "解決策 — NX-Open半自動化による電極設計の業務移管", _
                     "自動化でモデリングのハードルを下げ、型工の加工ノウハウを設計に組み込む")
    
    Dim contY As Double: contY = 1.08
    
    ' 左列：BEFORE
    Dim LX As Double: LX = 0.38
    Dim LW As Double: LW = 2.6
    Call AddSectionLabel(sld, LX, contY, LW, 0.28, "BEFORE（現行フロー）", C_MUTED)
    
    Dim by As Double: by = contY + 0.34
    Dim BSH As Double: BSH = 0.52
    Dim i As Integer
    
    For i = 1 To 6
        Dim stepColor As Long, stepLtColor As Long, stepFlag As Boolean
        Dim stepText As String
        
        Select Case i
            Case 1: stepText = "① 金型設計完了": stepColor = C_NAVY: stepLtColor = C_BLUE_LT: stepFlag = False
            Case 2: stepText = "② 電極設計（工設）": stepColor = C_RED: stepLtColor = C_RED_LT: stepFlag = True
            Case 3: stepText = "③ 照査・検印（待ち）": stepColor = C_AMBER: stepLtColor = C_AMBER_LT: stepFlag = True
            Case 4: stepText = "④ 型工確認・差し戻し": stepColor = C_RED: stepLtColor = C_RED_LT: stepFlag = True
            Case 5: stepText = "⑤ 再設計（工設）": stepColor = C_RED: stepLtColor = C_RED_LT: stepFlag = True
            Case 6: stepText = "⑥ 電極製作開始": stepColor = C_MUTED: stepLtColor = C_MUTED_LT: stepFlag = False
        End Select
        
        Call AddRect(sld, LX, by, LW, BSH, stepLtColor, stepColor, 0.6)
        If stepFlag Then Call AddRect(sld, LX, by, 0.07, BSH, stepColor)
        Call AddText(sld, stepText, LX + IIf(stepFlag, 0.13, 0.1), by, LW - 0.2, BSH, 10.5, stepColor, stepFlag, , 1, 3)
        by = by + BSH
        If i < 6 Then
            Call AddText(sld, "↓", LX, by, LW, 0.07, 8, C_BORDER_DK, , , 2)
            by = by + 0.07
        End If
    Next i
    
    Call AddRect(sld, LX, by + 0.05, LW, 0.45, C_RED_LT, C_RED, 0.5)
    Call AddText(sld, "設計完了〜製作開始：3〜6日" & vbCrLf & "工設消費：20h + 手戻り", _
                 LX + 0.08, by + 0.06, LW - 0.16, 0.43, 9.5, C_RED, True, , 2)
    
    ' 中央列：半自動化の構造
    Dim CX As Double: CX = 3.1
    Dim CW As Double: CW = 3.82
    Call AddSectionLabel(sld, CX, contY, CW, 0.28, "NX-Open半自動化の構造", C_NAVY)
    
    ' 自動化ボックス
    Call AddRect(sld, CX, contY + 0.34, CW, 1.2, C_BLUE_LT, C_NAVY, 0.75)
    Call AddRect(sld, CX, contY + 0.34, CW, 0.26, C_NAVY)
    Call AddText(sld, "自動化がカバーする領域", CX, contY + 0.34, CW, 0.26, 10.5, C_WHITE, True, , 2)
    Call AddText(sld, "● 電極形状の自動生成", CX + 0.15, contY + 0.65, CW - 0.3, 0.25, 10, C_NAVY)
    Call AddText(sld, "● 逃げ形状・クリアランスの自動付加", CX + 0.15, contY + 0.92, CW - 0.3, 0.25, 10, C_NAVY)
    Call AddText(sld, "● エッジ処理・コーナーR処理", CX + 0.15, contY + 1.19, CW - 0.3, 0.25, 10, C_NAVY)
    
    ' 型工ボックス
    Call AddRect(sld, CX, contY + 1.62, CW, 1.2, C_GREEN_LT, C_GREEN, 0.75)
    Call AddRect(sld, CX, contY + 1.62, CW, 0.26, C_GREEN)
    Call AddText(sld, "型工が担う役割（加工ノウハウを発揮）", CX, contY + 1.62, CW, 0.26, 10.5, C_WHITE, True, , 2)
    Call AddText(sld, "● 加工性の微調整（削れる・削れない判断）", CX + 0.15, contY + 1.93, CW - 0.3, 0.25, 10, C_GREEN)
    Call AddText(sld, "● 干渉回避・段取りのしやすさ最適化", CX + 0.15, contY + 2.2, CW - 0.3, 0.25, 10, C_GREEN)
    Call AddText(sld, "● 優先順位に応じた製作順序の決定", CX + 0.15, contY + 2.47, CW - 0.3, 0.25, 10, C_GREEN)
    
    ' 工設ボックス
    Call AddRect(sld, CX, contY + 2.9, CW, 0.95, C_BLUE_LT, C_BLUE, 0.75)
