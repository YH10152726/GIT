    With ph.TextFrame.TextRange
        .Text = "本活動は新技術の創出ではなく、" & _
                "山電のものづくりを次世代へ繋ぐ「仕組みと体制の創出」である"
        .ParagraphFormat.Alignment = ppAlignCenter
        .Font.Name = FN: .Font.Color.RGB = RGB(255, 255, 255): .Font.Size = 13
        ' 後半を太字 + 少し大きく
        Dim s1 As Integer: s1 = InStr(.Text, "山電")
        If s1 > 0 Then
            .Characters(s1, Len(.Text) - s1 + 1).Font.Bold = True
            .Characters(s1, Len(.Text) - s1 + 1).Font.Size = 14
