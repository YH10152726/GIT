Sub CreateElectrodePresentation()
    Dim pptPres As Presentation
    Dim pptSlide As Slide
    Dim pptShape As Shape
    Dim pptTable As Table
    Dim i As Integer, j As Integer
    
    ' 新しいプレゼンテーションを作成 (16:9サイズ)
    Set pptPres = Presentations.Add(msoTrue)
    pptPres.PageSetup.SlideSize = ppSlideSizeOnScreen16x9
    
    ' ==========================================
    ' スライド1: 電極設計プロセスの課題 — 構造的ロス
    ' ==========================================
    Set pptSlide = pptPres.Slides.Add(1, ppLayoutTitleOnly)
    pptSlide.Shapes(1).TextFrame.TextRange.Text = "電極設計プロセスの課題 — 構造的ロス"
    pptSlide.Shapes(1).TextFrame.TextRange.Font.Size = 32
    
    ' 前提条件
    Set pptShape = pptSlide.Shapes.AddTextbox(msoTextOrientationHorizontal, 30, 80, 900, 50)
    pptShape.TextFrame.TextRange.Text = "前提：年間新規金型 3件 ／ 電極 30本/金型（平均） ／ 手戻り率 約10%（3〜4本/金型）"
    pptShape.TextFrame.TextRange.Font.Size = 18
    pptShape.TextFrame.TextRange.Font.Bold = msoTrue
    
    ' なぜ業務が分かれるのか (プレス vs モールド)
    Set pptShape = pptSlide.Shapes.AddTextbox(msoTextOrientationHorizontal, 30, 130, 420, 150)
    pptShape.TextFrame.TextRange.Text = "【前提条件：なぜ業務が分かれるのか】" & vbCrLf & _
        "■ プレス電極" & vbCrLf & _
        "・主に2次元形状が主体" & vbCrLf & _
        "・現場CADスキルで対応可能（モデリングのハードルが低い）" & vbCrLf & _
        "✓ 型工が設計（現状問題なし）" & vbCrLf & vbCrLf & _
        "■ モールド電極" & vbCrLf & _
        "・金型部品が複雑な3次元曲面を持つ" & vbCrLf & _
        "・高度な3Dモデリングが必要（現場CADでは困難）" & vbCrLf & _
        "⚠ 工設が担当（課題の起点）" & vbCrLf & _
        "⇒ 形状の複雑さ（2D→3D）が業務分担の壁を作っている"
    pptShape.TextFrame.TextRange.Font.Size = 16
    
    ' 現行ワークフロー ボトルネック
    Set pptShape = pptSlide.Shapes.AddTextbox(msoTextOrientationHorizontal, 480, 130, 450, 200)
    pptShape.TextFrame.TextRange.Text = "【現行ワークフロー ボトルネック】" & vbCrLf & _
        "① 金型設計完了" & vbCrLf & _
        "↓" & vbCrLf & _
        "② 電極設計（工設） ⚠ 設計工数 20h/金型（30本 × 40分）" & vbCrLf & _
        "↓" & vbCrLf & _
        "③ 照査・検印 / 出図 ⚠ 型工は出図待ちで着手不可" & vbCrLf & _
        "↓" & vbCrLf & _
        "④ 型工確認 → 差し戻し ⚠ 手戻り率 約10%（3〜4本/金型）" & vbCrLf & _
        "↓" & vbCrLf & _
        "⑤ 電極製作開始"
    pptShape.TextFrame.TextRange.Font.Size = 16
    
    ' 課題の定量化
    Set pptShape = pptSlide.Shapes.AddTextbox(msoTextOrientationHorizontal, 30, 360, 900, 100)
    pptShape.TextFrame.TextRange.Text = "【課題の定量化（年間3金型）】" & vbCrLf & _
        "・工設設計工数: 60h （20h/金型 × 3件）" & vbCrLf & _
        "・手戻り再設計: 10件 （3.5件/金型 × 3件）" & vbCrLf & _
        "・型工の出図待ち: 7.5日 （2.5日/金型 × 3件）" & vbCrLf & _
        "・直接コストロス: 40万円 （60h × 6,650円/h）"
    pptShape.TextFrame.TextRange.Font.Size = 18
    
    ' ==========================================
    ' スライド2: 解決策 — NX-Open自動化による電極設計の業務移管
    ' ==========================================
    Set pptSlide = pptPres.Slides.Add(2, ppLayoutTitleOnly)
    pptSlide.Shapes(1).TextFrame.TextRange.Text = "解決策 — NX-Open自動化による電極設計の業務移管"
    pptSlide.Shapes(1).TextFrame.TextRange.Font.Size = 32
    
    Set pptShape = pptSlide.Shapes.AddTextbox(msoTextOrientationHorizontal, 30, 80, 900, 30)
    pptShape.TextFrame.TextRange.Text = "自動化でモデリングのハードルを下げ、型工の加工ノウハウを設計に組み込む"
    pptShape.TextFrame.TextRange.Font.Size = 18
    pptShape.TextFrame.TextRange.Font.Bold = msoTrue
    
    ' フロー比較
    Set pptShape = pptSlide.Shapes.AddTextbox(msoTextOrientationHorizontal, 30, 130, 420, 250)
    pptShape.TextFrame.TextRange.Text = "【BEFORE（現行フロー）】" & vbCrLf & _
        "① 金型設計完了" & vbCrLf & _
        "↓" & vbCrLf & _
        "② 電極設計（工設）" & vbCrLf & _
        "↓" & vbCrLf & _
        "③ 照査・検印（待ち）" & vbCrLf & _
        "↓" & vbCrLf & _
        "④ 型工確認・差し戻し" & vbCrLf & _
        "↓" & vbCrLf & _
        "⑤ 再設計（工設）" & vbCrLf & _
        "↓" & vbCrLf & _
        "⑥ 電極製作開始" & vbCrLf & _
        "⇒ 設計完了〜製作開始：3〜6日 / 工設消費：20h + 手戻り"
    pptShape.TextFrame.TextRange.Font.Size = 16
    
    Set pptShape = pptSlide.Shapes.AddTextbox(msoTextOrientationHorizontal, 480, 130, 450, 200)
    pptShape.TextFrame.TextRange.Text = "【AFTER（自動化・移管後）】" & vbCrLf & _
        "① 金型設計完了" & vbCrLf & _
        "↓" & vbCrLf & _
        "② 即時出図（金型のみ）" & vbCrLf & _
        "↓" & vbCrLf & _
        "③ 型工：自動生成＋微調整" & vbCrLf & _
        "↓" & vbCrLf & _
        "④ 即座に電極製作開始" & vbCrLf & vbCrLf & _
        "【削減効果（vs 現行）】" & vbCrLf & _
        "✓ 工設工数 20h → 0h" & vbCrLf & _
        "✓ 手戻り 3-4件 → 0件" & vbCrLf & _
        "✓ 出図待ち 2～3日 → 0日"
    pptShape.TextFrame.TextRange.Font.Size = 16
    
    ' NX-Open自動化の構造
    Set pptShape = pptSlide.Shapes.AddTextbox(msoTextOrientationHorizontal, 30, 360, 900, 150)
    pptShape.TextFrame.TextRange.Text = "【NX-Open自動化の構造：型工の加工ノウハウが設計を決める — 現場完結型プロセスへ】" & vbCrLf & _
        "■ 自動化がカバーする領域：電極形状の自動生成 / 逃げ形状・クリアランスの自動付加 / 電極設計基準" & vbCrLf & _
        "■ 型工が担う役割：加工性の微調整 / 干渉回避・段取りのしやすさ最適化 / 製作順序の決定" & vbCrLf & _
        "■ 工設の新しい役割：NX-Openシステムの保守・改善 / 電極設計基準書の作成・改訂（標準化）"
    pptShape.TextFrame.TextRange.Font.Size = 16
    
    ' ==========================================
    ' スライド3: 効果と工設方針との整合
    ' ==========================================
    Set pptSlide = pptPres.Slides.Add(3, ppLayoutTitleOnly)
    pptSlide.Shapes(1).TextFrame.TextRange.Text = "効果と工設方針との整合 / 削減効果の内訳"
    pptSlide.Shapes(1).TextFrame.TextRange.Font.Size = 32
    
    Set pptShape = pptSlide.Shapes.AddTextbox(msoTextOrientationHorizontal, 30, 80, 900, 30)
    pptShape.TextFrame.TextRange.Text = "年間3件の新規金型（1金型600万円）での試算"
    pptShape.TextFrame.TextRange.Font.Size = 18
    
    ' 表の作成 (5行3列)
    Set pptShape = pptSlide.Shapes.AddTable(5, 3, 30, 120, 900, 150)
    Set pptTable = pptShape.Table
    
    ' 表のヘッダー
    pptTable.Cell(1, 1).Shape.TextFrame.TextRange.Text = "項目"
    pptTable.Cell(1, 2).Shape.TextFrame.TextRange.Text = "工数変化"
    pptTable.Cell(1, 3).Shape.TextFrame.TextRange.Text = "金額換算"
    
    ' 表のデータ
    pptTable.Cell(2, 1).Shape.TextFrame.TextRange.Text = "工設 電極設計（移管）"
    pptTable.Cell(2, 2).Shape.TextFrame.TextRange.Text = "▲ 60 h/年"
    pptTable.Cell(2, 3).Shape.TextFrame.TextRange.Text = "▲ 40万円"
    
    pptTable.Cell(3, 1).Shape.TextFrame.TextRange.Text = "工設 手戻り工数（根絶）"
    pptTable.Cell(3, 2).Shape.TextFrame.TextRange.Text = "▲ 10 h/年"
    pptTable.Cell(3, 3).Shape.TextFrame.TextRange.Text = "▲ 6.7 万円"
    
    pptTable.Cell(4, 1).Shape.TextFrame.TextRange.Text = "型工 電極設計（増加）"
    pptTable.Cell(4, 2).Shape.TextFrame.TextRange.Text = "＋ 22.5 h/年"
    pptTable.Cell(4, 3).Shape.TextFrame.TextRange.Text = "＋ 11.3 万円"
    
    pptTable.Cell(5, 1).Shape.TextFrame.TextRange.Text = "正味削減効果（工設▲ − 型工＋）"
    pptTable.Cell(5, 2).Shape.TextFrame.TextRange.Text = "▲ 47.5 h/年"
    pptTable.Cell(5, 3).Shape.TextFrame.TextRange.Text = "▲ 35.4 万円/年"
    
    ' 表のフォントサイズ調整
    For i = 1 To 5
        For j = 1 To 3
            pptTable.Cell(i, j).Shape.TextFrame.TextRange.Font.Size = 14
        Next j
    Next i
    
    ' 補足テキスト
    Set pptShape = pptSlide.Shapes.AddTextbox(msoTextOrientationHorizontal, 30, 280, 900, 50)
    pptShape.TextFrame.TextRange.Text = "金型費用比削減率（一型当たり）：11.8万円 ÷ 600万円 = ▲ 2.0 %" & vbCrLf & _
                                        "* 工数単価：工設 6,650円/h ／ 型工 5,000円/h（推定）"
    pptShape.TextFrame.TextRange.Font.Size = 14
    
    ' 工設の方針体系との整合
    Set pptShape = pptSlide.Shapes.AddTextbox(msoTextOrientationHorizontal, 30, 350, 900, 150)
    pptShape.TextFrame.TextRange.Text = "【工設の方針体系との整合 — 提案のメリット】" & vbCrLf & _
        "・定型作業のシステム化・自動化：NX-Openによる自動化で電極形状を自動生成" & vbCrLf & _
        "・コスト追及・ペーパーレス化：工設60h回収・手戻り根絶による再出図なし" & vbCrLf & _
        "・ナレッジ継承＋基準類見直し：設計ノウハウ → 電極設計基準書・自動化仕様書として形式知化" & vbCrLf & _
        "・行動指針「ささえる」「つながる」：型工主体で工設がシステムで支援する体制" & vbCrLf & _
        "⇒ 工設の解放枠：+高度設計へ (CAE・構造設計に注力)"
    pptShape.TextFrame.TextRange.Font.Size = 16
    
    MsgBox "スライドの生成が完了しました。", vbInformation
End Sub
