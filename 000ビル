            gg = (c \ &H100&) And &HFF&
            bb = (c \ &H10000) And &HFF&
            lum = 0.299 * rr + 0.587 * gg + 0.114 * bb
            If lum < 140 Then t.Cell(i + 2, 5).Range.Font.Color = RGB(255, 255, 255)
        End If
