Option Explicit

Sub CountAndFillParameters()
    Dim ws As Worksheet
    Dim sheetNames As Variant
    Dim sName As Variant
    Dim i As Long
    Dim colPartNo As String, colName As String, colQty As String
    
    ' --- 集計用変数の定義 ---
    Dim cntEPin As Double       ' Eピン本数
    Dim cntORing As Double      ' Oリング個数
    Dim cntCavity As Double     ' キャビ部品個数
    Dim cntCore As Double       ' コア部品個数
    Dim cntPurchase As Double   ' 購入品個数
    Dim cntSlide As Double      ' スライド個数
    Dim cntAll As Double        ' 全部品個数
    Dim cntNipple As Double     ' ニップル個数
    Dim cntBaffle As Double     ' バッフル個数
    
    ' --- 入力シート名の定義 ---
    sheetNames = Array("入力用 (1)", "入力用 (2)", "入力用 (3)")
    
    ' ==========================================
    ' 1. 3つのシートを巡回して集計
    ' ==========================================
    For Each sName In sheetNames
        ' シートが存在するかチェック
        On Error Resume Next
        Set ws = ThisWorkbook.Worksheets(sName)
        On Error GoTo 0
        
        If Not ws Is Nothing Then
            ' --- ヘッダー位置による列判定 ---
            ' B1に「品番」が含まれていればパターン1(B,C,F)、そうでなければパターン2(C,D,G)と仮定
            If InStr(ws.Range("B1").Value, "品番") > 0 Then
                colPartNo = "B"
                colName = "C"
                colQty = "F"
            Else
                colPartNo = "C"
                colName = "D"
                colQty = "G"
            End If
            
            ' --- 2行目から51行目までループ ---
            Dim pNoVal As Variant   ' 品番
            Dim pName As String     ' 品名
            Dim pQty As Double      ' 所要数
            
            For i = 2 To 51
                pNoVal = ws.Range(colPartNo & i).Value
                pName = StrConv(ws.Range(colName & i).Value, vbWide) ' 全角統一
                pName = UCase(pName) ' 大文字統一
                pQty = Val(ws.Range(colQty & i).Value) ' 空白や文字は0扱い
                
                If pQty > 0 Then
                    ' 全部品カウント
                    cntAll = cntAll + pQty
                    
                    ' --- A. 品番による分類 (数値の場合のみ) ---
                    If IsNumeric(pNoVal) And pNoVal <> "" Then
                        Dim pNo As Long
                        pNo = CLng(pNoVal)
                        
                        Select Case pNo
                            Case 1 To 199
                                cntPurchase = cntPurchase + pQty
                            Case 200 To 299
                                cntCavity = cntCavity + pQty
                            Case 300 To 399
                                cntCore = cntCore + pQty
                        End Select
                    End If
                    
                    ' --- B. 品名キーワードによる分類 ---
                    ' Eピン
                    If InStr(pName, "E-PIN") > 0 Or InStr(pName, "Ｅ－ＰＩＮ") > 0 Or InStr(pName, "Ｅピン") > 0 Then
                        cntEPin = cntEPin + pQty
                    End If
                    
                    ' Oリング
                    If InStr(pName, "O-RING") > 0 Or InStr(pName, "Ｏリング") > 0 Then
                        cntORing = cntORing + pQty
                    End If
                    
                    ' スライド関連 (スライドコア、スライドブロック等)
                    If InStr(pName, "スライド") > 0 Or InStr(pName, "アンギュラ") > 0 Then
                        cntSlide = cntSlide + pQty
                    End If
                    
                    ' ニップル
                    If InStr(pName, "ニップル") > 0 Or InStr(pName, "NIPPLE") > 0 Then
                        cntNipple = cntNipple + pQty
                    End If
                    
                    ' バッフル
                    If InStr(pName, "バッフル") > 0 Or InStr(pName, "BAFFLE") > 0 Then
                        cntBaffle = cntBaffle + pQty
                    End If
                End If
            Next i
        End If
        Set ws = Nothing
    Next sName
    
    ' ==========================================
    ' 2. 集計結果を指定セルへ出力
    ' ==========================================
    ' ※ 出力先シートがアクティブである前提です。
    ' ※ 画像の並びに合わせています。出力列は「B列」と仮定しています。
    '    必要に応じて Range("B40") などを変更してください。
    
    With ActiveSheet
        .Range("B40").Value = cntEPin       ' Eピン本数
        .Range("B41").Value = cntORing      ' Oリング個数
        .Range("B42").Value = cntCavity     ' キャビ部品個数
        .Range("B43").Value = cntCore       ' コア部品個数
        .Range("B44").Value = cntPurchase   ' 購入品個数
        .Range("B45").Value = cntSlide      ' スライド個数
        .Range("B46").Value = cntAll        ' 全部品個数
        .Range("B47").Value = cntNipple     ' ニップル個数
        .Range("B48").Value = cntBaffle     ' バッフル個数
    End With
    
    MsgBox "品目集計とパラメータ入力を完了しました。", vbInformation, "完了"

End Sub
