    public int ok_cb()
    {
        int errorCode = 0;
        try
        {
            errorCode = apply_cb();
            theSession = Session.GetSession();
            workPart = theSession.Parts.Work;

            TaggedObject[] selectedObjects = selectionFace.GetSelectedObjects();
            if (selectedObjects.Length == 0) return 0;

            List<Face> selectedFaces = new List<Face>();
            foreach (TaggedObject obj in selectedObjects)
            {
                selectedFaces.Add((Face)obj);
            }

            // --- バウンディングボックス取得 ---
            double minX = double.MaxValue, minY = double.MaxValue, minZ = double.MaxValue;
            double maxX = double.MinValue, maxY = double.MinValue, maxZ = double.MinValue;

            foreach (Face face in selectedFaces)
            {
                Edge[] edges = face.GetEdges();
                foreach (Edge edge in edges)
                {
                    Point3d pt1, pt2;
                    edge.GetVertices(out pt1, out pt2);
                    minX = Math.Min(minX, Math.Min(pt1.X, pt2.X));
                    minY = Math.Min(minY, Math.Min(pt1.Y, pt2.Y));
                    minZ = Math.Min(minZ, Math.Min(pt1.Z, pt2.Z));
                    maxX = Math.Max(maxX, Math.Max(pt1.X, pt2.X));
                    maxY = Math.Max(maxY, Math.Max(pt1.Y, pt2.Y));
                    maxZ = Math.Max(maxZ, Math.Max(pt1.Z, pt2.Z));
                }
            }

            int eType = enumElectrodeType.Value; // 0:縦, 1:横
            
            // 押し出しの方向と限界値を決定
            Vector3d extrudeDir = new Vector3d(0, 0, 1); // デフォルト+Z
            double extrudeDistance = 100.0; // 台座に十分届く距離

            if (eType == 0) {
                extrudeDir = new Vector3d(0, 0, 1); // 縦持ちは上へ
            } else {
                int hDirIndex = enumHorizontalDirection.Value; // 0:+X, 1:-X, 2:+Y, 3:-Y
                if (hDirIndex == 0) extrudeDir = new Vector3d(1, 0, 0);
                else if (hDirIndex == 1) extrudeDir = new Vector3d(-1, 0, 0);
                else if (hDirIndex == 2) extrudeDir = new Vector3d(0, 1, 0);
                else if (hDirIndex == 3) extrudeDir = new Vector3d(0, -1, 0);
            }

            // --- 1. 選択面の押し出し（先端形状ソリッドの作成） ---
            NXOpen.Session.UndoMarkId markId1 = theSession.SetUndoMark(NXOpen.Session.MarkVisibility.Visible, "電極作成");

            NXOpen.Features.Feature nullFeature = null;
            NXOpen.Features.ExtrudeBuilder extrudeBuilder = workPart.Features.CreateExtrudeBuilder(nullFeature);
            NXOpen.Section section = workPart.Sections.CreateSection(0.01, 0.01, 0.5);
            extrudeBuilder.Section = section;

            // 押し出し方向のセット
            Point3d originPoint0 = new Point3d(0, 0, 0);
            Direction direction = workPart.Directions.CreateDirection(originPoint0, extrudeDir, NXOpen.SmartObject.UpdateOption.WithinModeling);
            extrudeBuilder.Direction = direction;

            // 【修正点】食い込み代をなくし、面ピッタリ(0.0)から押し出す
            extrudeBuilder.Limits.StartExtend.Value.RightHandSide = "0.0"; 
            extrudeBuilder.Limits.EndExtend.Value.RightHandSide = extrudeDistance.ToString();

            // セクションに面を追加
            Face[] faceArray = selectedFaces.ToArray();
            EdgeBoundaryRule edgeRule = workPart.ScRuleFactory.CreateRuleEdgeBoundary(faceArray);
            SelectionIntentRule[] rules = { edgeRule };
            section.AddToSection(rules, faceArray[0], null, null, originPoint0, NXOpen.Section.Mode.Create, false);

            NXOpen.NXObject extObj = extrudeBuilder.Commit();
            BodyFeature shapeFeature = (BodyFeature)extObj;
            Body shapeBody = shapeFeature.GetBodies()[0];
            extrudeBuilder.Destroy();

            // 履歴削除
            NXOpen.Features.RemoveParametersBuilder removeBuilderS = workPart.Features.CreateRemoveParametersBuilder();
            removeBuilderS.Objects.Add(shapeBody);
            removeBuilderS.Commit();
            removeBuilderS.Destroy();

            // --- 2. 台座ブロックの作成 ---
            List<Body> blockList = new List<Body>();

            if (eType == 0)
            {
                // ========== 縦持ち ==========
                int vSizeIndex = enumVerticalSize.Value;
                double shankSize = (vSizeIndex == 0) ? 25.0 : (vSizeIndex == 1) ? 30.0 : 40.0;
                
                Point3d originShank = new Point3d();
                originShank.X = ((maxX + minX) / 2.0) - (shankSize / 2.0);
                originShank.Y = ((maxY + minY) / 2.0) - (shankSize / 2.0);
                originShank.Z = maxZ; // 加工面の最上部からさらに上へかぶせる

                string lenX = shankSize.ToString();
                string lenY = shankSize.ToString();
                string lenZ = "10.0"; // 台座の高さ

                blockList.Add(CreateBlockAndRemoveParams(originShank, lenX, lenY, lenZ));
            }
            else
            {
                // ========== 横当て ==========
                double faceHeightZ = maxZ - minZ; // 食い込み代計算を削除
                double[] sizeList = { 25.0, 30.0, 35.0, 40.0, 45.0, 50.0 };
                double autoSize = 50.0;
                foreach (double size in sizeList) {
                    if (size >= faceHeightZ) { autoSize = size; break; }
                }
                double shankSize = autoSize;
                
                double escapeLength = 1.0; 
                double faceWidthX = maxX - minX;
                double faceWidthY = maxY - minY;

                int hDirIndex = enumHorizontalDirection.Value; 

                // 逃がし用のブロック（形状と台座を繋ぐ1mmの段差部分）
                Point3d originEscape = new Point3d();
                string lenEscX="0", lenEscY="0", lenEscZ="0";
                
                // 台座ブロック
                Point3d originShank = new Point3d();
                string lenShankX="0", lenShankY="0", lenShankZ="0";

                if (hDirIndex == 0 || hDirIndex == 1) // +X, -X 逃がし
                {
                    lenEscX = escapeLength.ToString();
                    lenEscY = faceWidthY.ToString();
                    lenEscZ = autoSize.ToString();

                    lenShankX = shankSize.ToString();
                    lenShankY = shankSize.ToString();
                    lenShankZ = autoSize.ToString();

                    double centerY = (maxY + minY) / 2.0;

                    originEscape.Y = centerY - (faceWidthY / 2.0);
                    originEscape.Z = minZ; // ピッタリ合わせる
                    
                    originShank.Y = centerY - (shankSize / 2.0);
                    originShank.Z = minZ;

                    if (hDirIndex == 0) // +X
                    {
                        originEscape.X = maxX;
                        originShank.X = originEscape.X + escapeLength;
                    }
                    else // -X
                    {
                        originEscape.X = minX - escapeLength;
                        originShank.X = originEscape.X - shankSize;
                    }
                }
                else // +Y, -Y 逃がし
                {
                    lenEscX = faceWidthX.ToString();
                    lenEscY = escapeLength.ToString(); 
                    lenEscZ = autoSize.ToString();

                    lenShankX = shankSize.ToString();
                    lenShankY = shankSize.ToString();
                    lenShankZ = autoSize.ToString();

                    double centerX = (maxX + minX) / 2.0;

                    originEscape.X = centerX - (faceWidthX / 2.0);
                    originEscape.Z = minZ; // ピッタリ合わせる

                    originShank.X = centerX - (shankSize / 2.0);
                    originShank.Z = minZ;

                    if (hDirIndex == 2) // +Y
                    {
                        originEscape.Y = maxY;
                        originShank.Y = originEscape.Y + escapeLength;
                    }
                    else // -Y
                    {
                        originEscape.Y = minY - escapeLength;
                        originShank.Y = originEscape.Y - shankSize;
                    }
                }

                blockList.Add(CreateBlockAndRemoveParams(originEscape, lenEscX, lenEscY, lenEscZ));
                blockList.Add(CreateBlockAndRemoveParams(originShank, lenShankX, lenShankY, lenShankZ));
            }

            // --- 3. 押し出した先端形状と台座ブロックを結合 (Unite) ---
            NXOpen.Features.BooleanFeature nullFeatureBool = null;
            NXOpen.Features.BooleanBuilder booleanBuilderUnite = workPart.Features.CreateBooleanBuilderUsingCollector(nullFeatureBool);
            booleanBuilderUnite.Tolerance = 0.01;
            booleanBuilderUnite.Operation = NXOpen.Features.Feature.BooleanType.Unite;

            booleanBuilderUnite.Targets.Add(shapeBody);
            NXOpen.GeometricUtilities.BooleanRegionSelect regionSelectUnite = booleanBuilderUnite.BooleanRegionSelect;
            NXOpen.TaggedObject[] targetsUnite = new NXOpen.TaggedObject[1] { shapeBody };
            regionSelectUnite.AssignTargets(targetsUnite);

            NXOpen.ScCollector scCollectorUnite = workPart.ScCollectors.CreateCollector();
            NXOpen.Body[] bodiesUnite = blockList.ToArray();
            NXOpen.BodyDumbRule dumbRuleUnite = workPart.ScRuleFactory.CreateRuleBodyDumb(bodiesUnite, true);
            NXOpen.SelectionIntentRule[] rulesUnite = new NXOpen.SelectionIntentRule[1] { dumbRuleUnite };
            scCollectorUnite.ReplaceRules(rulesUnite, false);
            booleanBuilderUnite.ToolBodyCollector = scCollectorUnite;

            NXOpen.NXObject nxObjUnite = booleanBuilderUnite.Commit();
            Body electrodeBody = ((BodyFeature)nxObjUnite).GetBodies()[0];
            booleanBuilderUnite.Destroy();

            // 最終履歴削除
            NXOpen.Features.RemoveParametersBuilder removeBuilderFinal = workPart.Features.CreateRemoveParametersBuilder();
            removeBuilderFinal.Objects.Add(electrodeBody);
            removeBuilderFinal.Commit();
            removeBuilderFinal.Destroy();

        }
        catch (Exception ex)
        {
            errorCode = 1;
            theUII.NXMessageBox.Show("Block Styler", NXOpen.NXMessageBox.DialogType.Error, ex.ToString());
        }
        return errorCode;
    }
