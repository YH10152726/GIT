Option Explicit

'==================================================================
' 面色・PMI活用による3D正運用キックオフ - PPT自動生成マクロ
' 使い方:
'   1. PowerPointを起動（空のプレゼン or どこでもOK）
'   2. Alt + F11 でVBAエディタを開く
'   3. メニュー「挿入」→「標準モジュール」
'   4. ここから最後までを貼り付け
'   5. F5キー、または Sub Build_3D_Kickoff を選んで実行
'==================================================================

Public Const PT As Single = 72
Public Const FN As String = "Yu Gothic"

'================ ヘルパー関数 ================
Function H(hx As String) As Long
    H = RGB(CLng("&H" & Left$(hx, 2)), CLng("&H" & Mid$(hx, 3, 2)), CLng("&H" & Right$(hx, 2)))
End Function

Function R(sld As Slide, x As Single, y As Single, w As Single, h As Single, fillHex As String, Optional lineHex As String = "X", Optional lineW As Single = 0) As Shape
    Set R = sld.Shapes.AddShape(msoShapeRectangle, x * PT, y * PT, w * PT, h * PT)
    R.Fill.Solid
    R.Fill.ForeColor.RGB = H(fillHex)
    If lineHex = "X" Then
        R.Line.Visible = msoFalse
    Else
        R.Line.Visible = msoTrue
        R.Line.ForeColor.RGB = H(lineHex)
        R.Line.Weight = lineW
    End If
End Function

Function Ov(sld As Slide, x As Single, y As Single, w As Single, h As Single, fillHex As String) As Shape
    Set Ov = sld.Shapes.AddShape(msoShapeOval, x * PT, y * PT, w * PT, h * PT)
    Ov.Fill.Solid
    Ov.Fill.ForeColor.RGB = H(fillHex)
    Ov.Line.Visible = msoFalse
End Function

Function T(sld As Slide, x As Single, y As Single, w As Single, h As Single, txt As String, sz As Single, colHex As String, Optional bold As Boolean = False, Optional align As Integer = 1, Optional valign As Integer = 1, Optional italic As Boolean = False) As Shape
    Set T = sld.Shapes.AddTextbox(msoTextOrientationHorizontal, x * PT, y * PT, w * PT, h * PT)
    With T.TextFrame
        .MarginLeft = 2
        .MarginRight = 2
        .MarginTop = 1
        .MarginBottom = 1
        .VerticalAnchor = valign
        .WordWrap = msoTrue
    End With
    With T.TextFrame.TextRange
        .Text = txt
        .Font.Size = sz
        .Font.Color.RGB = H(colHex)
        .Font.Bold = IIf(bold, msoTrue, msoFalse)
        .Font.Italic = IIf(italic, msoTrue, msoFalse)
        .Font.Name = FN
        .ParagraphFormat.Alignment = align
    End With
End Function

Function NS(pres As Presentation, bgHex As String) As Slide
    Set NS = pres.Slides.Add(pres.Slides.Count + 1, ppLayoutBlank)
    NS.FollowMasterBackground = msoFalse
    NS.Background.Fill.Solid
    NS.Background.Fill.ForeColor.RGB = H(bgHex)
End Function

Sub SetNotes(sld As Slide, txt As String)
    On Error Resume Next
    Dim ph As Shape
    For Each ph In sld.NotesPage.Shapes
        If ph.HasTextFrame Then
            If ph.PlaceholderFormat.Type = ppPlaceholderBody Then
                ph.TextFrame.TextRange.Text = txt
                Exit Sub
            End If
        End If
    Next
End Sub

Sub HDR(sld As Slide, label As String, num As Integer, total As Integer, Optional dark As Boolean = False)
    T sld, 0.6, 0.28, 7, 0.3, label, 11, "E07A2C", True, 1, 1
    T sld, 12.3, 7.05, 1, 0.3, Format(num, "00") & " / " & Format(total, "00"), 10, IIf(dark, "F4B57A", "64748B"), False, 3, 1
End Sub

Sub TTL(sld As Slide, title As String, Optional subtitle As String = "", Optional dark As Boolean = False)
    T sld, 0.6, 0.62, 12.1, 0.7, title, 28, IIf(dark, "FFFFFF", "1E3A5F"), True, 1, 1
    If subtitle <> "" Then
        T sld, 0.6, 1.32, 12.1, 0.4, subtitle, 14, IIf(dark, "F4B57A", "1E293B"), False, 1, 1
    End If
End Sub

Sub SC(tbl As Shape, r As Integer, c As Integer, txt As String, txtCol As String, fillCol As String, Optional bold As Boolean = False, Optional align As Integer = 1, Optional sz As Single = 12)
    With tbl.Table.Cell(r, c)
        .Shape.Fill.Solid
        .Shape.Fill.ForeColor.RGB = H(fillCol)
        With .Shape.TextFrame.TextRange
            .Text = txt
            .Font.Name = FN
            .Font.Size = sz
            .Font.Color.RGB = H(txtCol)
            .Font.Bold = IIf(bold, msoTrue, msoFalse)
            .ParagraphFormat.Alignment = align
        End With
        .Shape.TextFrame.VerticalAnchor = msoAnchorMiddle
    End With
End Sub

