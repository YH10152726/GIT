        S.alert='復元完了: '+added+'件追加（重複スキップ）';S.alertType='success';S.needFullRender=true;save();render()
      }else{S.alert='ファイル形式が不正です。';S.alertType=null;S.needFullRender=true;render()}}catch(err){S.alert='読み込み失敗。';S.alertType=null;S.needFullRender=true;render()}
    };reader.readAsText(file);e.target.value=''})});

function getMonthlyGridData(){
  var period=getPeriod(),dates=period.dates,byDate={};
  S.history.forEach(function(h,i){if(S.mcChecked[i]){var d=hDate(h);byDate[d]=h.records}});
  
  var customKeys = [];
  Object.values(byDate).forEach(function(recs){
    Object.keys(recs).forEach(function(t){
      if(TORD.indexOf(t)===-1) {
        var p = parseTaskKey(t);
        var matchIndexes = [];
        for(var i=0; i<customKeys.length; i++) {
          var ep = parseTaskKey(customKeys[i]);
          if((p.col2 && p.col2 === ep.col2) || (p.col3 && p.col3 === ep.col3)) {
            matchIndexes.push(i);
          }
        }
        if(matchIndexes.length > 0) {
          var mergedO = p.col2;
          var mergedW = p.col3;
          matchIndexes.forEach(function(idx){
            var ep = parseTaskKey(customKeys[idx]);
            if(!mergedO && ep.col2) mergedO = ep.col2;
            if(!mergedW && ep.col3) mergedW = ep.col3;
          });
          var mergedKey = 'C_' + (mergedO||'') + '___' + (mergedW||'');
          for(var i=matchIndexes.length-1; i>=0; i--) {
            customKeys.splice(matchIndexes[i], 1);
          }
          if(customKeys.indexOf(mergedKey) === -1) customKeys.push(mergedKey);
        } else {
          if(customKeys.indexOf(t) === -1) customKeys.push(t);
        }
      }
    });
  });
  
  customKeys.sort();
  
  var header=['工程番号', '費用回収\nオーダー', '作業内容', '時間合計'].concat(dates.map(fmtDateCol));
  var rows=[];
  
  var startCol = colName(4);
  var endCol = colName(4 + dates.length - 1);
  var sumCol = colName(3);
  
  var rowNum = 2; 
  var totalBaseSecs = 0;
  
  TASKS.forEach(function(t){
    var formula = '=SUM(' + startCol + rowNum + ':' + endCol + rowNum + ')';
    var rowSumSecs = 0;
    var dataRow = [
      {val: t.id, copy: t.id},
      {val: '', copy: ''},
      {val: t.name, copy: t.name}
    ];
    var dateCells = [];
    dates.forEach(function(d){
      var recs=byDate[d];
      var s = 0;
      if(recs && recs[t.id]) s = recs[t.id];
      rowSumSecs += s;
      totalBaseSecs += s;
      var h = hrs(s);
      dateCells.push({val: parseFloat(h)>0?h:'', copy: parseFloat(h)>0?h:''});
    });
    dataRow.push({val: hrs(rowSumSecs), copy: formula});
    dataRow = dataRow.concat(dateCells);
    rows.push(dataRow);
    rowNum++;
  });
  
  var nonRecoveryFormula = '=SUM(' + sumCol + '2:' + sumCol + (rowNum - 1) + ')';
  var nonRecoveryRow = [
    {val: '', copy: ''},
    {val: '', copy: ''},
    {val: '非回収合計', copy: '非回収合計'},
    {val: hrs(totalBaseSecs), copy: nonRecoveryFormula}
  ];
  dates.forEach(function(d){ nonRecoveryRow.push({val: '', copy: ''}); });
  rows.push(nonRecoveryRow);
  rowNum++;
  
  rows.push([]); 
  rowNum++;
  
  customKeys.forEach(function(cid){
    var p = parseTaskKey(cid);
    var formula = '=SUM(' + startCol + rowNum + ':' + endCol + rowNum + ')';
    var rowSumSecs = 0;
    var dataRow = [
      {val: p.col1, copy: p.col1},
      {val: p.col2, copy: p.col2},
      {val: p.col3, copy: p.col3}
    ];
    var dateCells = [];
    dates.forEach(function(d){
      var recs=byDate[d];
      var s=0;
      if(recs){
        var keys = Object.keys(recs);
        for(var k=0; k<keys.length; k++) {
          var rk = keys[k];
          if(TORD.indexOf(rk) === -1) {
            var rp = parseTaskKey(rk);
            if((p.col2 && p.col2 === rp.col2) || (p.col3 && p.col3 === rp.col3)) {
              s += recs[rk] || 0;
            }
          }
        }
      }
      rowSumSecs += s;
      var h = hrs(s);
      dateCells.push({val: parseFloat(h)>0?h:'', copy: parseFloat(h)>0?h:''});
    });
    dataRow.push({val: hrs(rowSumSecs), copy: formula});
    dataRow = dataRow.concat(dateCells);
    rows.push(dataRow);
    rowNum++;
  });
  
  return {header:header, rows:rows};
}

function copyMonthlyGrid(){
  var grid = getMonthlyGridData();
  var lines = [];
  function formatCell(c) {
     if(typeof c === 'string' && c.indexOf('\n') !== -1) return '"' + c + '"';
     return c;
  }
  lines.push(grid.header.map(formatCell).join('\t'));
  grid.rows.forEach(function(row){ 
    if(row.length === 0) lines.push('');
    else lines.push(row.map(function(cell){ return formatCell(cell.copy); }).join('\t')); 
  });
  clipCopy(lines.join('\n'));
}

