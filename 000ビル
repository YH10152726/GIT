<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>工程作成支援ツール 導入効果報告（完全版）</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #E60012; /* Mitsubishi Electric Red */
            --text-color: #333333;
            --bg-color: #ffffff;
            --gray-bg: #f4f4f4;
            --accent-blue: #005eb0;
            --header-height: 60px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Noto Sans JP', sans-serif;
            background-color: #222;
            height: 100vh;
            width: 100vw;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden; /* Prevent scrollbars */
            color: var(--text-color);
        }

        /* Scale Wrapper: Holds the deck and scales it */
        #scale-wrapper {
            width: 1024px;
            height: 768px;
            display: flex;
            justify-content: center;
            align-items: center;
            /* Scaling handled by JS */
        }

        /* Slide Container */
        .deck-container {
            position: relative;
            width: 1024px;
            height: 768px;
            background-color: var(--bg-color);
            box-shadow: 0 0 50px rgba(0,0,0,0.5);
            overflow: hidden;
        }

        /* Header Style */
        .slide-header {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: var(--header-height);
            background-color: #e0e0e0;
            display: flex;
            align-items: center;
            padding: 0 40px;
            border-bottom: 2px solid #ccc;
            justify-content: space-between;
            z-index: 100;
        }

        .slide-header .page-title {
            font-size: 20px;
            font-weight: bold;
            color: #555;
            margin-left: 20px;
        }
        
        .slide-header .page-number {
            font-size: 32px;
            font-weight: bold;
            color: #333;
            width: 40px;
            text-align: center;
        }

        .confidential-badge {
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
            font-weight: bold;
            padding: 2px 10px;
            font-size: 14px;
            margin-right: 20px;
        }

        .logo-area {
            font-size: 12px;
            font-weight: bold;
            color: #333;
            text-align: right;
            line-height: 1.1;
        }

        /* Slide Content */
        .slide {
            position: absolute;
            top: var(--header-height);
            left: 0;
            width: 100%;
            height: calc(100% - var(--header-height));
            padding: 40px 60px;
            display: none;
            flex-direction: column;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
            cursor: default;
        }

        .slide.active {
            display: flex;
            opacity: 1;
            z-index: 1;
        }

        /* Typography */
        h1 {
            font-size: 36px;
            margin-bottom: 25px;
            border-left: 10px solid var(--primary-color);
            padding-left: 20px;
            color: #333;
            line-height: 1.2;
        }

        h2 {
            font-size: 28px;
            color: var(--primary-color);
            margin-bottom: 20px;
            border-bottom: 2px solid #ddd;
            padding-bottom: 5px;
        }

        p, li {
            font-size: 22px;
            line-height: 1.6;
            margin-bottom: 10px;
        }

        ul {
            list-style: none;
            padding-left: 10px;
        }

        ul li::before {
            content: "■";
            color: var(--primary-color);
            display: inline-block;
            width: 1.2em;
            margin-left: -1.2em;
        }

        .highlight {
            background: linear-gradient(transparent 70%, #fff200 70%);
            font-weight: bold;
            padding: 0 5px;
        }

        .red-text { color: var(--primary-color); font-weight: bold; }

        /* Layout Helpers */
        .two-columns {
            display: flex;
            gap: 40px;
            height: 100%;
        }
        .col { flex: 1; }

        /* Box Styles */
        .box {
            background: #f9f9f9;
            border: 1px solid #ddd;
            border-left: 5px solid var(--primary-color);
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 0 8px 8px 0;
        }
        .box-title {
            font-weight: bold;
            color: var(--primary-color);
            display: block;
            margin-bottom: 10px;
            font-size: 20px;
        }

        /* Pattern Grid */
        .pattern-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 10px;
        }
        .pattern-box {
            background: #fff;
            border: 2px solid #eee;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }
        .pattern-header {
            font-weight: bold;
            font-size: 20px;
            border-bottom: 2px solid var(--primary-color);
            margin-bottom: 10px;
            display: inline-block;
        }

        /* Tables */
        .calc-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            font-size: 18px;
        }
        .calc-table th, .calc-table td {
            border: 1px solid #ccc;
            padding: 12px;
            text-align: center;
        }
        .calc-table th {
            background-color: #f0f0f0;
            color: #333;
        }
        .calc-table tr:last-child {
            background-color: #ffe6e6;
            font-weight: bold;
            font-size: 20px;
        }

        /* Navigation Controls - Fixed Visibility */
        .controls {
            position: absolute;
            bottom: 15px; /* Moved up slightly */
            right: 20px;  /* Moved left slightly */
            z-index: 9999; /* Maximum priority */
            display: flex;
            gap: 15px;
            background-color: rgba(255, 255, 255, 0.9); /* Add background to ensure contrast */
            padding: 5px 15px;
            border-radius: 50px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }
        .btn {
            background-color: #555;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            display: flex;
            align-items: center;
            transition: background-color 0.2s;
        }
        .btn:hover { background-color: var(--primary-color); }
        .btn i { margin: 0 5px; }

        .footer-info {
            position: absolute;
            bottom: 10px;
            left: 20px;
            font-size: 12px;
            color: #999;
        }

    </style>
</head>
