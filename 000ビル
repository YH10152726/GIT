    Call AddRect(sld, LX, contY + 0.35, LW, 0.28, C_BLUE)
    Call AddText(sld, "プレス電極", LX, contY + 0.35, LW, 0.28, 11, C_WHITE, True, , 2)
    Call AddText(sld, "主に2次元形状が主体", LX + 0.1, contY + 0.67, LW - 0.2, 0.28, 11, C_TEXT)
    Call AddText(sld, "現場CADスキルで対応可能" & vbCrLf & "モデリングのハードルが低い", _
                 LX + 0.1, contY + 0.97, LW - 0.2, 0.37, 10, C_TEXT_LT)
    Call AddRect(sld, LX + 0.1, contY + 1.38, LW - 0.2, 0.18, C_GREEN)
    Call AddText(sld, "✓ 型工が設計（現状問題なし）", LX + 0.1, contY + 1.38, LW - 0.2, 0.18, 9, C_WHITE, True, , 2)
    
    ' モールド電極ブロック
    Call AddRect(sld, LX, contY + 1.68, LW, 1.35, C_AMBER_LT, C_AMBER, 0.5)
    Call AddRect(sld, LX, contY + 1.68, LW, 0.28, C_AMBER)
    Call AddText(sld, "モールド電極", LX, contY + 1.68, LW, 0.28, 11, C_WHITE, True, , 2)
    Call AddText(sld, "複雑な3次元曲面を持つ", LX + 0.1, contY + 2, LW - 0.2, 0.28, 11, C_TEXT)
    Call AddText(sld, "高度な3Dモデリングが必要" & vbCrLf & "現場CADスキルでは対応困難", _
                 LX + 0.1, contY + 2.3, LW - 0.2, 0.37, 10, C_TEXT_LT)
    Call AddRect(sld, LX + 0.1, contY + 2.72, LW - 0.2, 0.18, C_RED)
    Call AddText(sld, "⚠ 工設が担当（課題の起点）", LX + 0.1, contY + 2.72, LW - 0.2, 0.18, 9, C_WHITE, True, , 2)
    
    ' キャプション
    Call AddRect(sld, LX, contY + 3.02, LW, 0.55, C_CARD_BG, C_NAVY, 0.5)
    Call AddText(sld, "形状の複雑さ（2D→3D）が" & vbCrLf & "業務分担の壁を作っている", _
                 LX + 0.1, contY + 3.04, LW - 0.2, 0.51, 10.5, C_NAVY, True, , 2)
    
    ' 中央列：現行フロー
    Dim CX As Double: CX = 3.22
    Dim CW As Double: CW = 3.42
    Call AddSectionLabel(sld, CX, contY, CW, 0.3, "現行ワークフロー — ボトルネックの構造", C_MUTED)
    
    Dim cy As Double: cy = contY + 0.36
    Dim SH As Double: SH = 0.52
    Dim AH As Double: AH = 0.22
    
    ' ステップ1
    Call AddRect(sld, CX, cy, CW, SH, C_BLUE_LT, C_NAVY, 0.75)
    Call AddText(sld, "① 金型設計完了", CX + 0.14, cy, CW - 0.28, SH, 11.5, C_NAVY, True, , 1, 3)
    cy = cy + SH
    Call AddText(sld, "↓", CX, cy, CW, 0.1, 9, C_BORDER_DK, , , 2)
    cy = cy + 0.1
    
    ' ステップ2（問題）
    Call AddRect(sld, CX, cy, CW, SH, C_RED_LT, C_RED, 0.75)
    Call AddText(sld, "② 電極設計（工設）", CX + 0.14, cy, CW - 0.28, SH, 11.5, C_RED, True, , 1, 3)
    cy = cy + SH
    Call AddRect(sld, CX, cy, CW, AH, RGB(255, 248, 248), C_RED, 0.5)
    Call AddText(sld, "⚠  設計工数 20h/金型（30本 × 40分）", CX + 0.1, cy, CW - 0.2, AH, 9, C_RED, , True, 1, 3)
    cy = cy + AH
    Call AddText(sld, "↓", CX, cy, CW, 0.1, 9, C_BORDER_DK, , , 2)
    cy = cy + 0.1
    
    ' ステップ3（問題）
    Call AddRect(sld, CX, cy, CW, SH, C_AMBER_LT, C_AMBER, 0.75)
    Call AddText(sld, "③ 照査・検印", CX + 0.14, cy, CW - 0.28, SH, 11.5, C_AMBER, True, , 1, 3)
    cy = cy + SH
    Call AddRect(sld, CX, cy, CW, AH, RGB(255, 248, 248), C_AMBER, 0.5)
    Call AddText(sld, "⚠  型工は出図待ちで製作に着手できない", CX + 0.1, cy, CW - 0.2, AH, 9, C_AMBER, , True, 1, 3)
    cy = cy + AH
    Call AddText(sld, "↓", CX, cy, CW, 0.1, 9, C_BORDER_DK, , , 2)
    cy = cy + 0.1
    
    ' ステップ4（問題）
    Call AddRect(sld, CX, cy, CW, SH, C_RED_LT, C_RED, 0.75)
    Call AddText(sld, "④ 型工確認 → 差し戻し", CX + 0.14, cy, CW - 0.28, SH, 11.5, C_RED, True, , 1, 3)
    cy = cy + SH
    Call AddRect(sld, CX, cy, CW, AH, RGB(255, 248, 248), C_RED, 0.5)
    Call AddText(sld, "⚠  手戻り率 約10%（3〜4本/金型）", CX + 0.1, cy, CW - 0.2, AH, 9, C_RED, , True, 1, 3)
    cy = cy + AH
    Call AddText(sld, "↓", CX, cy, CW, 0.1, 9, C_BORDER_DK, , , 2)
    cy = cy + 0.1
    
    ' ステップ5
    Call AddRect(sld, CX, cy, CW, SH, C_GREEN_LT, C_GREEN, 0.75)
    Call AddText(sld, "⑤ 電極製作開始", CX + 0.14, cy, CW - 0.28, SH, 11.5, C_GREEN, True, , 1, 3)
    
    ' 右列：定量インパクト
    Dim RX As Double: RX = 6.78
    Dim RW As Double: RW = 2.82
    Call AddSectionLabel(sld, RX, contY, RW, 0.3, "課題の定量インパクト（年間3金型）", C_RED)
    
    Dim ky As Double: ky = contY + 0.36
    Dim KH As Double: KH = 0.83
    Dim KG As Double: KG = 0.09
    
    ' KPIカード4枚
    Call AddKPICard(sld, RX, ky, RW, KH, "60h", "工設設計工数（年間）", "20h/金型 × 3件", C_RED)
    ky = ky + KH + KG
    Call AddKPICard(sld, RX, ky, RW, KH, "≈10件", "手戻り再設計件数（年間）", "3.5件/金型 × 3件", C_AMBER)
    ky = ky + KH + KG
    Call AddKPICard(sld, RX, ky, RW, KH, "7.5日", "型工の出図待ち（年間）", "2.5日/金型 × 3件", C_NAVY)
    ky = ky + KH + KG
    Call AddKPICard(sld, RX, ky, RW, KH, "≈40万円", "直接コストロス（年間）", "60h × 6,650円/h", C_RED)
    
    Call AddFooter(sld, 1)
End Sub

