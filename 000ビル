Public Sub スキルマップ生成()
    Dim wbNew As Workbook
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Set wbNew = Workbooks.Add(xlWBATWorksheet)
    wbNew.Worksheets(1).Name = "要求スキル"
    wbNew.Worksheets.Add After:=wbNew.Worksheets(1)
    wbNew.Worksheets(2).Name = "スキル詳細"


    Call Layout1(wbNew.Worksheets("要求スキル"))
    Call Data1_01(wbNew.Worksheets("要求スキル"))
    Call Style1(wbNew.Worksheets("要求スキル"))
    Call Layout2(wbNew.Worksheets("スキル詳細"))
    Call Data2_01(wbNew.Worksheets("スキル詳細"))
    Call Data2_02(wbNew.Worksheets("スキル詳細"))
    Call Data2_03(wbNew.Worksheets("スキル詳細"))
    Call Data2_04(wbNew.Worksheets("スキル詳細"))
    Call Style2(wbNew.Worksheets("スキル詳細"))
    wbNew.Worksheets("要求スキル").Activate
    ActiveWindow.FreezePanes = False
    wbNew.Worksheets("要求スキル").Range("C7").Select
    ActiveWindow.FreezePanes = True
    wbNew.Worksheets("スキル詳細").Activate
    ActiveWindow.FreezePanes = False
    wbNew.Worksheets("スキル詳細").Range("E8").Select
    ActiveWindow.FreezePanes = True
    wbNew.Worksheets("要求スキル").Activate
    wbNew.Worksheets("要求スキル").Range("B2").Select
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    MsgBox "スキルマップの生成が完了しました。名前を付けて保存してください。", vbInformation
End Sub

