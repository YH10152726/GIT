Private Sub DrawBorder(ByVal rng As Range)
  Dim ed As Variant
  For Each ed In Array(xlEdgeLeft, xlEdgeTop, xlEdgeRight, xlEdgeBottom)
    With rng.Borders(ed): .LineStyle = xlContinuous: .Weight = xlThin: .Color = cBORDER: End With
  Next
End Sub

Private Sub SC(ByVal ws As Worksheet, ByVal r As Long, ByVal c As Long, ByVal v As Variant, ByVal fillC As Long, ByVal bold As Boolean, ByVal sz As Single, ByVal wrap As Boolean, ByVal hAl As Long, ByVal vAl As Long, ByVal fontC As Long, ByVal brd As Boolean)
  With ws.Cells(r, c)
    .Value = v
    .Font.Name = "Meiryo": .Font.Bold = bold: .Font.Size = sz: .Font.Color = fontC
    .HorizontalAlignment = hAl: .VerticalAlignment = vAl: .WrapText = wrap
    If fillC <> -1 Then .Interior.Color = fillC
  End With
  If brd Then DrawBorder ws.Cells(r, c)
End Sub

Private Function EstLines(ByVal t As String, ByVal wch As Long) As Long
  Dim per As Long: per = Int(wch * 0.52): If per < 6 Then per = 6
  Dim parts() As String: parts = Split(t, vbLf)
  Dim i As Long, tot As Long, ln As Long
  For i = 0 To UBound(parts)
    ln = (Len(parts(i)) + per - 1) \ per: If ln < 1 Then ln = 1: tot = tot + ln
  Next
  EstLines = tot
End Function

