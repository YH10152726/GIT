  SC ws, 2, 2, "金型設計者スキルマップ", -1, True, 18, False, xlLeft, xlCenter, 0, False
  SC ws, 3, 2, "当該業務実行に要求されるスキルを整理。原則、要求スキルを満たす人員を優先するが、要求スキルに1段階足りない場合は、上位スキル保有者のサポートをつける。", -1, False, 9, False, xlLeft, xlCenter, 0, False
  ws.Range(ws.Cells(4,2), ws.Cells(6,2)).Merge
  SC ws, 4, 2, "スキル／技術項目", cHEAD, True, 10, False, xlCenter, xlCenter, 0, True
  ws.Range(ws.Cells(4,FT+0), ws.Cells(4,FT+4)).Merge
  SC ws, 4, FT+0, "金型設計", cACT(0), True, 11, False, xlCenter, xlCenter, cWHITETX, True
  DrawBorder ws.Range(ws.Cells(4,FT+0), ws.Cells(4,FT+4))
  ws.Range(ws.Cells(4,FT+5), ws.Cells(4,FT+7)).Merge
  SC ws, 4, FT+5, "2D図面", cACT(1), True, 11, False, xlCenter, xlCenter, cWHITETX, True
  DrawBorder ws.Range(ws.Cells(4,FT+5), ws.Cells(4,FT+7))
  ws.Range(ws.Cells(4,FT+8), ws.Cells(4,FT+9)).Merge
  SC ws, 4, FT+8, "電極", cACT(2), True, 11, False, xlCenter, xlCenter, cWHITETX, True
  DrawBorder ws.Range(ws.Cells(4,FT+8), ws.Cells(4,FT+9))
  ws.Range(ws.Cells(4,FT+10), ws.Cells(4,FT+10)).Merge
  SC ws, 4, FT+10, "生産設計", cACT(3), True, 11, False, xlCenter, xlCenter, cWHITETX, True
  DrawBorder ws.Range(ws.Cells(4,FT+10), ws.Cells(4,FT+10))
  ws.Range(ws.Cells(4,FT+11), ws.Cells(4,FT+11)).Merge
  SC ws, 4, FT+11, "CAE", cACT(4), True, 11, False, xlCenter, xlCenter, cWHITETX, True
  DrawBorder ws.Range(ws.Cells(4,FT+11), ws.Cells(4,FT+11))
  ws.Range(ws.Cells(4,FT+12), ws.Cells(4,FT+12)).Merge
  SC ws, 4, FT+12, "成形トライ", cACT(5), True, 11, False, xlCenter, xlCenter, cWHITETX, True
  DrawBorder ws.Range(ws.Cells(4,FT+12), ws.Cells(4,FT+12))
  ws.Range(ws.Cells(5,FT), ws.Cells(5,FT+2)).Merge
  SC ws, 5, FT, "新作", cSUB, True, 10, False, xlCenter, xlCenter, cWHITETX, True
  DrawBorder ws.Range(ws.Cells(5,FT), ws.Cells(5,FT+2))
  For i = 0 To 2
    SC ws, 6, FT+i, mLeaf(i), cHEAD, True, 9, True, xlCenter, xlCenter, 0, True
  Next
  For i = 3 To 12
    ws.Range(ws.Cells(5,FT+i), ws.Cells(6,FT+i)).Merge
    SC ws, 5, FT+i, mLeaf(i), cHEAD, True, 9, True, xlCenter, xlCenter, 0, True
  Next
  ws.Rows(4).RowHeight = 20: ws.Rows(5).RowHeight = 20: ws.Rows(6).RowHeight = 30
  r = 7
  Dim prevKind As String: prevKind = ""
  Dim prevSub As String: prevSub = ""
  For k = 0 To UBound(ordr)
    no = ordr(k)
    If mKind(no) <> prevKind Then
      ws.Range(ws.Cells(r,2), ws.Cells(r,LC)).Merge
      Dim lab As String, fc As Long
      If mKind(no)="common" Then
        lab="【設計基盤】金型設計の全業務で共通に要求される": fc=cBAND
      ElseIf mKind(no)="upper" Then
        lab="【構造対応】特定構造を含む型で追加要求される": fc=cUPBAND
      Else
        lab="【業務別実行】特定の業務で固有に要求される実行スキル": fc=cEXPERTBAND
      End If
      SC ws, r, 2, lab, fc, True, 10, False, xlLeft, xlCenter, cWHITETX, True
      DrawBorder ws.Range(ws.Cells(r,2), ws.Cells(r,LC))
      ws.Rows(r).RowHeight = 18: r = r + 1
      prevKind = mKind(no): prevSub = ""
    End If
    If mSub(no) <> prevSub Then
      ws.Range(ws.Cells(r,2), ws.Cells(r,LC)).Merge
      SC ws, r, 2, mSub(no), cSUB, True, 9.5, False, xlLeft, xlCenter, cWHITETX, True
      DrawBorder ws.Range(ws.Cells(r,2), ws.Cells(r,LC))
      ws.Rows(r).RowHeight = 16: r = r + 1
      prevSub = mSub(no)
    End If
    SC ws, r, 2, no & ". " & mName(no), cSKILL, False, 8.5, False, xlLeft, xlCenter, 0, True
    For i = 0 To 12
      Dim fl As Long
      If mReq(no)(i) = 1 Then fl = cWHITE Else fl = cGRAY
      SC ws, r, FT+i, "", fl, True, 9.5, False, xlCenter, xlCenter, 0, True
    Next
    ws.Rows(r).RowHeight = 16: r = r + 1
  Next
  Dim gR As Long, eR As Long, hR As Long
  gR = r: eR = r+1: hR = r+2
  SC ws, gR, 2, "目標（到達年次）", cBOTTOM, True, 9.5, False, xlLeft, xlCenter, 0, True
  SC ws, eR, 2, "必要経験（昇格要件）", cBOTTOM, True, 9.5, False, xlLeft, xlCenter, 0, True
