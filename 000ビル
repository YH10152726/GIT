    SC ws, eR, FT+i, "", -1, False, 7.5, True, xlLeft, xlTop, 0, True
    SC ws, hR, FT+i, "", cYEL, False, 10, False, xlCenter, xlCenter, 0, True
  Next
  ws.Rows(eR).RowHeight = 46
  Dim nR As Long: nR = hR + 2
  SC ws, nR, 2, "注記", -1, True, 10, False, xlLeft, xlCenter, cREDTX, False
  For i = 0 To UBound(mNotes)
    SC ws, nR+1+i, 2, mNotes(i), -1, False, 9, False, xlLeft, xlCenter, 0, False
  Next
  ws.Columns(1).ColumnWidth = 2.5: ws.Columns(2).ColumnWidth = 42
