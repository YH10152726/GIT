<script>
function copyVBA() {
  const code = document.getElementById("vbaCode").value;
  navigator.clipboard.writeText(code)
    .then(() => {
      document.getElementById("status").innerHTML =
        '<span class="ok">✅ コピーしました！PowerPoint の VBA エディタに貼り付けて F5 で実行してください。</span>';
    })
    .catch(() => {
      const el = document.getElementById("vbaCode");
      el.select();
      document.execCommand("copy");
      document.getElementById("status").innerHTML =
        '<span class="ok">✅ コピーしました！</span>';
    });
}
</script>
