Private Sub BuildSlide3(pres As Presentation)
    Dim sld As Slide
    Set sld = pres.Slides.Add(3, ppLayoutBlank)
    sld.FollowMasterBackground = msoFalse
    sld.Background.Fill.ForeColor.RGB = C_WHITE
    
    Call AddTitleBar(sld, "定量効果と工設の方針体系との整合", _
                     "年間3金型・1金型600万円 試算 ／ 工設▲60h・型工＋22.5h で 金型費比 ▲2.0%")
    
    ' KPI 5枚
    Dim KW As Double: KW = 1.78
    Dim KH As Double: KH = 1.22
    Dim KGP As Double: KGP = 0.1
    Dim kStartX As Double: kStartX = (10 - (KW * 5 + KGP * 4)) / 2
    Dim i As Integer
    
    For i = 0 To 4
        Dim kx As Double: kx = kStartX + i * (KW + KGP)
        Select Case i
            Case 0: Call AddKPICard(sld, kx, 1.08, KW, KH, "▲2.0%", "金型費比削減", "1金型600万円基準", C_RED, True)
            Case 1: Call AddKPICard(sld, kx, 1.08, KW, KH, "▲36万円", "年間正味削減", "工設▲47 − 型工＋11", C_AMBER)
            Case 2: Call AddKPICard(sld, kx, 1.08, KW, KH, "▲60h", "工設工数削減", "型工へ +22.5h移管", C_BLUE)
            Case 3: Call AddKPICard(sld, kx, 1.08, KW, KH, "▲7.5日", "型工停滞解消", "出図待ち年間合計", C_NAVY)
            Case 4: Call AddKPICard(sld, kx, 1.08, KW, KH, "0件", "手戻りゼロ化", "現行 約10件/年", C_GREEN)
        End Select
    Next i
    
    ' 削減効果の内訳（左下）
    Dim breakX As Double: breakX = 0.38
    Dim breakW As Double: breakW = 4.6
    Dim breakStartY As Double: breakStartY = 2.42
    
    ' ヘッダ
    Call AddRect(sld, breakX, breakStartY, breakW, 0.28, C_RED)
    Call AddText(sld, "削減効果の内訳 — 根拠と計算（年間3金型・1金型600万円）", _
                 breakX, breakStartY, breakW, 0.28, 10, C_WHITE, True, , 2)
    
    ' テーブルヘッダ
    Dim ty As Double: ty = breakStartY + 0.32
    Call AddRect(sld, breakX, ty, breakW, 0.24, C_CARD_BG2, C_BORDER, 0.5)
    Call AddText(sld, "項目", breakX + 0.1, ty, 2.3, 0.24, 9.5, C_NAVY, True)
    Call AddText(sld, "工数変化", breakX + 2.4, ty, 0.95, 0.24, 9.5, C_NAVY, True, , 2)
    Call AddText(sld, "金額換算", breakX + 3.35, ty, 1.25, 0.24, 9.5, C_NAVY, True, , 2)
    
    ' データ行
    ty = ty + 0.24
    Dim rowH As Double: rowH = 0.27
    Dim rowData(1 To 3, 1 To 5) As Variant
    rowData(1, 1) = C_RED: rowData(1, 2) = "工設 電極設計（移管）": rowData(1, 3) = "▲ 60 h/年": rowData(1, 4) = "▲ 40.0 万円": rowData(1, 5) = C_RED
    rowData(2, 1) = C_RED: rowData(2, 2) = "工設 手戻り工数（根絶）": rowData(2, 3) = "▲ 10 h/年": rowData(2, 4) = "▲ 6.7 万円": rowData(2, 5) = C_RED
    rowData(3, 1) = C_AMBER: rowData(3, 2) = "型工 電極設計（増加）": rowData(3, 3) = "＋ 22.5 h/年": rowData(3, 4) = "＋ 11.3 万円": rowData(3, 5) = C_AMBER
    
    For i = 1 To 3
        Call AddRect(sld, breakX, ty, breakW, rowH, IIf(i Mod 2 = 0, C_CARD_BG, C_WHITE), C_BORDER, 0.3)
        Call AddRect(sld, breakX, ty, 0.05, rowH, rowData(i, 1))
        Call AddText(sld, rowData(i, 2), breakX + 0.13, ty, 2.27, rowH, 10, C_TEXT)
        Call AddText(sld, rowData(i, 3), breakX + 2.4, ty, 0.95, rowH, 10, rowData(i, 1), True, , 2)
        Call AddText(sld, rowData(i, 4), breakX + 3.35, ty, 1.25, rowH, 10.5, rowData(i, 5), True, , 2)
        ty = ty + rowH
    Next i
    
    ' 小計行
    Call AddRect(sld, breakX, ty, breakW, 0.32, C_NAVY)
    Call AddText(sld, "正味削減効果（工設▲ − 型工＋）", breakX + 0.13, ty, 2.27, 0.32, 10, C_WHITE, True)
    Call AddText(sld, "▲ 47.5 h/年", breakX + 2.4, ty, 0.95, 0.32, 10, C_WHITE, True, , 2)
    Call AddText(sld, "▲ 36 万円/年", breakX + 3.35, ty, 1.25, 0.32, 11.5, C_WHITE, True, , 2)
    ty = ty + 0.32
    
    ' 結果バー
    ty = ty + 0.06
    Call AddRect(sld, breakX, ty, breakW, 0.46, C_RED_LT, C_RED, 1.5)
    Call AddText(sld, "金型費比削減率： 36万円 ÷ 1,800万円（600万円 × 3件）= ▲ 2.0 %", _
                 breakX + 0.1, ty, breakW - 0.2, 0.46, 10.5, C_TEXT, , , 2, 3)
    ty = ty + 0.46
    
    ' 単価注記
    Call AddText(sld, "* 工数単価：工設 6,650円/h ／ 型工 5,000円/h（推定）", _
                 breakX + 0.1, ty + 0.04, breakW - 0.2, 0.2, 8.5, C_MUTED, , True)
    
    ' 方針整合（右下）
    Dim polX As Double: polX = 5.07
    Dim polW As Double: polW = 4.55
    
    Call AddRect(sld, polX, breakStartY, polW, 0.28, C_GREEN)
    Call AddText(sld, "工設の方針体系との整合 — 提案のメリット", polX, breakStartY, polW, 0.28, 10, C_WHITE, True, , 2)
    
    Dim py As Double: py = breakStartY + 0.34
    Dim PRH As Double: PRH = 0.58
    Dim meritData(1 To 4, 1 To 3) As Variant
    meritData(1, 1) = "直接": meritData(1, 2) = "NX-Open半自動化で電極形状を自動生成": meritData(1, 3) = "定型作業のシステム化・自動化"
    meritData(2, 1) = "直接": meritData(2, 2) = "工設60h回収・手戻り根絶 ≈ 36万円/年": meritData(2, 3) = "ペーパーレス化・コスト追及"
    meritData(3, 1) = "典型": meritData(3, 2) = "設計ノウハウ → 電極設計基準書・自動化仕様書として形式知化": meritData(3, 3) = "ナレッジ継承＋基準類見直し"
    meritData(4, 1) = "典型": meritData(4, 2) = "型工主体で工設がシステムで支援する体制": meritData(4, 3) = "行動指針「ささえる」「つながる」"
    
    For i = 1 To 4
        Call AddRect(sld, polX, py, polW, PRH, IIf(i Mod 2 = 0, C_WHITE, C_CARD_BG), C_BORDER, 0.5)
        Call AddTypeBadge(sld, polX + 0.1, py + 0.05, meritData(i, 1))
        Call AddText(sld, meritData(i, 2), polX + 0.6, py + 0.04, polW - 0.7, 0.26, 10, C_TEXT, True)
        Call AddText(sld, "→ " & meritData(i, 3), polX + 0.6, py + 0.3, polW - 0.7, 0.24, 9.5, C_GREEN, , True)
        py = py + PRH + 0.05
    Next i
    
    Call AddFooter(sld, 3)
End Sub
