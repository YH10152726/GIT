<script>
var TASKS=[
  {id:'H001',name:'朝礼・昼礼・夕礼・用足し'},{id:'H002-1',name:'安全・品質(品質管理)'},{id:'H002-2',name:'小括'},
  {id:'H003',name:'JIT・掃除・設備メンテ'},{id:'H004',name:'会議（課・係内）'},{id:'H005',name:'会議（課外）製造部支援会議以外'},
  {id:'H006',name:'資料作成'},{id:'H007',name:'ｽｷﾙｱｯﾌﾟ教育(受講側)'},{id:'H008',name:'ｽｷﾙｱｯﾌﾟ教育(講師)'},
  {id:'H009',name:'進捗管理'},{id:'H010',name:'C・N管理'},{id:'H011',name:'製造部支援（生産設計）関連会議含'},
  {id:'H012',name:'製造部支援（型費見積）'},{id:'H013',name:'製造部支援（金型査定）'},{id:'H014',name:'製造部支援（原低支援）'},
  {id:'H015',name:'製造部支援（工作支援）'},{id:'H016',name:'製造部支援（開発案件）'},{id:'H017',name:'製造部支援（研修支援）'},
  {id:'H018',name:'出張'},{id:'H019',name:'TQM・技術開発（課内）'},{id:'H020',name:'設計・製品不具合'},
  {id:'H099',name:'その他'},{id:'H000',name:'未登録オーダー'}
];
var TORD=TASKS.map(function(t){return t.id});
var BRKS=[{sH:12,sM:0,eH:12,eM:45,l:'昼休憩'},{sH:17,sM:15,eH:17,eM:30,l:'残業前休憩'}];

var S={active:null,start:null,records:{},memos:{},elapsed:0,paused:null,pauseLabel:'',alert:null,
  favs:['H001','H004','H016','H019','H020','H008'],history:[],ovt:0,page:'main',
  modal:null,histTab:'manual',expHist:null,copied:false,needFullRender:true,
  mcChecked:{},confirmTarget:null};

var lastModal = null;
var lastHistTab = 'manual';
var lastPage = 'main';

function lsG(k){try{return JSON.parse(localStorage.getItem('tt_'+k))}catch(e){return null}}
function lsS(k,v){localStorage.setItem('tt_'+k,JSON.stringify(v))}
function lsR(k){localStorage.removeItem('tt_'+k)}
function r005(v){return(Math.round(v/0.05)*0.05).toFixed(2)}
function hrs(s){return r005(s/3600)}
function fmt(s){s=Math.max(0,s);var h=Math.floor(s/3600),m=Math.floor((s%3600)/60),sc=s%60;return[h,m,sc].map(function(v){return String(v).padStart(2,'0')}).join(':')}

function colName(n) {
    var ordA = 65, len = 26, s = "";
    while(n >= 0) {
        s = String.fromCharCode(n % len + ordA) + s;
        n = Math.floor(n / len) - 1;
    }
    return s;
}

function parseTaskKey(id) {
  var t = TASKS.find(function(c){return c.id===id});
  if(t) return { col1: t.id, col2: '', col3: t.name };
  if(id.startsWith('C_')) {
    var p = id.substring(2).split('___');
    return { col1: '', col2: p[0]||'', col3: p[1]||'' };
  }
  return { col1: '', col2: id, col3: '' };
}

function tLabel(id){
  var p = parseTaskKey(id);
  var nm = [];
  if(p.col1) nm.push(p.col1);
  if(p.col2) nm.push(p.col2);
  if(p.col3) nm.push(p.col3);
  return nm.join(' ') || id;
}

function getToday(){return new Date().toLocaleDateString('sv-SE')}
function getNowTime(){return new Date().toLocaleTimeString('ja-JP',{hour:'2-digit',minute:'2-digit'})}
function isManual(h){return h.date&&h.date.indexOf('保存')!==-1}
function hDate(h){return(h.date||'').substring(0,10)}
function brkB(b){var n=new Date(),s=new Date(n),e=new Date(n);s.setHours(b.sH,b.sM,0,0);e.setHours(b.eH,b.eM,0,0);return{s:s,e:e,l:b.l}}
function esc(s){var d=document.createElement('div');d.textContent=s;return d.innerHTML}
function save(){lsS('rec',S.records);lsS('memo',S.memos);S.active?lsS('act',S.active):lsR('act');S.start?lsS('st',S.start.toISOString()):lsR('st');S.paused?lsS('pau',S.paused):lsR('pau');S.pauseLabel?lsS('paL',S.pauseLabel):lsR('paL');lsS('fav',S.favs);lsS('hist',S.history);lsS('ovt',S.ovt)}
function buildCur(){var cr={},k;for(k in S.records)cr[k]=S.records[k];if(S.active&&S.start)cr[S.active]=(cr[S.active]||0)+Math.floor((new Date()-S.start)/1000);cr['H001']=(cr['H001']||0)+900;return cr}
function getSorted(recs){
  var fx=[],cx=[];
  Object.keys(recs).forEach(function(t){
    var s=recs[t];
    if(s>=0){
      var p = parseTaskKey(t);
      var e={task:t, col1: p.col1, col2: p.col2, col3: p.col3, secs:s, hours:hrs(s)};
      TORD.indexOf(t)!==-1 ? fx.push(e) : cx.push(e);
    }
  });
  fx.sort(function(a,b){return TORD.indexOf(a.task)-TORD.indexOf(b.task)});
  cx.sort(function(a,b){return b.secs-a.secs});
  return {fx:fx, cx:cx};
}

function getPeriod(){
  var now=new Date(),y=now.getFullYear(),m=now.getMonth(),d=now.getDate();
  var sY,sM,eY,eM;
  if(d>=26){
    sY=y;sM=m;
    eY=m===11?y+1:y;eM=m===11?0:m+1;
  }else{
    sY=m===0?y-1:y;sM=m===0?11:m-1;
    eY=y;eM=m;
  }
  var s=new Date(sY,sM,26),e=new Date(eY,eM,25),dates=[],c=new Date(s);
  while(c<=e){dates.push(c.toLocaleDateString('sv-SE'));c.setDate(c.getDate()+1)}
  return{dates:dates,label:(sM+1)+'/26 ～ '+(eM+1)+'/25'}
}

function fmtDateCol(ds){var p=ds.split('-');return parseInt(p[1])+'/'+parseInt(p[2])}

function findOrMergeCustomTaskKey(newO, newW, recs, memos) {
  var matchingKeys = [];
  var existingKeys = Object.keys(recs).filter(function(k){return k.startsWith('C_')});
  for(var i=0; i<existingKeys.length; i++){
    var k = existingKeys[i];
    var p = parseTaskKey(k);
    if((newO && p.col2 === newO) || (newW && p.col3 === newW)) {
      matchingKeys.push(k);
    }
  }
  
  if (matchingKeys.length > 0) {
    var mergedO = newO;
    var mergedW = newW;
    
    matchingKeys.forEach(function(k){
       var p = parseTaskKey(k);
       if(!mergedO && p.col2) mergedO = p.col2;
       if(!mergedW && p.col3) mergedW = p.col3;
    });
    
    var mergedKey = 'C_' + (mergedO||'') + '___' + (mergedW||'');
    var totalSecs = 0;
    var mergedMemos = [];
    
    matchingKeys.forEach(function(k){
      totalSecs += (recs[k] || 0);
      delete recs[k];
      
      if(memos && memos[k]) {
        var m = String(memos[k]).trim();
        if(m && mergedMemos.indexOf(m) === -1) mergedMemos.push(m);
        delete memos[k];
      }
      
      if (recs === S.records) {
        if (S.active === k) S.active = mergedKey;
        if (S.paused === k) S.paused = mergedKey;
      }
    });
    
    recs[mergedKey] = totalSecs;
    if (memos && mergedMemos.length > 0) {
      memos[mergedKey] = mergedMemos.join(' / ');
    }
    
    return mergedKey;
  }
  
  return 'C_' + (newO||'') + '___' + (newW||'');
}

function startTask(name){
  if(!name)return;
  S.alert=null;S.paused=null;S.pauseLabel='';
  var now=new Date();
  if(S.active&&S.start){
    var d=Math.floor((now-S.start)/1000);
    S.records[S.active]=(S.records[S.active]||0)+d;
  }
  S.active=name;
  S.start=now;
  S.elapsed=0;
  if(S.records[name]===undefined) S.records[name]=0;
  S.needFullRender=true;
  save();render();
}

function togglePlayPause(){
  var now = new Date();
  if(S.active && S.start){
    var d = Math.floor((now - S.start)/1000);
    S.records[S.active] = (S.records[S.active]||0) + d;
    S.paused = S.active;
    S.pauseLabel = '手動一時停止';
    S.active = null;
    S.start = null;
    S.elapsed = 0;
  } else if(S.paused){
    S.active = S.paused;
    S.start = now;
    S.paused = null;
    S.pauseLabel = '';
  }
  S.needFullRender = true;
  save();
  render();
}

function startCustomTask(){
  var o = document.getElementById('customOrder').value.trim();
  var w = document.getElementById('customWork').value.trim();
  if(!o && !w) return;
  var key = findOrMergeCustomTaskKey(o, w, S.records, S.memos);
  startTask(key);
  document.getElementById('customOrder').value = '';
  document.getElementById('customWork').value = '';
}

function updateRecordTime(target, taskId, newHours, histIdx){
  var targetSecs = Math.round(parseFloat(newHours) * 3600);
  if(isNaN(targetSecs) || targetSecs < 0) targetSecs = 0;

  if(target === 'current'){
    if(taskId === 'H001'){
      targetSecs = Math.max(0, targetSecs - 900);
    }
    S.records[taskId] = targetSecs;
    if(S.active === taskId){
      S.start = new Date();
      S.elapsed = 0;
    }
    save();
  } else if(target === 'history'){
    var hist = S.history[histIdx];
    if(hist && hist.records){
      hist.records[taskId] = targetSecs;
      save();
    }
  }
  S.needFullRender = true;
  render();
}

function updateRecordMemo(target, taskId, memoText, histIdx){
  if(target === 'current'){
    S.memos[taskId] = memoText;
    save();
  } else if(target === 'history'){
    var hist = S.history[histIdx];
    if(hist){
      if(!hist.memos) hist.memos = {};
      hist.memos[taskId] = memoText;
      save();
    }
  }
}

function addHistoryItem(histIdx, selId, txtOId, txtWId){
  var el = document.getElementById(selId);
  var txtO = document.getElementById(txtOId);
  var txtW = document.getElementById(txtWId);
  var hist = S.history[histIdx];
  if(!hist.memos) hist.memos = {};
  
  var taskId = el.value;
  var wasMerged = false;
  
  if(!taskId) {
    var o = txtO ? txtO.value.trim() : '';
    var w = txtW ? txtW.value.trim() : '';
    if(!o && !w) return;
    
    var oldKeys = Object.keys(hist.records).filter(function(k){return k.startsWith('C_')});
    taskId = findOrMergeCustomTaskKey(o, w, hist.records, hist.memos);
    
    var isNewKey = true;
    for(var i=0; i<oldKeys.length; i++) {
       var p1 = parseTaskKey(oldKeys[i]);
       var p2 = parseTaskKey(taskId);
       if((o && p1.col2 === o) || (w && p1.col3 === w)) {
           isNewKey = false;
           break;
       }
    }
    if(!isNewKey) wasMerged = true;
  }
  
  if(wasMerged) {
    if(txtO) txtO.value = '';
    if(txtW) txtW.value = '';
    save();
  } else if(hist.records[taskId] !== undefined){
    // すでに登録されている場合は何もしない
  } else {
    hist.records[taskId] = 0;
    if(el) el.value = '';
    if(txtO) txtO.value = '';
    if(txtW) txtW.value = '';
    save();
  }
  S.needFullRender = true;
  render();
}

function handleMonthlyCheck(cb, idx){
  if(cb.checked){
    var targetDate = hDate(S.history[idx]);
    var conflict = false;
    Object.keys(S.mcChecked).forEach(function(k){
      if(S.mcChecked[k] && k != idx && hDate(S.history[k]) === targetDate){
        conflict = true;
      }
    });
    if(conflict){
      cb.checked = false;
      S.alert = 'すでに同じ日（'+targetDate+'）のデータが選択されています。';
      S.alertType = null;
      S.needFullRender = true;
      render();
      return;
    }
  }
  S.mcChecked[idx] = cb.checked;
  S.needFullRender = true;
  render();
}

function copyExcel(recs){
  var ln=[];
  TORD.forEach(function(id){
    var s=recs[id]||0;
    var h=hrs(s);
    ln.push(parseFloat(h)>0 ? String(h) : '');
  });
  
  var cx=[];
  Object.keys(recs).forEach(function(t){
    if(TORD.indexOf(t)===-1 && recs[t]>0) cx.push({task:t, secs:recs[t]});
  });
  cx.sort(function(a,b){return b.secs-a.secs});
  
  if(cx.length>0){
    ln.push(''); 
    ln.push(''); 
    cx.forEach(function(r){
      var h=hrs(r.secs);
      ln.push(h);
    });
  }
  clipCopy(ln.join('\n'));
}

function clipCopy(text){var ta=document.createElement('textarea');ta.value=text;ta.style.cssText='position:fixed;top:0;left:0;opacity:0';document.body.appendChild(ta);ta.focus();ta.select();try{if(document.execCommand('copy')){S.copied=true;S.needFullRender=true;render();setTimeout(function(){S.copied=false;S.needFullRender=true;render()},3000)}}catch(e){}document.body.removeChild(ta)}

function doReset(){
  S.records={};S.memos={};S.active=null;S.start=null;S.elapsed=0;S.paused=null;S.pauseLabel='';S.ovt=0;S.page='main';S.alert='記録をリセットしました。';S.alertType=null;S.modal=null;
  lsR('rec');lsR('memo');S.needFullRender=true;save();render()
}

function doSaveConfirm(){
  if(S.active&&S.start){
    var d=Math.floor((new Date()-S.start)/1000);
    S.records[S.active]=(S.records[S.active]||0)+d;
    S.active=null;
    S.start=null;
    S.elapsed=0;
  }
  if(S.paused){
    S.paused=null;
    S.pauseLabel='';
  }

  var cr=buildCur();
  if(Object.keys(cr).length===0){S.modal=null;S.needFullRender=true;render();return}
  var copy={},copyMemo={},k;
  for(k in cr)copy[k]=cr[k];
  for(k in S.memos)copyMemo[k]=S.memos[k];
  var td=getToday();
  
  var newHistEntry = {date: td+' ('+getNowTime()+' 確定保存)', records: copy, memos: copyMemo, isConfirmed: true};
  
  var newHist = [];
  for(var i=0; i<S.history.length; i++){
    if(hDate(S.history[i]) !== td) {
      newHist.push(S.history[i]);
    }
  }
  newHist.unshift(newHistEntry);
  newHist = newHist.slice(0,120);
  S.history = newHist;
  
  S.modal = null;
  S.alert = '現在の集計を確定保存しました。タイマーは停止状態になります。';
  S.alertType = 'success';
  S.needFullRender = true;
  save();
  render();
}

function doConfirmHistory(){
  var target = S.history[S.confirmTarget];
  if(!target) return;
  var d = hDate(target);
  target.isConfirmed = true;
  var newHist = [];
  for(var i=0; i<S.history.length; i++){
    var h = S.history[i];
    if(h === target) {
      newHist.push(h);
    } else if(hDate(h) !== d) {
      newHist.push(h);
    }
  }
  S.history = newHist;
  S.modal = 'history';
  S.confirmTarget = null;
  S.expHist = null;
  S.alert = '記録を確定し、同日の不要なデータを整理しました。';
  S.alertType = 'success';
  S.needFullRender = true;
  save();
  render();
}

function selectAllConfirmed(){
  var period = getPeriod();
  var datesToConfirm = {};
  S.history.forEach(function(h, i){
    if(period.dates.indexOf(hDate(h)) !== -1 && h.isConfirmed){
      datesToConfirm[hDate(h)] = i;
    }
  });
  
  Object.keys(S.mcChecked).forEach(function(k){
    if(S.mcChecked[k]){
       var d = hDate(S.history[k]);
       if(datesToConfirm[d] !== undefined && datesToConfirm[d] != k) {
         S.mcChecked[k] = false;
       }
    }
  });

  Object.keys(datesToConfirm).forEach(function(d){
    S.mcChecked[datesToConfirm[d]] = true;
  });

  S.needFullRender = true;
  render();
}

function downloadBackup(){
  var data=JSON.stringify({history:S.history,exported:new Date().toISOString()},null,2);
  var blob=new Blob([data],{type:'application/json'});var url=URL.createObjectURL(blob);
  var a=document.createElement('a');a.href=url;a.download='日報履歴_'+getToday()+'.json';a.click();URL.revokeObjectURL(url);
  S.alert='バックアップをダウンロードしました。';S.alertType='success';S.needFullRender=true;render()
}
function triggerRestore(){document.getElementById('restoreInput').click()}
document.addEventListener('DOMContentLoaded',function(){
  document.getElementById('restoreInput').addEventListener('change',function(e){
    var file=e.target.files[0];if(!file)return;
    var reader=new FileReader();reader.onload=function(ev){
      try{var data=JSON.parse(ev.target.result);if(data.history&&Array.isArray(data.history)){
        var existing={};S.history.forEach(function(h){existing[h.date]=true});var added=0;
