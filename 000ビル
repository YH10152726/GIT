function tick(){
  var now=new Date(),ds=now.toLocaleDateString('sv-SE'),asKey='as_'+ds;
  
  if(now.getHours()>=22&&!localStorage.getItem(asKey)){
    localStorage.setItem(asKey,'true');var s22=new Date(now);s22.setHours(22,0,0,0);
    
    var hasConfirmedToday = S.history.some(function(h){ return hDate(h) === ds && h.isConfirmed; });
    
    if(!hasConfirmedToday){
      var fin={},k;for(k in S.records)fin[k]=S.records[k];
      if(S.active&&S.start){var d=Math.floor((Math.min(now.getTime(),s22.getTime())-S.start.getTime())/1000);if(d>0)fin[S.active]=(fin[S.active]||0)+d}
      
      // H001（朝礼）の15分自動加算を自動保存時にも反映する
      fin['H001'] = (fin['H001'] || 0) + 900;

      if(Object.keys(fin).length>0){
        var copyMemo = {}; for(var km in S.memos) copyMemo[km] = S.memos[km];
        S.history=[{date:ds+' (22:00 自動保存)',records:fin, memos:copyMemo}].concat(S.history).slice(0,120);
      }
    }
    
    S.records={};S.memos={};S.active=null;S.start=null;S.paused=null;S.pauseLabel='';S.elapsed=0;
    S.alert = hasConfirmedToday ? '22時になったため業務を自動停止しました。（本日は確定済みのため自動保存スキップ）' : '22時になったため業務を自動停止し、履歴に保存しました。';
    S.alertType=null;S.needFullRender=true;save();render();return
  }
  
  if(S.active||S.paused){
    for(var bi=0;bi<BRKS.length;bi++){var brk=BRKS[bi],bb=brkB(brk),bS=bb.s,bE=bb.e,label=bb.l;
      if(S.active&&S.start){var st=S.start;
        if(now>=bS&&now<bE&&st<bS){var d2=Math.floor((bS-st)/1000);S.records[S.active]=(S.records[S.active]||0)+d2;S.paused=S.active;S.pauseLabel=label;S.active=null;S.start=null;S.alert=label+'で一時停止。'+brk.eH+':'+String(brk.eM).padStart(2,'0')+'に自動再開。';S.alertType=null;S.needFullRender=true;save();render();return}
        if(now>=bE&&st<bS){var d3=Math.floor((bS-st)/1000);S.records[S.active]=(S.records[S.active]||0)+d3;S.start=bE;S.elapsed=Math.floor((now-bE)/1000);S.needFullRender=true;save();render();return}}
      if(S.paused&&S.pauseLabel===label&&now>=bE){S.active=S.paused;S.start=bE;S.paused=null;S.pauseLabel='';S.alert=label+'終了。タスクを自動再開しました。';S.alertType=null;S.needFullRender=true;save();render();return}}
  }
  if(S.active&&S.start){S.elapsed=Math.floor((now-S.start)/1000);var el=document.getElementById('timerDisplay');if(el)el.textContent=fmt((S.records[S.active]||0) + S.elapsed);
    if(S.page==='summary'){var cur=buildCur(),sorted=getSorted(cur),totalS=sorted.fx.concat(sorted.cx).reduce(function(s,r){return s+r.secs},0),totalH=parseFloat(hrs(totalS)),expT=parseFloat((7.75+S.ovt).toFixed(2)),diff=parseFloat((totalH-expT).toFixed(2));
      var e2=document.getElementById('sumTotal');if(e2)e2.textContent=totalH.toFixed(2);var e3=document.getElementById('sumDiff');if(e3)e3.textContent=(diff>0?'+':'')+diff.toFixed(2);var e4=document.getElementById('sumDiffStat');if(e4)e4.className='stat '+(Math.abs(diff)<0.01?'ok':'ng')}}
  else S.elapsed=0
}

