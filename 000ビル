    SC ws, ar, 4, mCont(no), cCONTF, False, 8.5, True, xlLeft, xlCenter, 0, True
    Dim aL As Long, eL As Long, t As Long
    aL = 1: eL = 1
    For i = 0 To 4
      SC ws, ar, F2+i, mAb(no)(i), -1, False, 8.5, True, xlLeft, xlTop, 0, True
      SC ws, er, F2+i, mEx(no)(i), cEXPF, False, 8, True, xlLeft, xlTop, 0, True
