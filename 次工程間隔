        sTimeFinal = IIf(i = loopCount, sTimeBase, "")												
        Call AddItemToPreviewList(mcProcessName, "", maeDandori, yTime, mTime, sTimeFinal, remarksFromSheetF)												
    Next i												
End Sub												
												
