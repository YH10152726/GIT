Private Sub LoadWeightMaster()												
    Dim ws As Worksheet												
    Dim lastRow As Long												
    Dim i As Long, j As Long, k As Long												
    Dim temp(0 To 4) As Double												
    												
    m_lWeightMasterCount = 0												
    Erase m_arrWeightMaster												
    												
    On Error Resume Next												
    Set ws = ThisWorkbook.Sheets(SHEET_KOUTEI_TIMES)												
    On Error GoTo 0												
    If ws Is Nothing Then Exit Sub												
    												
    lastRow = ws.Cells(ws.Rows.Count, 33).End(xlUp).Row												
    If lastRow < 2 Then Exit Sub ' データなし												
    												
    ReDim m_arrWeightMaster(0 To lastRow - 2, 0 To 4)												
    												
    For i = 2 To lastRow												
        m_arrWeightMaster(m_lWeightMasterCount, 0) = Val(ws.Cells(i, 33).Value) ' AG列: 重量												
        m_arrWeightMaster(m_lWeightMasterCount, 1) = Val(ws.Cells(i, 34).Value) ' AH列: 前段取												
        m_arrWeightMaster(m_lWeightMasterCount, 2) = Val(ws.Cells(i, 35).Value) ' AI列: 有人												
        m_arrWeightMaster(m_lWeightMasterCount, 3) = Val(ws.Cells(i, 36).Value) ' AJ列: 機械												
        m_arrWeightMaster(m_lWeightMasterCount, 4) = Val(ws.Cells(i, 37).Value) ' AK列: 後段取												
        m_lWeightMasterCount = m_lWeightMasterCount + 1												
    Next i												
    												
    For i = 0 To m_lWeightMasterCount - 2												
        For j = i + 1 To m_lWeightMasterCount - 1												
            If m_arrWeightMaster(i, 0) < m_arrWeightMaster(j, 0) Then												
                For k = 0 To 4												
                    temp(k) = m_arrWeightMaster(i, k)												
                    m_arrWeightMaster(i, k) = m_arrWeightMaster(j, k)												
                    m_arrWeightMaster(j, k) = temp(k)												
                Next k												
            End If												
        Next j												
    Next i												
End Sub												
												
Private Function GetWeightNum(material As String, dimensions As String) As Double												
    Dim SpecificGravity As Double												
    Dim Formula As String												
    Dim Volume As Double												
    Dim DimArray As Variant												
    Dim calculatedWeight As Double												
    												
    Formula = dimensions												
    If UCase(Left(Formula, 1)) = "T" Then Formula = Mid(Formula, 2)												
    												
    On Error Resume Next ' 寸法フォーマットエラー回避												
    If Formula Like "*#*#*#*" Then												
        DimArray = Split(Formula, "*")												
        If UBound(DimArray) = 2 Then												
            Volume = CDbl(DimArray(0)) * CDbl(DimArray(1)) * CDbl(DimArray(2))												
        End If												
    ElseIf Formula Like "φ*##" Or Formula Like "Φ*##" Then												
        Formula = Mid(Formula, 2)												
        DimArray = Split(Formula, "*")												
        If UBound(DimArray) = 1 Then												
            Volume = 3.14159 * (CDbl(DimArray(0)) / 2) ^ 2 * CDbl(DimArray(1))												
        End If												
    End If												
    On Error GoTo 0												
    												
    Select Case True												
        Case material Like "A*": SpecificGravity = 2.81												
        Case material Like "C*": SpecificGravity = 8.81												
        Case material Like "超硬*": SpecificGravity = 14.5												
        Case material = "": SpecificGravity = 0												
        Case Else: SpecificGravity = 7.85 ' 鉄系												
    End Select												
    												
    If Volume > 0 And SpecificGravity > 0 Then												
        calculatedWeight = (Volume / 1000) * SpecificGravity / 1000												
        GetWeightNum = Application.WorksheetFunction.RoundUp(calculatedWeight, 1)												
    Else												
        GetWeightNum = 0												
    End If												
End Function												
												
Private Sub AdjustMCTimesByWeight(ByVal weight As Double, ByRef maeDandori As String, ByRef yujin As String, ByRef machine As String, ByRef goDandori As String)												
    Dim valMae As Double, valYujin As Double, valMachine As Double, valGo As Double												
    Dim i As Long												
    												
    valMae = Val(maeDandori)												
    valYujin = Val(yujin)												
    valMachine = Val(machine)												
    valGo = Val(goDandori)												
    												
    For i = 0 To m_lWeightMasterCount - 1												
        If weight >= m_arrWeightMaster(i, 0) Then												
            valMae = valMae + m_arrWeightMaster(i, 1)												
            valYujin = valYujin + m_arrWeightMaster(i, 2)												
            valMachine = valMachine + m_arrWeightMaster(i, 3)												
            valGo = valGo + m_arrWeightMaster(i, 4)												
            Exit For												
        End If												
    Next i												
    												
    If valMae > 0 Then maeDandori = CStr(valMae) Else maeDandori = ""												
    If valYujin > 0 Then yujin = CStr(valYujin) Else yujin = ""												
    If valMachine > 0 Then machine = CStr(valMachine) Else machine = ""												
    If valGo > 0 Then goDandori = CStr(valGo) Else goDandori = ""												
End Sub												
												
												
