Private Sub PreviewAddMCBeforeHeatTreatment(shapePreview As String, materialCodePreview As String, sizeStrPreview As String)												
    Dim mcProcessName As String: mcProcessName = IIf(shapePreview = "プレート", "M/C(大)", "M/C（小）")												
    Dim i As Integer, times As Variant, maeDandori As String, yTime As String, mTime As String, sTimeBase As String, sTimeFinal As String												
    Dim loopCount As Integer												
    Dim remarksFromSheetF As String												
    Dim partWeight As Double												
												
    times = GetProcessTimes(mcProcessName, "熱処理前")												
    If IsArray(times) Then												
        maeDandori = CStr(times(0))												
        yTime = CStr(times(1))												
        mTime = CStr(times(2))												
        sTimeBase = CStr(times(3))												
        remarksFromSheetF = CStr(times(4))												
    Else												
        maeDandori = ""												
        yTime = "0.25"												
        mTime = "0.1"												
        sTimeBase = "0.1"												
        remarksFromSheetF = "(※工数/備考未設定)"												
    End If												
												
    partWeight = GetWeightNum(materialCodePreview, sizeStrPreview)												
    Call AdjustMCTimesByWeight(partWeight, maeDandori, yTime, mTime, sTimeBase)												
												
loopCount = 2												
    For i = 1 To loopCount												
        sTimeFinal = IIf(i = loopCount, sTimeBase, "")												
        Call AddItemToPreviewList(mcProcessName, "", maeDandori, yTime, mTime, sTimeFinal, remarksFromSheetF)												
        												
        If i = loopCount Then												
            m_arrPreviewProcesses(m_lPreviewProcessCount - 1).IsGoDandoriUserEdited = True												
            m_arrPreviewProcesses(m_lPreviewProcessCount - 1).UserEditedGoDandori = sTimeFinal												
        End If												
    Next i												
End Sub												
												
												
												
