    If IsArray(times) Then												
        maeDandori = CStr(times(0))												
        yTime = CStr(times(1))												
        mTime = CStr(times(2))												
        sTimeBase = CStr(times(3))												
        remarksFromSheetF = CStr(times(4))												
    Else												
        maeDandori = ""												
        yTime = "0.25"												
        mTime = "0.1"												
        sTimeBase = "0.1"												
        remarksFromSheetF = "(※工数/備考未設定)"												
    End If												
												
    partWeight = GetWeightNum(materialCodePreview, sizeStrPreview)												
    Call AdjustMCTimesByWeight(partWeight, maeDandori, yTime, mTime, sTimeBase)												
												
