Private Sub cmdUndoDelete_Click()
    Dim i As Long
    Dim lRestoredIndex As Long

    ' 保存されているアイテムがなければ何もしない
    If m_lastDeletedItem.processName = "" Then
        MsgBox "元に戻すデータがありません。", vbInformation
        Exit Sub
    End If
    

    lRestoredIndex = m_lastDeletedItemIndex
    
    ' 配列のサイズが足りなければ拡張
    If m_lPreviewProcessCount > UBound(m_arrPreviewProcesses) Then
        ReDim Preserve m_arrPreviewProcesses(0 To m_lPreviewProcessCount + 9)
    End If

    ' リストが空でない場合のみ、既存の項目をずらす
    If m_lPreviewProcessCount > 0 Then
        ' 元の位置にデータを挿入するため、配列の要素を一つずつ後ろにずらす
        For i = m_lPreviewProcessCount To lRestoredIndex Step -1
            m_arrPreviewProcesses(i) = m_arrPreviewProcesses(i - 1)
        Next i
    End If

    
    ' 保存しておいたアイテムを元の位置に戻す
    m_arrPreviewProcesses(lRestoredIndex) = m_lastDeletedItem
    m_lPreviewProcessCount = m_lPreviewProcessCount + 1
    
    ' リストを更新
    Call RefreshListBoxFromInternalArray
    
    ' 「元に戻す」ボタンを無効化
    Me.cmdUndoDelete.Enabled = False
    
    ' 元に戻した項目を選択状態にする
    If lRestoredIndex >= 0 And lRestoredIndex < m_lPreviewProcessCount Then
        ' 0から始まる配列インデックスを、1から始まるリストインデックスに変換するため「+1」する
        Me.ListViewPreview.ListItems(lRestoredIndex + 1).Selected = True
        Me.ListViewPreview.ListItems(lRestoredIndex + 1).EnsureVisible
        Me.ListViewPreview.SetFocus
    End If

    ' 一時変数をクリア
    m_lastDeletedItem.processName = ""
    m_lastDeletedItemIndex = -1
End Sub
